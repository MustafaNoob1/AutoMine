--------------------------------------------------
-- MINE TARGET
--------------------------------------------------
local function mineTarget(name, mode, run)
    if name == nil then
        return false
    end

    name = tostring(name)

    if BlockedTargets[name] then
        return false
    end

    local targetY = safeNumber(YByName[name])
    if not validDepth(targetY) then
        return false
    end

    local startingInfo = getBlockInfoByName(name)
    setCurrentTarget(name, startingInfo, targetY)

    local stalled = 0
    local counted = false

    local function finish(result)
        clearCurrentTarget(name)
        return result
    end

    local function destroyed()
        if not counted then
            counted = true
            recordMined(startingInfo, targetY)
        end
        return finish(true)
    end

    while isRunning(run) do
        local model = ModelsByName[name]

        if not model or not model.Parent then
            local folder = MiningServiceClient.mineFolder
            if folder then
                model = folder:FindFirstChild(name)
            end
        end

        local data = getBlockDataByName(name)

        if not data or data[1] == "None" or not model or not model.Parent then
            BlockedTargets[name] = nil
            return destroyed()
        end

        if not modeAllows(name, mode) then
            return finish(false)
        end

        moveNearTarget(model)

        if not waitForCooldown(run) then
            return finish(false)
        end

        data = getBlockDataByName(name)
        if not data or data[1] == "None" then
            return destroyed()
        end

        model = ModelsByName[name] or model
        if not model or not model.Parent then
            return destroyed()
        end

        if not modeAllows(name, mode) then
            return finish(false)
        end

        local before = getStateKey(name)
        MiningServiceClient.currentBlock = model

        local success = pcall(function()
            MiningServiceClient:damageBlock()
        end)

        task.wait()

        local afterData = getBlockDataByName(name)
        local afterModel = ModelsByName[name]

        if not afterData
            or afterData[1] == "None"
            or not afterModel
            or not afterModel.Parent then
            return destroyed()
        end

        local after = getStateKey(name)

        if not success or before == after then
            stalled = stalled + 1
        else
            stalled = 0
        end

        if stalled >= STALL_LIMIT then
            BlockedTargets[name] = true
            warn("Ore Miner: skipping stalled block:", name)
            return finish(false)
        end
    end

    return finish(false)
end

--------------------------------------------------
-- PRIORITY TARGET SELECTION
--------------------------------------------------
local function candidateBeatsBest(candidate, best)
    if best == nil then
        return true
    end

    -- Rare alert can also override the selected priority mode.
    if RARE_ALERT_ENABLED and RARE_PRIORITY_OVERRIDE then
        if candidate.IsRare ~= best.IsRare then
            return candidate.IsRare
        end

        if candidate.IsRare and best.IsRare then
            if candidate.Weight ~= best.Weight then
                return candidate.Weight < best.Weight
            end
            if candidate.Value ~= best.Value then
                return candidate.Value > best.Value
            end
            return candidate.Distance < best.Distance
        end
    end

    if PRIORITY_MODE == "Smart" then
        if candidate.SmartScore ~= best.SmartScore then
            return candidate.SmartScore > best.SmartScore
        end
        if candidate.Value ~= best.Value then
            return candidate.Value > best.Value
        end
        return candidate.Distance < best.Distance
    end

    if PRIORITY_MODE == "Rarest First" then
        if candidate.Weight ~= best.Weight then
            return candidate.Weight < best.Weight
        end
        if candidate.Value ~= best.Value then
            return candidate.Value > best.Value
        end
        return candidate.Distance < best.Distance
    end

    if PRIORITY_MODE == "Nearest First" then
        if candidate.Distance ~= best.Distance then
            return candidate.Distance < best.Distance
        end
        return candidate.Value > best.Value
    end

    if PRIORITY_MODE == "Value / Distance" then
        if candidate.Score ~= best.Score then
            return candidate.Score > best.Score
        end
        return candidate.Value > best.Value
    end

    -- Highest Value
    if candidate.Value ~= best.Value then
        return candidate.Value > best.Value
    end
    return candidate.Distance < best.Distance
end

local function getSelectedTarget(anchorX, anchorZ)
    local best = nil

    for rawY, bucket in pairs(SelectedByY) do
        local y = safeNumber(rawY)

        if y ~= nil and inFarmDepth(y) then
            for name in pairs(bucket) do
                if not BlockedTargets[name] then
                    local model = ModelsByName[name]

                    if model and model.Parent then
                        local info = getBlockInfoByName(name)

                        if info and isSelectedOre(info) then
                            local value = getComparableValue(info.Value)
                            local distanceSquared = getGridDistanceSquared(name, anchorX, anchorZ)
                            local distance = math.sqrt(distanceSquared)
                            local weight = getRarityWeight(info.Id, y)
                            local score = value / (distance + 1)

                            local rarityPower = 0
                            if weight < math.huge and weight > 0 then
                                rarityPower = math.max(0, -(math.log(weight) / math.log(10)))
                            end

                            local valuePower = 0
                            if value > 0 then
                                valuePower = math.log(value + 1) / math.log(10)
                            end

                            -- Smart score balances value, rarity and travel distance.
                            local smartScore = ((valuePower * 2) + (rarityPower * 3))
                                / (1 + (distance / 25))

                            local candidate = {
                                Name = name,
                                Value = value,
                                Distance = distanceSquared,
                                Weight = weight,
                                Score = score,
                                SmartScore = smartScore,
                                IsRare = isRareOre(info, y)
                            }

                            if candidateBeatsBest(candidate, best) then
                                best = candidate
                            end
                        end
                    end
                end
            end
        end
    end

    return best and best.Name or nil
end

--------------------------------------------------
-- FRONTIER / SWEEP TARGETS
--------------------------------------------------
local function getFrontierTarget(anchorX, anchorZ)
    local _, effectiveEnd = getEffectiveDepthRange()
    local y = deepestY(NonBedrockByY, nil, effectiveEnd)
    y = safeNumber(y)

    if y == nil then
        return nil, nil
    end

    local name = nil
    local stoneBucket = StoneByY[y]

    if stoneBucket and cleanBucket(stoneBucket) then
        name = pickNearest(stoneBucket, anchorX, anchorZ)
    end

    if not name then
        name = pickNearest(NonBedrockByY[y], anchorX, anchorZ)
    end

    return name, y
end

local function getHighestSweepY(map)
    local effectiveStart, effectiveEnd = getEffectiveDepthRange()
    local selectedY = nil

    for rawY, bucket in pairs(map) do
        local y = safeNumber(rawY)

        if y ~= nil
            and validDepth(y)
            and y <= effectiveStart
            and y >= effectiveEnd
            and cleanBucket(bucket) then
            if selectedY == nil or y > selectedY then
                selectedY = y
            end
        end
    end

    return selectedY
end

local function getFullSweepTarget(anchorX, anchorZ)
    local selectedY = getHighestSweepY(NonBedrockByY)
    if selectedY == nil then
        return nil, nil
    end

    return pickSweepTarget(NonBedrockByY[selectedY], anchorX, anchorZ), selectedY
end

local function getRevealTarget(anchorX, anchorZ)
    -- Valuable Ores + Reveal prefers stone. If no stone is exposed,
    -- use the nearest non-bedrock block so the reveal can keep expanding.
    local selectedY = getHighestSweepY(StoneByY)

    if selectedY ~= nil then
        local target = pickSweepTarget(StoneByY[selectedY], anchorX, anchorZ)
        if target then
            return target, selectedY
        end
    end

    selectedY = getHighestSweepY(NonBedrockByY)
    if selectedY == nil then
        return nil, nil
    end

    return pickSweepTarget(NonBedrockByY[selectedY], anchorX, anchorZ), selectedY
end

--------------------------------------------------
-- PROGRESS COUNTS
--------------------------------------------------
local function countRemainingAtY(y)
    y = safeNumber(y)
    if y == nil then
        return 0
    end

    local bucket = NonBedrockByY[y]
    if not bucket then
        return 0
    end

    local count = 0
    for name in pairs(bucket) do
        local model = ModelsByName[name]
        local data = getBlockDataByName(name)

        if not BlockedTargets[name]
            and model
            and model.Parent
            and data
            and data[1] ~= "None" then
            count = count + 1
        end
    end

    return count
end

local function countRemainingInRange()
    local total = 0
    for rawY in pairs(NonBedrockByY) do
        local y = safeNumber(rawY)
        if y ~= nil and inFarmDepth(y) then
            total = total + countRemainingAtY(y)
        end
    end
    return total
end


local function getCycleProgress()
    local cycleMined = math.max(0, Stats.BlocksMined - (CycleStartBlocks or 0))
    local remaining = countRemainingInRange()
    local knownTotal = cycleMined + remaining
    local progress = knownTotal > 0 and (cycleMined / knownTotal) or 0
    return progress, cycleMined, remaining
end

local function shouldSmartReset()
    if not SMART_RESET or not AUTO_RESET_MINE or IsResetting then
        return false, nil
    end

    local now = os.clock()
    local runtime = CycleStartTime and (now - CycleStartTime) or 0
    local oreIdle = LastOreMinedAt and (now - LastOreMinedAt) or runtime
    local progress, cycleMined = getCycleProgress()

    if cycleMined < SMART_RESET_MIN_BLOCKS then
        return false, nil
    end

    if progress >= SMART_RESET_PROGRESS and oreIdle >= SMART_RESET_IDLE_SECONDS then
        return true, string.format("Smart reset: %.0f%% known clear, no ore for %.0fs", progress * 100, oreIdle)
    end

    if runtime >= SMART_RESET_MAX_CYCLE_SECONDS and oreIdle >= SMART_RESET_IDLE_SECONDS then
        return true, string.format("Smart reset: cycle %.0fs, no ore for %.0fs", runtime, oreIdle)
    end

    return false, nil
end


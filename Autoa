local function buildOreDisplayMaps()
    OreIdToDisplay = {}
    OreDisplayToId = {}

    for rawId, data in pairs(BlocksData) do
        local id = tostring(rawId)

        if not id:match("^StoneOre%d*$") and id ~= "Bedrock" then
            local displayName = id

            if type(data) == "table" then
                if type(data.name) == "string" then
                    displayName = data.name
                elseif type(data.Name) == "string" then
                    displayName = data.Name
                end
            end

            displayName = tostring(displayName)

            if OreDisplayToId[displayName] ~= nil then
                displayName = displayName .. " [" .. id .. "]"
            end

            OreIdToDisplay[id] = displayName
            OreDisplayToId[displayName] = id
        end
    end
end

buildOreDisplayMaps()

local function getAvailableOreIdsForRange()
    local result = {}
    local seen = {}
    local layers = MiningInfo._layers or {}
    local effectiveStart, effectiveEnd = getEffectiveDepthRange()

    local absA = math.abs(effectiveStart)
    local absB = math.abs(effectiveEnd)
    local absMin = math.min(absA, absB)
    local absMax = math.max(absA, absB)

    local function addId(rawId)
        if rawId == nil then
            return
        end

        local id = tostring(rawId)
        if id:match("^StoneOre%d*$") or id == "Bedrock" then
            return
        end

        if not OreIdToDisplay[id] or seen[id] then
            return
        end

        seen[id] = true
        table.insert(result, id)
    end

    for index, layer in ipairs(layers) do
        local layerStart = safeNumber(layer.depth) or 0
        local nextLayer = layers[index + 1]
        local layerEnd = nextLayer and ((safeNumber(nextLayer.depth) or 5000) - 1) or 4999

        if layerStart <= absMax and layerEnd >= absMin then
            addId(layer.defaultBlock)
            for _, entry in pairs(layer.blocks or {}) do
                addId(entry.block)
            end
        end
    end

    table.sort(result, function(a, b)
        return tostring(OreIdToDisplay[a]) < tostring(OreIdToDisplay[b])
    end)

    return result
end

local function rebuildSelectedOresFromPreferences(availableIds)
    SelectedOres = {}

    for _, id in ipairs(availableIds) do
        if OreSelectionPreference[id] == nil then
            OreSelectionPreference[id] = true
        end

        if OreSelectionPreference[id] == true then
            SelectedOres[id] = true
        end
    end
end

local function isSelectedOre(info)
    if not info or isStone(info) or isBedrock(info) then
        return false
    end
    return SelectedOres[tostring(info.Id)] == true
end


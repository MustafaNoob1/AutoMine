-- AUTO RESET MINE
--------------------------------------------------
local function requestMineReset(run)
    if not isRunning(run) then
        return false
    end

    local networker = MiningServiceClient.networker
    if not networker then
        Fluent:Notify({
            Title = "Auto Reset",
            Content = "MiningService networker not ready.",
            Duration = 4
        })
        return false
    end

    Stats.Status = "Resetting mine"
    IsResetting = true
    MiningServiceClient.currentBlock = nil

    local oldBlocksTable = MiningServiceClient.blocks

    local success, err = pcall(function()
        networker:InvokeServer("resetMine_Manual")
    end)

    if not success then
        IsResetting = false
        warn("Ore Miner: reset failed:", err)
        Fluent:Notify({
            Title = "Auto Reset Failed",
            Content = tostring(err),
            Duration = 5
        })
        return false
    end

    Stats.Resets = Stats.Resets + 1
    BlockedTargets = {}
    AlertedRareBlocks = {}
    CycleMinedByDepth = {}

    local timeoutAt = os.clock() + 12
    local ready = false

    while isRunning(run) and os.clock() < timeoutAt do
        local blocks = MiningServiceClient.blocks
        local folder = MiningServiceClient.mineFolder

        if blocks ~= oldBlocksTable
            and blocks
            and next(blocks) ~= nil
            and folder
            and #folder:GetChildren() > 0 then
            ready = true
            break
        end

        task.wait(0.1)
    end

    clearIndex()
    if MiningServiceClient.mineFolder then
        IndexedFolder = MiningServiceClient.mineFolder
    end
    rescanMine()
    rebuildSelectedIndex()

    IsResetting = false

    if not ready then
        Fluent:Notify({
            Title = "Auto Reset",
            Content = "Reset response timed out.",
            Duration = 4
        })
        return false
    end

    Stats.Status = "Mine reset complete"
    CycleStartTime = os.clock()
    CycleStartBlocks = Stats.BlocksMined
    CycleStartOres = Stats.OresMined
    LastOreMinedAt = os.clock()
    return true
end

--------------------------------------------------
-- START MINING / CYCLE LOOP
--------------------------------------------------
local function startMining(run)
    task.spawn(function()
        refreshRankDepth()
        applyAutomaticDepth(false)
        BlockedTargets = {}

        if refreshOreDropdownForRange then
            refreshOreDropdownForRange()
        end
        if updateRankDisplay then
            updateRankDisplay()
        end

        if not waitForMine(run) then
            return
        end

        while isRunning(run) do
            CycleMinedByDepth = {}
            BlockedTargets = {}
            Stats.CurrentSweepY = nil
            CycleStartTime = os.clock()
            CycleStartBlocks = Stats.BlocksMined
            CycleStartOres = Stats.OresMined
            LastOreMinedAt = LastOreMinedAt or os.clock()

            rebuildWholeIndex()
            rebuildSelectedIndex()

            local reached, anchorX, anchorZ = reachStartDepth(run)
            if not reached or not isRunning(run) then
                return
            end

            rescanMine()
            rebuildSelectedIndex()

            local outcome = farmingLoop(run, anchorX, anchorZ)

            if outcome == "reset" and isRunning(run) then
                if not requestMineReset(run) then
                    requestStop("Auto reset failed")
                    return
                end
                task.wait(0.25)
            else
                return
            end
        end
    end)
end

local function restartActiveMiner()
    if not AutoMine then
        return
    end

    RunId = RunId + 1
    local run = RunId
    task.defer(function()
        startMining(run)
    end)
end


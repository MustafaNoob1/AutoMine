--------------------------------------------------
-- RUN CONTROL
--------------------------------------------------

local RunId =
    0


local function isRunning(id)

    return
        AutoMine
        and id == RunId

end


--------------------------------------------------
-- SELECTED ORES
--------------------------------------------------

local SelectedOres =
    {}


--------------------------------------------------
-- BLOCK COORDINATES
--------------------------------------------------

local function getCoordinatesFromName(name)

    if not name then
        return nil, nil, nil
    end


    --------------------------------------------------
    -- USE GAME'S OWN FUNCTION FIRST
    --------------------------------------------------

    local success,
        x,
        y,
        z =

        pcall(function()

            return
                MiningInfo:
                getCoordinatesFromBlockName(
                    name
                )

        end)


    if success
        and x ~= nil
        and y ~= nil
        and z ~= nil then

        return
            x,
            y,
            z

    end


    --------------------------------------------------
    -- FALLBACK
    --------------------------------------------------

    local sx,
        sy,
        sz =

        string.match(
            name,
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )


    return
        tonumber(sx),
        tonumber(sy),
        tonumber(sz)

end


--------------------------------------------------
-- GET Y
--------------------------------------------------

local function getBlockY(block)

    if not block then
        return nil
    end


    local _,
        y,
        _ =

        getCoordinatesFromName(
            block.Name
        )


    return y

end


--------------------------------------------------
-- GET BLOCK DATA
--------------------------------------------------

local function getBlockDataByName(name)

    if not name then
        return nil
    end


    return
        MiningServiceClient.blocks[
            name
        ]

end


--------------------------------------------------
-- GET BLOCK INFO BY NAME
--------------------------------------------------

local function getBlockInfoByName(name)

    local data =
        getBlockDataByName(
            name
        )


    if not data then
        return nil
    end


    local id =
        data[1]


    if not id
        or id == "None" then

        return nil

    end


    local info =
        MiningInfo:getBlock(
            id
        )


    if not info then
        return nil
    end


    return {

        Id =
            id,

        Name =
            info.name,

        HP =
            info.hp,

        Value =
            info.value,

        Model =
            info.model

    }

end


--------------------------------------------------
-- STONE
--------------------------------------------------

local function isStone(info)

    if not info then
        return false
    end


    return
        string.match(
            info.Id,
            "^StoneOre%d*$"
        ) ~= nil

end


--------------------------------------------------
-- BEDROCK
--------------------------------------------------

local function isBedrock(info)

    if not info then
        return false
    end


    return
        info.Id == "Bedrock"

end


--------------------------------------------------
-- SELECTED ORE
--------------------------------------------------

local function isSelectedOre(info)

    if not info then
        return false
    end


    if isStone(info)
        or isBedrock(info) then

        return false

    end


    return
        SelectedOres[
            info.Id
        ] == true

end


--------------------------------------------------
-- VALID DEPTH
--------------------------------------------------

local function validDepth(y)

    return
        y ~= nil
        and y <= 0
        and y >= MIN_DEPTH

end


--------------------------------------------------
-- FARM DEPTH
--------------------------------------------------

local function inFarmDepth(y)

    return
        y ~= nil
        and y <= START_DEPTH
        and y >= MIN_DEPTH

end



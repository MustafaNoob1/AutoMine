--------------------------------------------------
-- BLOCK DATA
--------------------------------------------------

local function getBlockDataByName(name)

    if name == nil then
        return nil
    end


    if not MiningServiceClient.blocks then
        return nil
    end


    return
        MiningServiceClient.blocks[
            tostring(name)
        ]

end


--------------------------------------------------
-- BLOCK INFO
--------------------------------------------------

local function getBlockInfoByName(name)

    local data =
        getBlockDataByName(
            name
        )

    if not data then
        return nil
    end


    local id =
        data[1]


    if not id
        or id == "None" then

        return nil

    end


    local success, info =
        pcall(function()

            return
                MiningInfo:getBlock(
                    id
                )

        end)


    if not success
        or not info then

        return nil

    end


    return {

        Id =
            id,

        Name =
            info.name,

        HP =
            info.hp,

        Value =
            info.value,

        Model =
            info.model

    }

end


--------------------------------------------------
-- STONE
--------------------------------------------------

local function isStone(info)

    if not info then
        return false
    end


    return
        string.match(
            tostring(
                info.Id
            ),
            "^StoneOre%d*$"
        ) ~= nil

end


--------------------------------------------------
-- BEDROCK
--------------------------------------------------

local function isBedrock(info)

    if not info then
        return false
    end


    return
        tostring(
            info.Id
        ) == "Bedrock"

end


--------------------------------------------------
-- SELECTED ORE
--------------------------------------------------

local function isSelectedOre(info)

    if not info then
        return false
    end


    if isStone(info)
        or isBedrock(info) then

        return false

    end


    return
        SelectedOres[
            info.Id
        ] == true

end


--------------------------------------------------
-- VALUE CONVERSION
--------------------------------------------------

local function getComparableValue(value)

    if value == nil then
        return 0
    end


    --------------------------------------------------
    -- ETERNITY NUMBER
    --------------------------------------------------

    local success,
        result =

        pcall(function()

            return
                EternityNum.bnumtofloat(
                    value
                )

        end)


    if success then

        result =
            safeNumber(result)

        if result ~= nil then
            return result
        end

    end


    --------------------------------------------------
    -- NORMAL NUMBER
    --------------------------------------------------

    return
        safeNumber(value)
        or 0

end



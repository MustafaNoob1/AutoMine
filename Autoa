        )

end


--------------------------------------------------
-- MODE CHECK
--------------------------------------------------

local function modeAllows(
    name,
    mode
)

    local info =
        getBlockInfoByName(
            name
        )


    if not info then
        return false
    end


    if isBedrock(info) then
        return false
    end


    if mode == "selected" then


        return
            isSelectedOre(
                info
            )

    end


    if mode == "stone" then


        return
            isStone(
                info
            )

    end


    --------------------------------------------------
    -- ANY NON BEDROCK
    --------------------------------------------------

    return true

end


--------------------------------------------------
-- MINE TARGET
--------------------------------------------------

local function mineTarget(
    name,
    mode,
    run
)

    if name == nil then
        return false
    end


    name =
        tostring(name)


    local stalled =
        0


    while isRunning(run) do


        --------------------------------------------------
        -- CURRENT MODEL
        --------------------------------------------------

        local model =
            ModelsByName[name]


        if not model
            or not model.Parent then


            local folder =
                MiningServiceClient.mineFolder


            if folder then


                model =
                    folder:
                    FindFirstChild(
                        name
                    )

            end

        end


        --------------------------------------------------
        -- BLOCK DATA
        --------------------------------------------------

        local data =
            getBlockDataByName(
                name
            )


        --------------------------------------------------
        -- DESTROYED
        --------------------------------------------------

        if not data
            or data[1] == "None"
            or not model
            or not model.Parent then


            return true

        end


        --------------------------------------------------
        -- TYPE STILL ALLOWED?
        --------------------------------------------------

        if not modeAllows(
            name,
            mode
        ) then


            return false

        end


        --------------------------------------------------
        -- FOLLOW
        --------------------------------------------------

        moveNearTarget(
            model
        )


        --------------------------------------------------
        -- COOLDOWN
        --------------------------------------------------

        if not waitForCooldown(
            run
        ) then


            return false

        end


        --------------------------------------------------
        -- RECHECK
        --------------------------------------------------

        data =
            getBlockDataByName(
                name
            )


        if not data
            or data[1] == "None" then


            return true

        end


        model =
            ModelsByName[name]
            or model


        if not model
            or not model.Parent then


            return true

        end


        if not modeAllows(
            name,
            mode
        ) then


            return false

        end


        --------------------------------------------------
        -- STATE BEFORE HIT
        --------------------------------------------------

        local before =
            getStateKey(
                name
            )


        --------------------------------------------------
        -- TARGET
        --------------------------------------------------

        MiningServiceClient.currentBlock =
            model


        --------------------------------------------------
        -- ORIGINAL GAME DAMAGE FUNCTION
        --------------------------------------------------

        local success,
            err =

            pcall(function()


                MiningServiceClient:
                damageBlock()

            end)


        --------------------------------------------------
        -- LET SERVER UPDATE CLIENT TABLE
        --------------------------------------------------

        task.wait()


        --------------------------------------------------
        -- CHECK AFTER HIT
        --------------------------------------------------

        local afterData =
            getBlockDataByName(
                name
            )


        local afterModel =
            ModelsByName[name]


        --------------------------------------------------
        -- DESTROYED
        --------------------------------------------------

        if not afterData
            or afterData[1] == "None"
            or not afterModel
            or not afterModel.Parent then


            return true

        end


        --------------------------------------------------
        -- STALL CHECK
        --------------------------------------------------

        local after =
            getStateKey(
                name
            )


        if not success
            or before == after then


            stalled =
                stalled + 1


        else


            stalled =
                0

        end


        --------------------------------------------------
        -- TARGET NOT WORKING
        --------------------------------------------------

        if stalled >= 20 then


            warn(
                "Ore Miner: target stalled:",
                name,
                err
            )


            return false

        end

    end


    return false

end


--------------------------------------------------
-- FRONTIER TARGET
--------------------------------------------------

local function getFrontierTarget(
    anchorX,
    anchorZ
)

    --------------------------------------------------
    -- DEEPEST LOADED LEVEL
    --------------------------------------------------

    local y =
        deepestY(
            NonBedrockByY,
            nil
        )


    y =
        safeNumber(y)


    if y == nil then


        return
            nil,
            nil

    end


    --------------------------------------------------
    -- PREFER STONE
    --------------------------------------------------

    local name =
        nil


    local stoneBucket =
        StoneByY[y]


    if stoneBucket
        and cleanBucket(
            stoneBucket
        ) then


        name =
            pickNearest(
                stoneBucket,
                anchorX,
                anchorZ
            )

    end


    --------------------------------------------------
    -- OTHERWISE ANY NON-BEDROCK
    --------------------------------------------------

    if not name then


        name =
            pickNearest(
                NonBedrockByY[y],
                anchorX,
                anchorZ
            )

    end


    return
        name,
        y

end


--------------------------------------------------
-- SELECTED TARGET
--------------------------------------------------

local function getSelectedTarget(
    anchorX,
    anchorZ
)

    local startDepth =
        safeNumber(
            START_DEPTH
        )
        or 0


    local y =
        deepestY(
            SelectedByY,
            startDepth
        )


    y =
        safeNumber(y)


    if y == nil then
        return nil
    end


    return
        pickNearest(
            SelectedByY[y],
            anchorX,
            anchorZ
        )

end


--------------------------------------------------
-- WAIT FOR MINE
--------------------------------------------------

local function waitForMine(run)

    while isRunning(run) do


        if setupIndex() then


            rescanMine()


            return true

        end


        task.wait(
            0.1
        )

    end


    return false

end


--------------------------------------------------
-- REACH START DEPTH
--------------------------------------------------

local function reachStartDepth(
    run
)

    local anchorX,
        anchorZ =

        getPlayerGridPosition()


    local minedBlocks =
        0


    Fluent:Notify({

        Title =
            "Depth Loader",

        Content =
            "Digging toward "
            .. tostring(
                START_DEPTH
            ),

        Duration =
            2

    })


    while isRunning(run) do


        --------------------------------------------------
        -- FOLDER RESET?
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then


            setupIndex()

        end


        --------------------------------------------------
        -- REFRESH
        --------------------------------------------------

        rescanMine()


        --------------------------------------------------
        -- DEEPEST LOADED
        --------------------------------------------------

        local currentDeepest =
            deepestY(
                NonBedrockByY,
                nil
            )


        currentDeepest =
            safeNumber(
                currentDeepest
            )


        --------------------------------------------------
        -- NOTHING AVAILABLE
        --------------------------------------------------

        if currentDeepest == nil then


            task.wait(
                0.05
            )


            continue

        end


        local startDepth =
            safeNumber(
                START_DEPTH
            )
            or 0


        --------------------------------------------------
        -- START DEPTH REACHED
        --------------------------------------------------

        if currentDeepest
            <= startDepth then


            Fluent:Notify({

                Title =
                    "Start Depth reached",

                Content =
                    "Deepest loaded Y = "
                    .. tostring(
                        currentDeepest
                    ),

                Duration =
                    3

            })


            return
                true,
                anchorX,
                anchorZ

        end


        --------------------------------------------------
        -- GET FRONTIER
        --------------------------------------------------

        local target,
            targetY =

            getFrontierTarget(
                anchorX,
                anchorZ
            )


        targetY =
            safeNumber(
                targetY
            )


        if not target then


            task.wait(
                0.05
            )


            continue

        end


        --------------------------------------------------
        -- UPDATE X/Z
        --------------------------------------------------

        local x,
            y,
            z =

            getCoordinatesFromName(
                target
            )


        x = safeNumber(x)
        y = safeNumber(y)
        z = safeNumber(z)


        if x ~= nil then

            anchorX =
                x

        end


        if z ~= nil then

            anchorZ =
                z

        end


        --------------------------------------------------
        -- MINE FRONTIER
        --------------------------------------------------

        mineTarget(
            target,
            "any",
            run
        )


        --------------------------------------------------
        -- SERVER MAY HAVE ADDED MORE BLOCKS
        --------------------------------------------------

        task.wait()

        rescanMine()


        minedBlocks =
            minedBlocks + 1


        --------------------------------------------------
        -- STATUS
        --------------------------------------------------

        if minedBlocks % 100
            == 0 then


            local depth =
                deepestY(
                    NonBedrockByY,
                    nil
                )


            Fluent:Notify({

                Title =
                    "Depth Loader",

                Content =
                    "Current deepest Y = "
                    .. tostring(
                        depth
                        or "?"
                    ),

                Duration =
                    2

            })

        end

    end


    return false

end


--------------------------------------------------
-- FARM LOOP
--------------------------------------------------

local function farmingLoop(
    run,
    anchorX,
    anchorZ
)

    local counter =
        0


    while isRunning(run) do


        --------------------------------------------------
        -- MINE RESET
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then


            setupIndex()

            rebuildSelectedIndex()

        end


        --------------------------------------------------
        -- PRIORITY 1:
        -- SELECTED ORE
        --------------------------------------------------

        local target =
            getSelectedTarget(
                anchorX,
                anchorZ
            )


        if target then


            local x,
                y,
                z =

                getCoordinatesFromName(
                    target
                )


            x = safeNumber(x)
            y = safeNumber(y)
            z = safeNumber(z)


            if x ~= nil then

                anchorX =
                    x

            end


            if z ~= nil then

                anchorZ =
                    z

            end


            mineTarget(
                target,
                "selected",
                run
            )


        else


            --------------------------------------------------
            -- PRIORITY 2:
            -- DEEPEST FRONTIER
            --------------------------------------------------

            local frontier,
                frontierY =

                getFrontierTarget(
                    anchorX,
                    anchorZ
                )


            frontierY =
                safeNumber(
                    frontierY
                )


            if frontier
                and frontierY ~= nil then


                --------------------------------------------------
                -- MIN DEPTH
                --------------------------------------------------

                local minDepth =
                    safeNumber(
                        MIN_DEPTH
                    )
                    or -4999


                if frontierY
                    <= minDepth then


                    task.wait(
                        0.1
                    )


                    continue

                end


                --------------------------------------------------
                -- UPDATE POSITION
                --------------------------------------------------

                local x,
                    y,
                    z =

                    getCoordinatesFromName(
                        frontier
                    )


                x = safeNumber(x)
                y = safeNumber(y)
                z = safeNumber(z)


                if x ~= nil then

                    anchorX =
                        x

                end


                if z ~= nil then

                    anchorZ =
                        z

                end


                --------------------------------------------------
                -- MINE ANY NON-BEDROCK FRONTIER
                --------------------------------------------------

                mineTarget(
                    frontier,
                    "any",
                    run
                )


            else


                task.wait(
                    0.1
                )

            end

        end


        --------------------------------------------------
        -- PERIODIC RESCAN
        --------------------------------------------------

        counter =
            counter + 1


        if counter % 25
            == 0 then


            rescanMine()

            rebuildSelectedIndex()

        end

    end

end


--------------------------------------------------
-- START MINING
--------------------------------------------------

local function startMining(
    run
)

    task.spawn(function()


        --------------------------------------------------
        -- WAIT FOR MINE
        --------------------------------------------------

        if not waitForMine(
            run
        ) then


            return

        end


        rebuildSelectedIndex()


        --------------------------------------------------
        -- PHASE 1:
        -- REACH START DEPTH
        --------------------------------------------------

        local reached,
            anchorX,
            anchorZ =

            reachStartDepth(
                run
            )


        if not reached
            or not isRunning(
                run
            ) then


            return

        end


        --------------------------------------------------
        -- REFRESH
        --------------------------------------------------

        rescanMine()

        rebuildSelectedIndex()


        --------------------------------------------------
        -- PHASE 2:
        -- FARM
        --------------------------------------------------

        farmingLoop(
            run,
            anchorX,
            anchorZ
        )

    end)

end


--------------------------------------------------
-- BUILD ORE LIST
--------------------------------------------------

local OreValues =
    {}


for id, data in pairs(
    BlocksData
) do


    if id
        and not string.match(
            tostring(id),
            "^StoneOre%d*$"
        )
        and id ~= "Bedrock" then


        local displayName =
            id


        if type(data)
            == "table" then


            displayName =
                data.name
                or data.Name
                or id

        end


        table.insert(
            OreValues,
            displayName
        )

    end

end


table.sort(
    OreValues
)



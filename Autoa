local OreValues = {}


for id, data in pairs(
    BlocksData
) do


    if id
        and not string.match(
            tostring(id),
            "^StoneOre%d*$"
        )
        and id ~= "Bedrock" then


        local displayName =
            id


        if type(data)
            == "table" then


            displayName =
                data.name
                or data.Name
                or id

        end


        table.insert(
            OreValues,
            displayName
        )

    end

end


table.sort(OreValues)



--------------------------------------------------
-- MAP HELPERS
--------------------------------------------------

local function addToBucket(
    map,
    y,
    name
)

    if not map[y] then
        map[y] = {}
    end


    map[y][name] =
        true

end


local function removeFromBucket(
    map,
    y,
    name
)

    if not y
        or not map[y] then

        return

    end


    map[y][name] =
        nil


    if next(
        map[y]
    ) == nil then

        map[y] =
            nil

    end

end


--------------------------------------------------
-- REMOVE INDEX ENTRY
--------------------------------------------------

local function removeIndexedName(
    name
)

    local y =
        YByName[name]


    removeFromBucket(
        NonBedrockByY,
        y,
        name
    )


    removeFromBucket(
        StoneByY,
        y,
        name
    )


    removeFromBucket(
        SelectedByY,
        y,
        name
    )


    ModelsByName[name] =
        nil

    YByName[name] =
        nil

end


--------------------------------------------------
-- REGISTER BLOCK
--------------------------------------------------

local function registerBlock(block)

    if not block
        or not block.Parent then

        return

    end


    local name =
        block.Name


    --------------------------------------------------
    -- CHILDADDED CAN FIRE BEFORE blocks[name]
    -- HAS BEEN UPDATED.
    --------------------------------------------------

    local data =
        getBlockDataByName(
            name
        )


    if not data then

        for i = 1, 5 do

            task.wait()

            data =
                getBlockDataByName(
                    name
                )

            if data then
                break
            end

        end

    end


    if not data then
        return
    end


    --------------------------------------------------
    -- REMOVE OLD CLASSIFICATION
    --------------------------------------------------

    if ModelsByName[name] then

        removeIndexedName(
            name
        )

    end


    --------------------------------------------------
    -- COORDINATES
    --------------------------------------------------

    local _,
        y,
        _ =

        getCoordinatesFromName(
            name
        )


    if not validDepth(y) then
        return
    end


    --------------------------------------------------
    -- INFO
    --------------------------------------------------

    local info =
        getBlockInfoByName(
            name
        )


    if not info then
        return
    end


    ModelsByName[name] =
        block

    YByName[name] =
        y


    --------------------------------------------------
    -- NON BEDROCK
    --------------------------------------------------

    if not isBedrock(info) then

        addToBucket(
            NonBedrockByY,
            y,
            name
        )

    end


    --------------------------------------------------
    -- STONE
    --------------------------------------------------

    if isStone(info) then

        addToBucket(
            StoneByY,
            y,
            name
        )

    end


    --------------------------------------------------
    -- SELECTED ORE
    --------------------------------------------------

    if isSelectedOre(info) then

        addToBucket(
            SelectedByY,
            y,
            name
        )

    end

end


--------------------------------------------------
-- UNREGISTER BLOCK
--------------------------------------------------

local function unregisterBlock(block)

    if not block then
        return
    end


    local name =
        block.Name


    --------------------------------------------------
    -- REPLACEBLOCK CREATES NEW MODEL FIRST,
    -- THEN DESTROYS OLD MODEL.
    --------------------------------------------------

    if ModelsByName[name]
        ~= block then

        return

    end


    removeIndexedName(
        name
    )

end


--------------------------------------------------
-- CLEAR INDEX
--------------------------------------------------

local function clearIndex()

    ModelsByName =
        {}

    YByName =
        {}

    NonBedrockByY =
        {}

    StoneByY =
        {}

    SelectedByY =
        {}

end


--------------------------------------------------
-- DISCONNECT
--------------------------------------------------

local function disconnectFolder()

    for _, connection in ipairs(
        FolderConnections
    ) do


        pcall(function()

            connection:Disconnect()

        end)

    end


    FolderConnections =
        {}

end


--------------------------------------------------
-- RESCAN MINE
--------------------------------------------------

local function rescanMine()

    local folder =
        MiningServiceClient.mineFolder


    if not folder then
        return false
    end


    for _, block in ipairs(
        folder:GetChildren()
    ) do


        if ModelsByName[
            block.Name
        ] ~= block then


            registerBlock(
                block
            )

        end

    end


    return true

end


--------------------------------------------------
-- SETUP INDEX
--------------------------------------------------

local function setupIndex()

    local folder =
        MiningServiceClient.mineFolder


    if not folder then
        return false
    end


    --------------------------------------------------
    -- SAME FOLDER
    --------------------------------------------------

    if IndexedFolder == folder then

        return true

    end


    --------------------------------------------------
    -- NEW FOLDER
    --------------------------------------------------

    disconnectFolder()

    clearIndex()


    IndexedFolder =
        folder


    --------------------------------------------------
    -- INITIAL SCAN
    --------------------------------------------------

    rescanMine()


    --------------------------------------------------
    -- NEW BLOCK
    --------------------------------------------------

    table.insert(

        FolderConnections,

        folder.ChildAdded:Connect(
            function(block)


                task.defer(function()

                    registerBlock(
                        block
                    )

                end)

            end
        )

    )


    --------------------------------------------------
    -- REMOVED BLOCK
    --------------------------------------------------

    table.insert(

        FolderConnections,

        folder.ChildRemoved:Connect(
            function(block)


                unregisterBlock(
                    block
                )

            end
        )

    )


    return true

end


--------------------------------------------------
-- REBUILD SELECTED ORE INDEX
--------------------------------------------------

local function rebuildSelectedIndex()

    SelectedByY =
        {}


    for name, model in pairs(
        ModelsByName
    ) do


        if model
            and model.Parent then


            local y =
                YByName[name]


            local info =
                getBlockInfoByName(
                    name
                )


            if y
                and info
                and isSelectedOre(info) then


                addToBucket(
                    SelectedByY,
                    y,
                    name
                )

            end

        end

    end

end


--------------------------------------------------
-- CLEAN BUCKET
--------------------------------------------------

local function cleanBucket(bucket)

    if not bucket then
        return false
    end


    for name in pairs(
        bucket
    ) do


        local model =
            ModelsByName[name]


        local data =
            getBlockDataByName(
                name
            )


        if not model
            or not model.Parent
            or not data
            or data[1] == "None" then


            bucket[name] =
                nil

        end

    end


    return
        next(bucket) ~= nil

end


--------------------------------------------------
-- DEEPEST Y
--------------------------------------------------

local function deepestY(
    map,
    maxY
)

    local result =
        nil


    for y, bucket in pairs(
        map
    ) do


        if y >= MIN_DEPTH
            and (
                maxY == nil
                or y <= maxY
            )
            and cleanBucket(bucket)
        then


            if result == nil
                or y < result then


                result =
                    y

            end

        end

    end


    return result

end


--------------------------------------------------
-- PLAYER GRID POSITION
--------------------------------------------------

local function getPlayerGridPosition()

    local character =
        LocalPlayer.Character


    if not character then

        return
            DEFAULT_X,
            DEFAULT_Z

    end


    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )


    if not root then

        return
            DEFAULT_X,
            DEFAULT_Z

    end


    local origin =
        MiningServiceClient.originPosition


    if not origin then

        return
            DEFAULT_X,
            DEFAULT_Z

    end


    return

        math.round(
            (
                root.Position.X
                - origin.X
            ) / 6
        ),

        math.round(
            (
                root.Position.Z
                - origin.Z
            ) / 6
        )

end


--------------------------------------------------
-- PICK NEAREST BLOCK IN BUCKET
--------------------------------------------------

local function pickNearest(
    bucket,
    targetX,
    targetZ
)

    if not bucket then
        return nil
    end


    local bestName =
        nil

    local bestDistance =
        math.huge

    local fallback =
        nil


    for name in pairs(
        bucket
    ) do


        local model =
            ModelsByName[name]


        if model
            and model.Parent then


            if not fallback then

                fallback =
                    name

            end


            local x,
                _,
                z =

                getCoordinatesFromName(
                    name
                )


            if x ~= nil
                and z ~= nil then


                local dx =
                    x - targetX

                local dz =
                    z - targetZ


                local distance =
                    dx * dx
                    + dz * dz


                if distance
                    < bestDistance then


                    bestDistance =
                        distance

                    bestName =
                        name

                end

            end

        end

    end


    return
        bestName
        or fallback

end


--------------------------------------------------
-- GET MODEL POSITION
--------------------------------------------------

local function getModelPosition(model)

    if not model then
        return nil
    end


    if model:IsA(
        "BasePart"
    ) then

        return
            model.Position

    end


    local success,
        pivot =

        pcall(function()

            return
                model:GetPivot()

        end)


    if success
        and pivot then

        return
            pivot.Position

    end


    return nil

end


--------------------------------------------------
-- MOVE CHARACTER NEAR TARGET
--------------------------------------------------

local function moveNearTarget(model)

    if not FOLLOW_TARGET then
        return true
    end


    if not model
        or not model.Parent then

        return false
    end


    local character =
        LocalPlayer.Character


    if not character then
        return false
    end


    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )


    if not root then
        return false
    end


    local targetPosition =
        getModelPosition(
            model
        )


    if not targetPosition then
        return false
    end


    --------------------------------------------------
    -- ALREADY CLOSE ENOUGH
    --------------------------------------------------

    local distance =
        (
            root.Position
            - targetPosition
        ).Magnitude


    if distance <= TARGET_DISTANCE then

        return true

    end


    --------------------------------------------------
    -- MOVE ABOVE BLOCK
    --------------------------------------------------

    local destination =
        targetPosition
        + Vector3.new(
            0,
            8,
            0
        )


    local look =
        root.CFrame.LookVector


    local success =
        pcall(function()


            character:PivotTo(

                CFrame.new(
                    destination,
                    destination + look
                )

            )


            root.AssemblyLinearVelocity =
                Vector3.zero


            root.AssemblyAngularVelocity =
                Vector3.zero

        end)


    task.wait()


    return success

end


--------------------------------------------------
-- GET REAL MINING SPEED
--------------------------------------------------

local function getMiningSpeed()

    local success,
        value =

        pcall(function()


            return
                DataClient:get({
                    "Boosts",
                    "Mining_Speed"
                })

        end)


    if not success then

        return 0

    end


    local number =
        tonumber(value)


    if not number then

        return 0

    end


    return
        math.max(
            number,
            0
        )

end


--------------------------------------------------
-- WAIT FOR REAL CLIENT COOLDOWN
--------------------------------------------------

local function waitForCooldown(run)

    while isRunning(run) do


        local last =
            MiningServiceClient.damageCooldown


        --------------------------------------------------
        -- READY
        --------------------------------------------------

        if not last then
            return true
        end


        --------------------------------------------------
        -- REQUEST CURRENTLY RUNNING
        --------------------------------------------------

        if last == math.huge then

            task.wait()

            continue

        end


        --------------------------------------------------
        -- GAME'S REAL SPEED VALUE
        --------------------------------------------------

        local speed =
            getMiningSpeed()


        local elapsed =
            workspace:GetServerTimeNow()
            - last


        local remaining =
            speed
            - elapsed


        --------------------------------------------------
        -- READY
        --------------------------------------------------

        if remaining <= 0 then

            return true

        end


        --------------------------------------------------
        -- SLEEP CLOSE TO EXACT READY TIME
        --------------------------------------------------

        task.wait(
            math.min(
                remaining,
                0.05
            )
        )

    end


    return false

end


--------------------------------------------------
-- CURRENT BLOCK STATE
--------------------------------------------------

local function getStateKey(name)

    local data =
        getBlockDataByName(
            name
        )


    if not data then
        return "NONE"
    end


    return
        tostring(
            data[1]
        )
        .. "|"
        .. tostring(
            data[2]
        )

end


--------------------------------------------------
-- MODE CHECK
--------------------------------------------------

local function modeAllows(
    name,
    mode
)

    local info =
        getBlockInfoByName(
            name
        )


    if not info then
        return false
    end


    if isBedrock(info) then
        return false
    end


    if mode == "selected" then

        return
            isSelectedOre(info)

    end


    if mode == "stone" then

        return
            isStone(info)

    end


    --------------------------------------------------
    -- ANY NON-BEDROCK
    --------------------------------------------------

    return true

end


--------------------------------------------------
-- MINE ONE BLOCK AS FAST AS GAME ALLOWS
--------------------------------------------------

local function mineTarget(
    name,
    mode,
    run
)

    if not name then
        return false
    end


    local stalled =
        0


    while isRunning(run) do


        --------------------------------------------------
        -- GET CURRENT MODEL
        --------------------------------------------------

        local model =
            ModelsByName[name]


        if not model
            or not model.Parent then


            local folder =
                MiningServiceClient.mineFolder


            if folder then

                model =
                    folder:FindFirstChild(
                        name
                    )

            end

        end


        --------------------------------------------------
        -- BLOCK DESTROYED
        --------------------------------------------------

        local data =
            getBlockDataByName(
                name
            )


        if not data
            or data[1] == "None"
            or not model
            or not model.Parent then


            return true

        end


        --------------------------------------------------
        -- BLOCK CHANGED TYPE
        --------------------------------------------------

        if not modeAllows(
            name,
            mode
        ) then


            return false

        end


        --------------------------------------------------
        -- KEEP PLAYER CLOSE
        --------------------------------------------------

        moveNearTarget(
            model
        )


        --------------------------------------------------
        -- WAIT FOR REAL COOLDOWN
        --------------------------------------------------

        if not waitForCooldown(
            run
        ) then


            return false

        end


        --------------------------------------------------
        -- RECHECK AFTER WAIT
        --------------------------------------------------

        model =
            ModelsByName[name]
            or model


        if not model
            or not model.Parent then


            return true

        end


        if not modeAllows(
            name,
            mode
        ) then


            return false

        end


        --------------------------------------------------
        -- SAVE OLD STATE
        --------------------------------------------------

        local before =
            getStateKey(
                name
            )


        --------------------------------------------------
        -- SET TARGET IMMEDIATELY BEFORE DAMAGE
        --------------------------------------------------

        MiningServiceClient.currentBlock =
            model


        --------------------------------------------------
        -- USE GAME'S OWN DAMAGE FUNCTION
        --------------------------------------------------

        local success =
            pcall(function()


                MiningServiceClient:
                damageBlock()

            end)


        --------------------------------------------------
        -- GIVE SERVER UPDATE / CHILD EVENTS A FRAME
        --------------------------------------------------

        task.wait()


        --------------------------------------------------
        -- DESTROYED?
        --------------------------------------------------

        local afterData =
            getBlockDataByName(
                name
            )


        local afterModel =
            ModelsByName[name]


        if not afterData
            or afterData[1] == "None"
            or not afterModel
            or not afterModel.Parent then


            return true

        end


        --------------------------------------------------
        -- STALL DETECTION
        --------------------------------------------------

        local after =
            getStateKey(
                name
            )


        if not success
            or before == after then


            stalled =
                stalled + 1


        else


            stalled =
                0

        end


        --------------------------------------------------
        -- SOMETHING IS REJECTING THIS TARGET
        --------------------------------------------------

        if stalled >= 20 then


            return false

        end

    end


    return false

end


--------------------------------------------------
-- GET FRONTIER
--------------------------------------------------

local function getFrontierTarget(
    anchorX,
    anchorZ
)

    --------------------------------------------------
    -- DEEPEST LOADED NON-BEDROCK Y
    --------------------------------------------------

    local y =
        deepestY(
            NonBedrockByY,
            nil
        )


    if y == nil then

        return
            nil,
            nil

    end


    --------------------------------------------------
    -- PREFER STONE ON FRONTIER
    --------------------------------------------------

    local stoneBucket =
        StoneByY[y]


    local name =
        nil


    if stoneBucket
        and cleanBucket(
            stoneBucket
        ) then


        name =
            pickNearest(
                stoneBucket,
                anchorX,
                anchorZ
            )

    end


    --------------------------------------------------
    -- OTHERWISE ANY NON-BEDROCK
    --------------------------------------------------

    if not name then


        name =
            pickNearest(
                NonBedrockByY[y],
                anchorX,
                anchorZ
            )

    end


    return
        name,
        y

end


--------------------------------------------------
-- GET SELECTED ORE TARGET
--------------------------------------------------

local function getSelectedTarget(
    anchorX,
    anchorZ
)

    local y =
        deepestY(
            SelectedByY,
            START_DEPTH
        )


    if y == nil then
        return nil
    end


    return
        pickNearest(
            SelectedByY[y],
            anchorX,
            anchorZ
        )

end


--------------------------------------------------
-- WAIT FOR MINE
--------------------------------------------------

local function waitForMine(run)

    while isRunning(run) do


        if setupIndex() then

            rescanMine()

            return true

        end


        task.wait(
            0.1
        )

    end


    return false

end


--------------------------------------------------
-- REACH START DEPTH
--------------------------------------------------

local function reachStartDepth(
    run
)

    local anchorX,
        anchorZ =

        getPlayerGridPosition()


    local attempts =
        0


    Fluent:Notify({

        Title =
            "Depth Loader",

        Content =
            "Digging toward "
            .. tostring(
                START_DEPTH
            ),

        Duration =
            2

    })


    while isRunning(run) do


        --------------------------------------------------
        -- FOLDER MAY CHANGE AFTER RESET
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then


            setupIndex()

        end


        --------------------------------------------------
        -- MAKE INDEX CURRENT
        --------------------------------------------------

        rescanMine()


        --------------------------------------------------
        -- CURRENT DEEPEST BLOCK
        --------------------------------------------------

        local currentDeepest =
            deepestY(
                NonBedrockByY,
                nil
            )


        if currentDeepest == nil then


            task.wait(
                0.05
            )

            continue

        end


        --------------------------------------------------
        -- START DEPTH REACHED
        --------------------------------------------------

        if currentDeepest
            <= START_DEPTH then


            Fluent:Notify({

                Title =
                    "Start Depth reached",

                Content =
                    "Deepest loaded Y = "
                    .. tostring(
                        currentDeepest
                    ),

                Duration =
                    3

            })


            return
                true,
                anchorX,
                anchorZ

        end


        --------------------------------------------------
        -- CHOOSE FRONTIER BLOCK
        --------------------------------------------------

        local target,
            targetY =

            getFrontierTarget(
                anchorX,
                anchorZ
            )


        if not target then


            task.wait(
                0.05
            )

            continue

        end


        --------------------------------------------------
        -- UPDATE ANCHOR
        --------------------------------------------------

        local x,
            _,
            z =

            getCoordinatesFromName(
                target
            )


        if x ~= nil then
            anchorX = x
        end


        if z ~= nil then
            anchorZ = z
        end


        --------------------------------------------------
        -- MINE FRONTIER
        --------------------------------------------------

        mineTarget(
            target,
            "any",
            run
        )


        --------------------------------------------------
        -- SERVER RESPONSE HAS ALREADY RUN addBlock()
        -- INSIDE MiningServiceClient:damageBlock().
        --------------------------------------------------

        task.wait()

        rescanMine()


        attempts =
            attempts + 1


        --------------------------------------------------
        -- OCCASIONAL STATUS
        --------------------------------------------------

        if attempts % 100 == 0 then


            local depth =
                deepestY(
                    NonBedrockByY,
                    nil
                )


            Fluent:Notify({

                Title =
                    "Depth Loader",

                Content =
                    "Current deepest Y = "
                    .. tostring(
                        depth
                        or "?"
                    ),

                Duration =
                    2

            })

        end

    end


    return false

end


--------------------------------------------------
-- FARM LOOP
--------------------------------------------------

local function farmingLoop(
    run,
    anchorX,
    anchorZ
)

    local counter =
        0


    while isRunning(run) do


        --------------------------------------------------
        -- MINE RESET / FOLDER CHANGE
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then


            setupIndex()

            rebuildSelectedIndex()

        end


        --------------------------------------------------
        -- PRIORITY 1:
        -- SELECTED ORES BELOW START DEPTH
        --------------------------------------------------

        local target =
            getSelectedTarget(
                anchorX,
                anchorZ
            )


        if target then


            local x,
                _,
                z =

                getCoordinatesFromName(
                    target
                )


            if x ~= nil then
                anchorX = x
            end


            if z ~= nil then
                anchorZ = z
            end


            mineTarget(
                target,
                "selected",
                run
            )


        else


            --------------------------------------------------
            -- PRIORITY 2:
            -- OPEN DEEPEST FRONTIER
            --------------------------------------------------

            local frontier,
                frontierY =

                getFrontierTarget(
                    anchorX,
                    anchorZ
                )


            if frontier
                and frontierY then


                --------------------------------------------------
                -- DON'T GO BELOW HARD LIMIT
                --------------------------------------------------

                if frontierY
                    <= MIN_DEPTH then


                    task.wait(
                        0.1
                    )

                    continue

                end


                local x,
                    _,
                    z =

                    getCoordinatesFromName(
                        frontier
                    )


                if x ~= nil then
                    anchorX = x
                end


                if z ~= nil then
                    anchorZ = z
                end


                --------------------------------------------------
                -- FRONTIER MAY NEED UNSELECTED ORE
                -- TO OPEN NEW BLOCKS.
                --------------------------------------------------

                mineTarget(
                    frontier,
                    "any",
                    run
                )


            else


                task.wait(
                    0.1
                )

            end

        end


        --------------------------------------------------
        -- PERIODIC HARD RESCAN
        --------------------------------------------------

        counter =
            counter + 1


        if counter % 25 == 0 then


            rescanMine()

            rebuildSelectedIndex()

        end

    end

end


--------------------------------------------------
-- START
--------------------------------------------------

local function startMining(
    run
)

    task.spawn(function()


        --------------------------------------------------
        -- WAIT FOR MINE
        --------------------------------------------------

        if not waitForMine(
            run
        ) then

            return

        end


        rebuildSelectedIndex()


        --------------------------------------------------
        -- PHASE 1:
        -- DIG DOWN USING REAL SERVER-GENERATED BLOCKS
        --------------------------------------------------

        local reached,
            anchorX,
            anchorZ =

            reachStartDepth(
                run
            )


        if not reached
            or not isRunning(run) then

            return

        end


        --------------------------------------------------
        -- REFRESH
        --------------------------------------------------

        rescanMine()

        rebuildSelectedIndex()


        --------------------------------------------------
        -- PHASE 2:
        -- FARM SELECTED ORES + KEEP OPENING FRONTIER
        --------------------------------------------------

        farmingLoop(
            run,
            anchorX,
            anchorZ
        )

    end)

end


--------------------------------------------------
-- BUILD ORE LIST
--------------------------------------------------

local OreValues =
    {}


for id, data in pairs(
    BlocksData
) do


    if id

        and not string.match(
            id,
            "^StoneOre%d*$"
        )

        and id ~= "Bedrock"

    then


        local displayName =
            id


        if type(data)
            == "table" then


            displayName =
                data.name
                or data.Name
                or id

        end


        table.insert(
            OreValues,
            displayName
        )

    end

end


table.sort(
    OreValues
)



--------------------------------------------------
-- UPDATE SELECTED ORES
--------------------------------------------------

MultiDropdown:OnChanged(
    function(values)


        SelectedOres = {}


        for name, enabled in pairs(
            values
        ) do


            if enabled then


                for id, data in pairs(
                    BlocksData
                ) do


                    local displayName =
                        id


                    if type(data)
                        == "table" then


                        displayName =
                            data.name
                            or data.Name
                            or id

                    end


                    if displayName
                        == name then


                        SelectedOres[id] =
                            true


                        break

                    end

                end

            end

        end


        --------------------------------------------------
        -- REFRESH CACHE
        --------------------------------------------------

        rebuildSelectedOreCache()

    end
)


--------------------------------------------------
-- START DEPTH INPUT
--------------------------------------------------

Tabs.Main:AddInput(
    "StartDepth",
    {

        Title =
            "Start Depth",

        Description =
            "Loader tunnel reaches this depth first.",

        Default =
            "0",

        Placeholder =
            "-3000",

        Numeric =
            false,

        Finished =
            true,

        Callback =
            function(Value)


                --------------------------------------------------
                -- NUMBER
                --------------------------------------------------

                local number =
                    tonumber(Value)


                if not number then


                    Fluent:Notify({

                        Title =
                            "Start Depth",

                        Content =
                            "Enter a number like -3000.",

                        Duration =
                            3

                    })


                    return

                end


                --------------------------------------------------
                -- ROUND
                --------------------------------------------------

                number =
                    math.round(number)


                --------------------------------------------------
                -- CLAMP
                --------------------------------------------------

                number =
                    math.clamp(
                        number,
                        MIN_DEPTH,
                        0
                    )


                --------------------------------------------------
                -- SAVE
                --------------------------------------------------

                START_DEPTH =
                    number


                --------------------------------------------------
                -- CACHE
                --------------------------------------------------

                rebuildSelectedOreCache()


                --------------------------------------------------
                -- MESSAGE
                --------------------------------------------------

                Fluent:Notify({

                    Title =
                        "Start Depth",

                    Content =
                        "Loader: 0 to "
                        .. tostring(START_DEPTH)
                        .. " | Full mine: "
                        .. tostring(START_DEPTH)
                        .. " to "
                        .. tostring(MIN_DEPTH),

                    Duration =
                        4

                })


                --------------------------------------------------
                -- RESTART IF ACTIVE
                --------------------------------------------------

                if AutoMine then


                    MiningRunId =
                        MiningRunId + 1


                    local runId =
                        MiningRunId


                    startMining(
                        runId
                    )

                end

            end

    }
)



    mode
)

    local y =
        safeNumber(
            YByName[name]
        )


    if not validDepth(y) then
        return false
    end


    local info =
        getBlockInfoByName(
            name
        )


    if not info
        or isBedrock(info) then

        return false

    end


    if mode == "selected" then


        return
            isSelectedOre(
                info
            )

    end


    if mode == "stone" then


        return
            isStone(
                info
            )

    end


    return true

end


--------------------------------------------------
-- MINE TARGET
--------------------------------------------------

local function mineTarget(
    name,
    mode,
    run
)

    if name == nil then
        return false
    end


    name =
        tostring(name)


    if BlockedTargets[name] then
        return false
    end


    local targetY =
        safeNumber(
            YByName[name]
        )


    if not validDepth(
        targetY
    ) then

        return false

    end


    local stalled =
        0


    while isRunning(run) do


        --------------------------------------------------
        -- MODEL
        --------------------------------------------------

        local model =
            ModelsByName[name]


        if not model
            or not model.Parent then


            local folder =
                MiningServiceClient.mineFolder


            if folder then


                model =
                    folder:
                    FindFirstChild(
                        name
                    )

            end

        end


        --------------------------------------------------
        -- DATA
        --------------------------------------------------

        local data =
            getBlockDataByName(
                name
            )


        --------------------------------------------------
        -- DESTROYED
        --------------------------------------------------

        if not data
            or data[1] == "None"
            or not model
            or not model.Parent then


            BlockedTargets[name] =
                nil


            return true

        end


        --------------------------------------------------
        -- MODE
        --------------------------------------------------

        if not modeAllows(
            name,
            mode
        ) then

            return false

        end


        --------------------------------------------------
        -- FOLLOW
        --------------------------------------------------

        moveNearTarget(
            model
        )


        --------------------------------------------------
        -- COOLDOWN
        --------------------------------------------------

        if not waitForCooldown(
            run
        ) then

            return false

        end


        --------------------------------------------------
        -- RECHECK
        --------------------------------------------------

        data =
            getBlockDataByName(
                name
            )


        if not data
            or data[1] == "None" then

            return true

        end


        model =
            ModelsByName[name]
            or model


        if not model
            or not model.Parent then

            return true

        end


        if not modeAllows(
            name,
            mode
        ) then

            return false

        end


        --------------------------------------------------
        -- BEFORE
        --------------------------------------------------

        local before =
            getStateKey(
                name
            )


        --------------------------------------------------
        -- CURRENT BLOCK
        --------------------------------------------------

        MiningServiceClient.currentBlock =
            model


        --------------------------------------------------
        -- DAMAGE
        --------------------------------------------------

        local success =
            pcall(function()


                MiningServiceClient:
                damageBlock()

            end)


        --------------------------------------------------
        -- SERVER UPDATE
        --------------------------------------------------

        task.wait()


        --------------------------------------------------
        -- AFTER
        --------------------------------------------------

        local afterData =
            getBlockDataByName(
                name
            )


        local afterModel =
            ModelsByName[name]


        --------------------------------------------------
        -- DESTROYED
        --------------------------------------------------

        if not afterData
            or afterData[1] == "None"
            or not afterModel
            or not afterModel.Parent then


            return true

        end


        local after =
            getStateKey(
                name
            )


        --------------------------------------------------
        -- STALL
        --------------------------------------------------

        if not success
            or before == after then


            stalled =
                stalled + 1


        else


            stalled =
                0

        end


        --------------------------------------------------
        -- SKIP BROKEN TARGET
        --------------------------------------------------

        if stalled
            >= STALL_LIMIT then


            BlockedTargets[name] =
                true


            warn(
                "Ore Miner: skipping stalled block:",
                name
            )


            return false

        end

    end


    return false

end


--------------------------------------------------
-- FRONTIER TARGET
--------------------------------------------------

local function getFrontierTarget(
    anchorX,
    anchorZ
)

    local _,
        effectiveEnd =

        getEffectiveDepthRange()


    --------------------------------------------------
    -- WE NEED FRONTIER FROM CURRENT MINE,
    -- BUT NEVER BELOW END DEPTH.
    --------------------------------------------------

    local y =
        deepestY(
            NonBedrockByY,
            nil,
            effectiveEnd
        )


    y =
        safeNumber(y)


    if y == nil then

        return
            nil,
            nil

    end


    local name =
        nil


    --------------------------------------------------
    -- STONE FIRST FOR PATH
    --------------------------------------------------

    local stoneBucket =
        StoneByY[y]


    if stoneBucket
        and cleanBucket(
            stoneBucket
        ) then


        name =
            pickNearest(
                stoneBucket,
                anchorX,
                anchorZ
            )

    end


    --------------------------------------------------
    -- ANY NON BEDROCK
    --------------------------------------------------

    if not name then


        name =
            pickNearest(
                NonBedrockByY[y],
                anchorX,
                anchorZ
            )

    end


    return
        name,
        y

end


--------------------------------------------------
-- HIGHEST VALUE SELECTED ORE
--------------------------------------------------

local function getSelectedTarget(
    anchorX,
    anchorZ
)

    anchorX =
        safeNumber(
            anchorX
        )
        or DEFAULT_X


    anchorZ =
        safeNumber(
            anchorZ
        )
        or DEFAULT_Z


    local bestName =
        nil


    local bestValue =
        -math.huge


    local bestDistance =
        math.huge


    --------------------------------------------------
    -- CHECK ALL SELECTED ORES
    --------------------------------------------------

    for rawY,
        bucket in pairs(
            SelectedByY
        ) do


        local y =
            safeNumber(
                rawY
            )


        --------------------------------------------------
        -- ONLY BETWEEN START + END
        --------------------------------------------------

        if y ~= nil
            and inFarmDepth(y) then


            for name in pairs(
                bucket
            ) do


                if not BlockedTargets[name] then


                    local model =
                        ModelsByName[name]


                    if model
                        and model.Parent then


                        local info =
                            getBlockInfoByName(
                                name
                            )


                        if info
                            and isSelectedOre(
                                info
                            ) then


                            --------------------------------------------------
                            -- VALUE
                            --------------------------------------------------

                            local value =
                                getComparableValue(
                                    info.Value
                                )


                            --------------------------------------------------
                            -- DISTANCE
                            --------------------------------------------------

                            local x,
                                _,
                                z =

                                getCoordinatesFromName(
                                    name
                                )


                            x =
                                safeNumber(x)


                            z =
                                safeNumber(z)


                            local distance =
                                math.huge


                            if x ~= nil
                                and z ~= nil then


                                local dx =
                                    x - anchorX


                                local dz =
                                    z - anchorZ


                                distance =
                                    dx * dx
                                    + dz * dz

                            end


                            --------------------------------------------------
                            -- HIGHEST VALUE FIRST
                            --------------------------------------------------

                            if value
                                > bestValue then


                                bestValue =
                                    value


                                bestDistance =
                                    distance


                                bestName =
                                    name


                            --------------------------------------------------
                            -- SAME VALUE = NEAREST
                            --------------------------------------------------

                            elseif value
                                    == bestValue
                                and distance
                                    < bestDistance then


                                bestDistance =
                                    distance


                                bestName =
                                    name

                            end

                        end

                    end

                end

            end

        end

    end


    return
        bestName

end



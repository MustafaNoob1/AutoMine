--------------------------------------------------
-- MODE CHECK
--------------------------------------------------

local function modeAllows(
    name,
    mode
)

    local y =
        safeNumber(
            YByName[name]
        )


    if not validDepth(y) then
        return false
    end


    local info =
        getBlockInfoByName(
            name
        )


    if not info
        or isBedrock(info) then

        return false

    end


    if mode == "selected" then

        return
            isSelectedOre(info)

    end


    if mode == "stone" then

        return
            isStone(info)

    end


    return true

end


--------------------------------------------------
-- MINE TARGET
--------------------------------------------------

local function mineTarget(
    name,
    mode,
    run
)

    if name == nil then
        return false
    end


    name =
        tostring(name)


    if BlockedTargets[name] then
        return false
    end


    local targetY =
        safeNumber(
            YByName[name]
        )


    if not validDepth(
        targetY
    ) then

        return false

    end


    local stalled =
        0


    while isRunning(run) do


        --------------------------------------------------
        -- MODEL
        --------------------------------------------------

        local model =
            ModelsByName[name]


        if not model
            or not model.Parent then


            local folder =
                MiningServiceClient.mineFolder


            if folder then

                model =
                    folder:
                    FindFirstChild(
                        name
                    )

            end

        end


        --------------------------------------------------
        -- DATA
        --------------------------------------------------

        local data =
            getBlockDataByName(
                name
            )


        --------------------------------------------------
        -- DESTROYED
        --------------------------------------------------

        if not data
            or data[1] == "None"
            or not model
            or not model.Parent then


            BlockedTargets[name] =
                nil

            return true

        end


        --------------------------------------------------
        -- MODE
        --------------------------------------------------

        if not modeAllows(
            name,
            mode
        ) then

            return false

        end


        --------------------------------------------------
        -- FOLLOW
        --------------------------------------------------

        moveNearTarget(
            model
        )


        --------------------------------------------------
        -- COOLDOWN
        --------------------------------------------------

        if not waitForCooldown(
            run
        ) then

            return false

        end


        --------------------------------------------------
        -- RECHECK
        --------------------------------------------------

        data =
            getBlockDataByName(
                name
            )


        if not data
            or data[1] == "None" then

            return true

        end


        model =
            ModelsByName[name]
            or model


        if not model
            or not model.Parent then

            return true

        end


        if not modeAllows(
            name,
            mode
        ) then

            return false

        end


        --------------------------------------------------
        -- BEFORE
        --------------------------------------------------

        local before =
            getStateKey(
                name
            )


        --------------------------------------------------
        -- SET CURRENT BLOCK
        --------------------------------------------------

        MiningServiceClient.currentBlock =
            model


        --------------------------------------------------
        -- ORIGINAL GAME DAMAGE FUNCTION
        --------------------------------------------------

        local success =
            pcall(function()


                MiningServiceClient:
                damageBlock()

            end)


        --------------------------------------------------
        -- ALLOW SERVER UPDATE
        --------------------------------------------------

        task.wait()


        --------------------------------------------------
        -- AFTER
        --------------------------------------------------

        local afterData =
            getBlockDataByName(
                name
            )


        local afterModel =
            ModelsByName[name]


        --------------------------------------------------
        -- DESTROYED
        --------------------------------------------------

        if not afterData
            or afterData[1] == "None"
            or not afterModel
            or not afterModel.Parent then


            return true

        end


        local after =
            getStateKey(
                name
            )


        --------------------------------------------------
        -- STALL DETECTION
        --------------------------------------------------

        if not success
            or before == after then


            stalled =
                stalled + 1


        else


            stalled =
                0

        end


        --------------------------------------------------
        -- IGNORE FAILED TARGET
        --------------------------------------------------

        if stalled >= STALL_LIMIT then


            BlockedTargets[name] =
                true


            warn(
                "Ore Miner: skipping stalled block:",
                name
            )


            return false

        end

    end


    return false

end


--------------------------------------------------
-- FRONTIER TARGET
--------------------------------------------------

local function getFrontierTarget(
    anchorX,
    anchorZ
)

    local y =
        deepestY(
            NonBedrockByY,
            nil
        )


    y =
        safeNumber(y)


    if y == nil then

        return
            nil,
            nil

    end


    --------------------------------------------------
    -- STONE FIRST
    --------------------------------------------------

    local name =
        nil


    local stoneBucket =
        StoneByY[y]


    if stoneBucket
        and cleanBucket(
            stoneBucket
        ) then


        name =
            pickNearest(
                stoneBucket,
                anchorX,
                anchorZ
            )

    end


    --------------------------------------------------
    -- OTHERWISE ANY BLOCK
    --------------------------------------------------

    if not name then


        name =
            pickNearest(
                NonBedrockByY[y],
                anchorX,
                anchorZ
            )

    end


    return
        name,
        y

end


--------------------------------------------------
-- MOST VALUABLE SELECTED ORE
--------------------------------------------------

local function getSelectedTarget(
    anchorX,
    anchorZ
)

    anchorX =
        safeNumber(anchorX)
        or DEFAULT_X


    anchorZ =
        safeNumber(anchorZ)
        or DEFAULT_Z


    local bestName =
        nil

    local bestValue =
        -math.huge

    local bestDistance =
        math.huge


    --------------------------------------------------
    -- SEARCH ALL SELECTED ORES
    --------------------------------------------------

    for rawY,
        bucket in pairs(
            SelectedByY
        ) do


        local y =
            safeNumber(rawY)


        if y ~= nil
            and inFarmDepth(y) then


            for name in pairs(
                bucket
            ) do


                if not BlockedTargets[name] then


                    local model =
                        ModelsByName[name]


                    if model
                        and model.Parent then


                        local info =
                            getBlockInfoByName(
                                name
                            )


                        if info
                            and isSelectedOre(
                                info
                            ) then


                            --------------------------------------------------
                            -- VALUE
                            --------------------------------------------------

                            local value =
                                getComparableValue(
                                    info.Value
                                )


                            --------------------------------------------------
                            -- DISTANCE
                            --------------------------------------------------

                            local x,
                                _,
                                z =

                                getCoordinatesFromName(
                                    name
                                )


                            x =
                                safeNumber(x)

                            z =
                                safeNumber(z)


                            local distance =
                                math.huge


                            if x ~= nil
                                and z ~= nil then


                                local dx =
                                    x - anchorX

                                local dz =
                                    z - anchorZ


                                distance =
                                    dx * dx
                                    + dz * dz

                            end


                            --------------------------------------------------
                            -- HIGHER VALUE WINS
                            --------------------------------------------------

                            if value > bestValue then


                                bestValue =
                                    value

                                bestDistance =
                                    distance

                                bestName =
                                    name


                            --------------------------------------------------
                            -- SAME VALUE:
                            -- NEAREST WINS
                            --------------------------------------------------

                            elseif value == bestValue
                                and distance
                                    < bestDistance then


                                bestDistance =
                                    distance

                                bestName =
                                    name

                            end

                        end

                    end

                end

            end

        end

    end


    return bestName

end


--------------------------------------------------
-- WAIT FOR MINE
--------------------------------------------------

local function waitForMine(run)

    while isRunning(run) do


        --------------------------------------------------
        -- WAIT FOR GAME SERVICE INITIALIZATION
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            and MiningServiceClient.blocks then


            if setupIndex() then


                rescanMine()

                return true

            end

        end


        task.wait(
            0.1
        )

    end


    return false

end


--------------------------------------------------
-- REACH EFFECTIVE START DEPTH
--------------------------------------------------

local function reachStartDepth(run)

    local anchorX,
        anchorZ =

        getPlayerGridPosition()


    local effectiveStart =
        getEffectiveStartDepth()


    --------------------------------------------------
    -- INFORM IF RANK LIMIT CHANGED REQUEST
    --------------------------------------------------

    if START_DEPTH
        < RANK_MAX_DEPTH then


        Fluent:Notify({

            Title =
                "Rank Depth Limit",

            Content =
                "Requested "
                .. tostring(
                    START_DEPTH
                )
                .. " | Rank allows "
                .. tostring(
                    RANK_MAX_DEPTH
                ),

            Duration =
                4

        })

    end


    Fluent:Notify({

        Title =
            "Depth Loader",

        Content =
            "Effective Start Depth: "
            .. tostring(
                effectiveStart
            ),

        Duration =
            2

    })


    while isRunning(run) do


        --------------------------------------------------
        -- REFRESH
        --------------------------------------------------

        rescanMine()


        --------------------------------------------------
        -- CURRENT DEEPEST
        --------------------------------------------------

        local currentDeepest =
            deepestY(
                NonBedrockByY,
                nil
            )


        currentDeepest =
            safeNumber(
                currentDeepest
            )


        if currentDeepest == nil then

            task.wait(
                0.05
            )

            continue

        end


        --------------------------------------------------
        -- START REACHED
        --------------------------------------------------

        if currentDeepest
            <= effectiveStart then


            Fluent:Notify({

                Title =
                    "Farm Depth reached",

                Content =
                    "Current Y: "
                    .. tostring(
                        currentDeepest
                    ),

                Duration =
                    2

            })


            return
                true,
                anchorX,
                anchorZ

        end


        --------------------------------------------------
        -- FRONTIER
        --------------------------------------------------

        local target,
            targetY =

            getFrontierTarget(
                anchorX,
                anchorZ
            )


        targetY =
            safeNumber(
                targetY
            )


        if not target then

            task.wait(
                0.05
            )

            continue

        end


        --------------------------------------------------
        -- SAFETY RANK CHECK
        --------------------------------------------------

        if targetY == nil
            or not validDepth(
                targetY
            ) then


            BlockedTargets[target] =
                true


            task.wait()

            continue

        end


        --------------------------------------------------
        -- UPDATE ANCHOR
        --------------------------------------------------

        local x,
            _,
            z =

            getCoordinatesFromName(
                target
            )


        x = safeNumber(x)
        z = safeNumber(z)


        if x ~= nil then
            anchorX = x
        end


        if z ~= nil then
            anchorZ = z
        end


        --------------------------------------------------
        -- MINE
        --------------------------------------------------

        mineTarget(
            target,
            "any",
            run
        )


        task.wait()

        rescanMine()

    end


    return false

end


--------------------------------------------------
-- FARM LOOP
--------------------------------------------------

local function farmingLoop(
    run,
    anchorX,
    anchorZ
)

    local counter =
        0


    while isRunning(run) do


        --------------------------------------------------
        -- RANK LIMIT MAY CHANGE
        --------------------------------------------------

        local effectiveStart =
            getEffectiveStartDepth()


        --------------------------------------------------
        -- PRIORITY 1:
        -- HIGHEST VALUE SELECTED ORE
        --------------------------------------------------

        local target =
            getSelectedTarget(
                anchorX,
                anchorZ
            )


        if target then


            local x,
                _,
                z =

                getCoordinatesFromName(
                    target
                )


            x = safeNumber(x)
            z = safeNumber(z)


            if x ~= nil then
                anchorX = x
            end


            if z ~= nil then
                anchorZ = z
            end


            mineTarget(
                target,
                "selected",
                run
            )


        else


            --------------------------------------------------
            -- PRIORITY 2:
            -- OPEN DEEPEST ACCESSIBLE FRONTIER
            --------------------------------------------------

            local frontier,
                frontierY =

                getFrontierTarget(
                    anchorX,
                    anchorZ
                )


            frontierY =
                safeNumber(
                    frontierY
                )


            if frontier
                and frontierY ~= nil
                and validDepth(
                    frontierY
                ) then


                local x,
                    _,
                    z =

                    getCoordinatesFromName(
                        frontier
                    )


                x =
                    safeNumber(x)

                z =
                    safeNumber(z)


                if x ~= nil then
                    anchorX = x
                end


                if z ~= nil then
                    anchorZ = z
                end


                mineTarget(
                    frontier,
                    "any",
                    run
                )


            else


                task.wait(
                    0.1
                )

            end

        end


        --------------------------------------------------
        -- PERIODIC REFRESH
        --------------------------------------------------

        counter =
            counter + 1


        if counter % 25 == 0 then


            rescanMine()

            rebuildSelectedIndex()

        end

    end

end


--------------------------------------------------
-- START MINING
--------------------------------------------------

local function startMining(run)

    task.spawn(function()


        --------------------------------------------------
        -- REFRESH CURRENT RANK FIRST
        --------------------------------------------------

        refreshRankDepth()


        --------------------------------------------------
        -- CLEAR TEMP BLOCK FAILURES
        --------------------------------------------------

        BlockedTargets =
            {}


        --------------------------------------------------
        -- WAIT FOR MINE
        --------------------------------------------------

        if not waitForMine(
            run
        ) then

            return

        end


        --------------------------------------------------
        -- INDEX MUST RESPECT CURRENT RANK
        --------------------------------------------------

        rebuildWholeIndex()

        rebuildSelectedIndex()


        --------------------------------------------------
        -- PHASE 1
        --------------------------------------------------

        local reached,
            anchorX,
            anchorZ =

            reachStartDepth(
                run
            )


        if not reached
            or not isRunning(
                run
            ) then

            return

        end


        --------------------------------------------------
        -- REFRESH
        --------------------------------------------------

        rescanMine()

        rebuildSelectedIndex()


        --------------------------------------------------
        -- PHASE 2
        --------------------------------------------------

        farmingLoop(
            run,
            anchorX,
            anchorZ
        )

    end)

end



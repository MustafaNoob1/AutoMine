--------------------------------------------------
-- GET BLOCK DATA
--------------------------------------------------

local function getBlockDataByName(name)

    if name == nil then
        return nil
    end


    return
        MiningServiceClient.blocks[
            tostring(name)
        ]

end


--------------------------------------------------
-- GET BLOCK INFO
--------------------------------------------------

local function getBlockInfoByName(name)

    local data =
        getBlockDataByName(
            name
        )


    if not data then
        return nil
    end


    local id =
        data[1]


    if not id
        or id == "None" then

        return nil

    end


    local info =
        MiningInfo:getBlock(
            id
        )


    if not info then
        return nil
    end


    return {

        Id =
            id,

        Name =
            info.name,

        HP =
            info.hp,

        Value =
            info.value,

        Model =
            info.model

    }

end


--------------------------------------------------
-- STONE
--------------------------------------------------

local function isStone(info)

    if not info then
        return false
    end


    return
        string.match(
            tostring(info.Id),
            "^StoneOre%d*$"
        ) ~= nil

end


--------------------------------------------------
-- BEDROCK
--------------------------------------------------

local function isBedrock(info)

    if not info then
        return false
    end


    return
        tostring(info.Id)
        == "Bedrock"

end


--------------------------------------------------
-- SELECTED ORE
--------------------------------------------------

local function isSelectedOre(info)

    if not info then
        return false
    end


    if isStone(info) then
        return false
    end


    if isBedrock(info) then
        return false
    end


    return
        SelectedOres[
            info.Id
        ] == true

end



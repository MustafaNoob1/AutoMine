-- AUTO MINE
--------------------------------------------------

local Toggle =
    Tabs.Main:AddToggle(
        "AutoMine",
        {

            Title =
                "Auto Mine",

            Description =
                "Smart server-update based mining.",

            Default =
                false

        }
    )


--------------------------------------------------
-- AUTO MINE CHANGED
--------------------------------------------------

Toggle:OnChanged(
    function(value)


        --------------------------------------------------
        -- INVALIDATE OLD RUN
        --------------------------------------------------

        RunId =
            RunId + 1


        AutoMine =
            value


        --------------------------------------------------
        -- START
        --------------------------------------------------

        if AutoMine then


            local run =
                RunId


            Fluent:Notify({

                Title =
                    "Auto Mine",

                Content =
                    "Starting. Target depth: "
                    .. tostring(
                        START_DEPTH
                    ),

                Duration =
                    3

            })


            startMining(
                run
            )


        --------------------------------------------------
        -- STOP
        --------------------------------------------------

        else


            Fluent:Notify({

                Title =
                    "Auto Mine",

                Content =
                    "Mining stopped.",

                Duration =
                    2

            })

        end

    end
)



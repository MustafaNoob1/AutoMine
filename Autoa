                    "Loader tunnel -> "
                    .. tostring(START_DEPTH),

                Duration =
                    3

            })


            startMining(
                runId
            )


        --------------------------------------------------
        -- STOP
        --------------------------------------------------

        else


            Fluent:Notify({

                Title =
                    "Auto Mine",

                Content =
                    "Mining stopped.",

                Duration =
                    2

            })

        end

    end
)



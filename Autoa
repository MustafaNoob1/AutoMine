--------------------------------------------------

pcall(function()


    DataClient:
        getChangedSignal({
            "Mining",
            "Rank"
        })
        :Connect(
            function()


                local oldLimit =
                    RANK_MAX_DEPTH


                refreshRankDepth()


                BlockedTargets =
                    {}


                rebuildWholeIndex()


                rebuildSelectedIndex()


                updateRankDisplay()


                Fluent:Notify({

                    Title =
                        "Mining Rank Updated",

                    Content =
                        "Depth: "
                        .. tostring(
                            oldLimit
                        )
                        .. " -> "
                        .. tostring(
                            RANK_MAX_DEPTH
                        ),

                    Duration =
                        4

                })


                --------------------------------------------------
                -- RESTART
                --------------------------------------------------

                if AutoMine then


                    RunId =
                        RunId + 1


                    startMining(
                        RunId
                    )

                end

            end
        )

end)



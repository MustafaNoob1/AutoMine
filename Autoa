--------------------------------------------------
-- STONE
--------------------------------------------------

local function isStone(info)

    if not info then
        return false
    end


    return
        string.match(
            tostring(
                info.Id
            ),
            "^StoneOre%d*$"
        ) ~= nil

end


--------------------------------------------------
-- BEDROCK
--------------------------------------------------

local function isBedrock(info)

    if not info then
        return false
    end


    return
        tostring(
            info.Id
        ) == "Bedrock"

end


--------------------------------------------------
-- SELECTED ORE
--------------------------------------------------

local function isSelectedOre(info)

    if not info then
        return false
    end


    if isStone(info)
        or isBedrock(info) then

        return false

    end


    return
        SelectedOres[
            info.Id
        ] == true

end


--------------------------------------------------
-- VALUE CONVERSION
--------------------------------------------------

local function getComparableValue(value)

    if value == nil then
        return 0
    end


    --------------------------------------------------
    -- ETERNITY NUMBER
    --------------------------------------------------

    local success,
        result =

        pcall(function()

            return
                EternityNum.bnumtofloat(
                    value
                )

        end)


    if success then

        result =
            safeNumber(result)


        if result ~= nil then
            return result
        end

    end


    --------------------------------------------------
    -- NORMAL NUMBER
    --------------------------------------------------

    return
        safeNumber(value)
        or 0

end



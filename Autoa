updateStatsDisplay = function()
    local runtime = Stats.StartTime and (os.clock() - Stats.StartTime) or 0
    local blocksPerMinute = runtime > 0 and (Stats.BlocksMined / runtime * 60) or 0
    local oresPerMinute = runtime > 0 and (Stats.OresMined / runtime * 60) or 0
    local valuePerHour = runtime > 0 and (Stats.EstimatedValue / runtime * 3600) or 0

    local text = "Status: " .. tostring(Stats.Status)
        .. "\nRuntime: " .. formatTime(runtime)
        .. "\nProfile: " .. tostring(FARM_PROFILE)
        .. "\nAuto Depth: " .. tostring(AUTO_DEPTH_MODE)
        .. "\nPriority: " .. tostring(PRIORITY_MODE)
        .. "\nSweep: " .. tostring(SWEEP_MODE)
        .. "\n\nCurrent Target: " .. tostring(Stats.CurrentTarget or "-")
        .. "\nTarget Depth: " .. tostring(Stats.CurrentTargetDepth or "-")
        .. "\nTarget Value: " .. formatNumber(Stats.CurrentTargetValue)
        .. "\n\nBlocks Mined: " .. formatNumber(Stats.BlocksMined)
        .. "\nOres Mined: " .. formatNumber(Stats.OresMined)
        .. "\nEstimated Value: " .. formatNumber(Stats.EstimatedValue)
        .. "\nBlocks/min: " .. string.format("%.1f", blocksPerMinute)
        .. "\nOres/min: " .. string.format("%.1f", oresPerMinute)
        .. "\nValue/hour: " .. formatNumber(valuePerHour)
        .. "\nRare Found: " .. tostring(Stats.RareFound)
        .. "\nMine Resets: " .. tostring(Stats.Resets)
        .. "\nAuto Sells: " .. tostring(Stats.AutoSells or 0)
        .. "\nBucks Upgrades Bought: " .. tostring(Stats.BucksUpgradesBought or 0)
        .. "\nRanks Bought: " .. tostring(Stats.RanksBought or 0)
        .. "\nLast Reset: " .. tostring(Stats.LastResetReason or "-")

    pcall(function()
        StatsDisplay:SetDesc(text)
    end)
end

updateProgressDisplay = function()
    local y = safeNumber(Stats.CurrentSweepY)
    local rangeRemaining = countRemainingInRange()

    if y == nil then
        local effectiveStart = getEffectiveDepthRange()
        y = safeNumber(effectiveStart)
    end

    if y == nil then
        pcall(function()
            ProgressDisplay:SetDesc("No active layer")
        end)
        return
    end

    local remaining = countRemainingAtY(y)
    local mined = CycleMinedByDepth[y] or 0
    local knownTotal = mined + remaining
    local percent = knownTotal > 0 and ((mined / knownTotal) * 100) or 100

    local cycleProgress, cycleMined = getCycleProgress()
    local oreIdle = LastOreMinedAt and (os.clock() - LastOreMinedAt) or 0

    local text = "Current Layer: " .. tostring(y)
        .. "\nKnown Mined: " .. tostring(mined)
        .. "\nKnown Remaining: " .. tostring(remaining)
        .. "\nKnown Progress: " .. string.format("%.1f%%", percent)
        .. "\nRange Remaining (known): " .. tostring(rangeRemaining)
        .. "\n\nCycle Mined: " .. tostring(cycleMined)
        .. "\nCycle Known Progress: " .. string.format("%.1f%%", cycleProgress * 100)
        .. "\nOre Idle: " .. string.format("%.1fs", oreIdle)
        .. "\nSmart Reset: " .. tostring(SMART_RESET and AUTO_RESET_MINE)
        .. "\n\nNote: progress is based on blocks currently revealed by the client."

    pcall(function()
        ProgressDisplay:SetDesc(text)
    end)
end


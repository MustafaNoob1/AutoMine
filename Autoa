--------------------------------------------------
-- START DEPTH
--------------------------------------------------

Tabs.Main:AddInput(
    "StartDepth",
    {

        Title =
            "Start Depth",

        Description =
            "Farm selected ores from this depth downward.",

        Default =
            "0",

        Placeholder =
            "-3000",

        Numeric =
            false,

        Finished =
            true,

        Callback =
            function(value)


                local number =
                    safeNumber(
                        value
                    )


                if number == nil then


                    Fluent:Notify({

                        Title =
                            "Start Depth",

                        Content =
                            "Enter e.g. -3000",

                        Duration =
                            2

                    })


                    return

                end


                --------------------------------------------------
                -- FORCE NUMERIC START DEPTH
                --------------------------------------------------

                START_DEPTH =
                    math.clamp(
                        math.round(
                            number
                        ),
                        safeNumber(
                            MIN_DEPTH
                        )
                        or -4999,
                        0
                    )


                rebuildSelectedIndex()


                Fluent:Notify({

                    Title =
                        "Start Depth",

                    Content =
                        "Start Depth = "
                        .. tostring(
                            START_DEPTH
                        ),

                    Duration =
                        2

                })


                --------------------------------------------------
                -- RESTART
                --------------------------------------------------

                if AutoMine then


                    RunId =
                        RunId + 1


                    local run =
                        RunId


                    startMining(
                        run
                    )

                end

            end

    }
)



    --------------------------------------------------

    if not string.match(
        id,
        "^StoneOre%d*$"
    )
        and id ~= "Bedrock" then


        --------------------------------------------------
        -- CRITICAL DROPDOWN FIX
        --
        -- DISPLAY NAME MUST ALWAYS BE STRING.
        --------------------------------------------------

        local displayName =
            id


        if type(data) == "table" then


            if type(data.name) == "string" then

                displayName =
                    data.name


            elseif type(data.Name) == "string" then

                displayName =
                    data.Name

            end

        end


        displayName =
            tostring(
                displayName
            )


        --------------------------------------------------
        -- AVOID DUPLICATE DISPLAY NAMES
        --------------------------------------------------

        if OreDisplayToId[
            displayName
        ] == nil then


            table.insert(
                OreValues,
                displayName
            )


            OreDisplayToId[
                displayName
            ] =
                id


            --------------------------------------------------
            -- SELECT INTERNALLY BY DEFAULT
            --------------------------------------------------

            SelectedOres[
                id
            ] =
                true

        end

    end

end



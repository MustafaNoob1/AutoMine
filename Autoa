--------------------------------------------------

local function mineTarget(
    name,
    mode,
    run
)

    if name == nil then
        return false
    end


    name =
        tostring(
            name
        )


    if BlockedTargets[
        name
    ] then

        return false

    end


    local targetY =
        safeNumber(
            YByName[name]
        )


    if not validDepth(
        targetY
    ) then

        return false

    end


    local stalled =
        0


    while isRunning(run) do


        --------------------------------------------------
        -- MODEL
        --------------------------------------------------

        local model =
            ModelsByName[
                name
            ]


        if not model
            or not model.Parent then


            local folder =
                MiningServiceClient.mineFolder


            if folder then


                model =
                    folder:
                    FindFirstChild(
                        name
                    )

            end

        end


        --------------------------------------------------
        -- DATA
        --------------------------------------------------

        local data =
            getBlockDataByName(
                name
            )


        --------------------------------------------------
        -- DESTROYED
        --------------------------------------------------

        if not data
            or data[1] == "None"
            or not model
            or not model.Parent then


            BlockedTargets[
                name
            ] =
                nil


            return true

        end


        --------------------------------------------------
        -- MODE
        --------------------------------------------------

        if not modeAllows(
            name,
            mode
        ) then


            return false

        end


        --------------------------------------------------
        -- FOLLOW
        --------------------------------------------------

        moveNearTarget(
            model
        )


        --------------------------------------------------
        -- COOLDOWN
        --------------------------------------------------

        if not waitForCooldown(
            run
        ) then


            return false

        end


        --------------------------------------------------
        -- RECHECK DATA
        --------------------------------------------------

        data =
            getBlockDataByName(
                name
            )


        if not data
            or data[1] == "None" then


            return true

        end


        model =
            ModelsByName[
                name
            ]
            or model


        if not model
            or not model.Parent then


            return true

        end


        if not modeAllows(
            name,
            mode
        ) then


            return false

        end


        --------------------------------------------------
        -- BEFORE STATE
        --------------------------------------------------

        local before =
            getStateKey(
                name
            )


        --------------------------------------------------
        -- ORIGINAL DAMAGE
        --------------------------------------------------

        MiningServiceClient.currentBlock =
            model


        local success =
            pcall(function()


                MiningServiceClient:
                damageBlock()

            end)


        task.wait()


        --------------------------------------------------
        -- AFTER STATE
        --------------------------------------------------

        local afterData =
            getBlockDataByName(
                name
            )


        local afterModel =
            ModelsByName[
                name
            ]


        if not afterData
            or afterData[1] == "None"
            or not afterModel
            or not afterModel.Parent then


            return true

        end


        local after =
            getStateKey(
                name
            )


        --------------------------------------------------
        -- STALL
        --------------------------------------------------

        if not success
            or before == after then


            stalled =
                stalled + 1


        else


            stalled =
                0

        end


        if stalled
            >= STALL_LIMIT then


            BlockedTargets[
                name
            ] =
                true


            warn(
                "Ore Miner: skipping stalled block:",
                name
            )


            return false

        end

    end


    return false

end


--------------------------------------------------
-- FRONTIER TARGET
--------------------------------------------------

local function getFrontierTarget(
    anchorX,
    anchorZ
)

    local _,
        effectiveEnd =

        getEffectiveDepthRange()


    --------------------------------------------------
    -- DON'T USE BLOCKS BELOW END DEPTH
    --------------------------------------------------

    local y =
        deepestY(
            NonBedrockByY,
            nil,
            effectiveEnd
        )


    y =
        safeNumber(
            y
        )


    if y == nil then


        return
            nil,
            nil

    end


    local name =
        nil


    --------------------------------------------------
    -- PREFER STONE
    --------------------------------------------------

    local stoneBucket =
        StoneByY[
            y
        ]


    if stoneBucket
        and cleanBucket(
            stoneBucket
        ) then


        name =
            pickNearest(
                stoneBucket,
                anchorX,
                anchorZ
            )

    end


    --------------------------------------------------
    -- OTHERWISE ANY NON-BEDROCK
    --------------------------------------------------

    if not name then


        name =
            pickNearest(
                NonBedrockByY[
                    y
                ],
                anchorX,
                anchorZ
            )

    end


    return
        name,
        y

end


--------------------------------------------------
-- HIGHEST VALUE SELECTED ORE
--------------------------------------------------

local function getSelectedTarget(
    anchorX,
    anchorZ
)

    anchorX =
        safeNumber(
            anchorX
        )
        or DEFAULT_X


    anchorZ =
        safeNumber(
            anchorZ
        )
        or DEFAULT_Z


    local bestName =
        nil


    local bestValue =
        -math.huge


    local bestDistance =
        math.huge


    --------------------------------------------------
    -- ONLY ORES INSIDE FARM RANGE
    --------------------------------------------------

    for rawY,
        bucket in pairs(
            SelectedByY
        ) do


        local y =
            safeNumber(
                rawY
            )


        if y ~= nil
            and inFarmDepth(
                y
            ) then


            for name in pairs(
                bucket
            ) do


                if not BlockedTargets[
                    name
                ] then


                    local model =
                        ModelsByName[
                            name
                        ]


                    if model
                        and model.Parent then


                        local info =
                            getBlockInfoByName(
                                name
                            )


                        if info
                            and isSelectedOre(
                                info
                            ) then


                            --------------------------------------------------
                            -- VALUE
                            --------------------------------------------------

                            local value =
                                getComparableValue(
                                    info.Value
                                )


                            --------------------------------------------------
                            -- DISTANCE
                            --------------------------------------------------

                            local x,
                                _,
                                z =

                                getCoordinatesFromName(
                                    name
                                )


                            x =
                                safeNumber(
                                    x
                                )


                            z =
                                safeNumber(
                                    z
                                )


                            local distance =
                                math.huge


                            if x ~= nil
                                and z ~= nil then


                                local dx =
                                    x - anchorX


                                local dz =
                                    z - anchorZ


                                distance =
                                    dx * dx
                                    + dz * dz

                            end


                            --------------------------------------------------
                            -- HIGHER VALUE FIRST
                            --------------------------------------------------

                            if value
                                > bestValue then


                                bestValue =
                                    value


                                bestDistance =
                                    distance


                                bestName =
                                    name


                            elseif value
                                    == bestValue
                                and distance
                                    < bestDistance then


                                bestDistance =
                                    distance


                                bestName =
                                    name

                            end

                        end

                    end

                end

            end

        end

    end


    return
        bestName

end


--------------------------------------------------
-- RANGE SWEEP TARGET
--
-- THIS IS THE IMPORTANT PART FOR:
--
-- START -850
-- END   -850
--
-- It clears the whole loaded/revealed -850 layer
-- instead of stopping when depth is reached.
--------------------------------------------------

local function getRangeSweepTarget(
    anchorX,
    anchorZ
)

    anchorX =
        safeNumber(
            anchorX
        )
        or DEFAULT_X


    anchorZ =
        safeNumber(
            anchorZ
        )
        or DEFAULT_Z


    local effectiveStart,
        effectiveEnd =

        getEffectiveDepthRange()


    --------------------------------------------------
    -- CHOOSE HIGHEST Y INSIDE FARM RANGE
    --
    -- Example:
    --
    -- -500 to -503
    --
    -- clear:
    -- -500
    -- then -501
    -- then -502
    -- then -503
    --------------------------------------------------

    local selectedY =
        nil


    for rawY,
        bucket in pairs(
            NonBedrockByY
        ) do


        local y =
            safeNumber(
                rawY
            )


        if y ~= nil
            and validDepth(
                y
            )
            and y <= effectiveStart
            and y >= effectiveEnd
            and cleanBucket(
                bucket
            ) then


            local candidate =
                pickNearest(
                    bucket,
                    anchorX,
                    anchorZ
                )


            if candidate then


                --------------------------------------------------
                -- HIGHER LEVEL FIRST
                --
                -- -500 > -501
                --------------------------------------------------

                if selectedY == nil
                    or y > selectedY then


                    selectedY =
                        y

                end

            end

        end

    end


    if selectedY == nil then


        return
            nil,
            nil

    end


    --------------------------------------------------
    -- NEAREST BLOCK ON CURRENT SWEEP LEVEL
    --------------------------------------------------

    local target =
        pickNearest(
            NonBedrockByY[
                selectedY
            ],
            anchorX,
            anchorZ
        )


    return
        target,
        selectedY

end



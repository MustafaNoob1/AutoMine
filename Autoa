        restartActiveMiner()
    end)
end)

--------------------------------------------------
-- AUTO RESUME / WATCHDOG
--------------------------------------------------
local function scheduleAutoResume(reason)
    if not AUTO_RESUME or not AutoMine or AutoResumePending or IsResetting then
        return
    end

    AutoResumePending = true
    task.delay(1, function()
        AutoResumePending = false

        if AUTO_RESUME and AutoMine and not IsResetting then
            Stats.Status = "Auto resume: " .. tostring(reason or "resume")
            restartActiveMiner()
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(function()
    scheduleAutoResume("respawn")
end)

LastObservedMineFolder = MiningServiceClient.mineFolder

--------------------------------------------------
-- LIVE STATS / STOP WATCHER
--------------------------------------------------
task.spawn(function()
    while true do
        task.wait(0.5)

        if updateStatsDisplay then
            updateStatsDisplay()
        end

        if updateProgressDisplay then
            updateProgressDisplay()
        end

        if AutoMine then
            checkStopConditions()

            local currentFolder = MiningServiceClient.mineFolder
            if currentFolder ~= LastObservedMineFolder then
                LastObservedMineFolder = currentFolder
                scheduleAutoResume("mine recreated")
            end
        else
            LastObservedMineFolder = MiningServiceClient.mineFolder
        end
    end
end)


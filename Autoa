local function waitForMine(run)

    while isRunning(run) do


        if MiningServiceClient.mineFolder
            and MiningServiceClient.blocks then


            if setupIndex() then


                rescanMine()


                return true

            end

        end


        task.wait(
            0.1
        )

    end


    return false

end


--------------------------------------------------
-- REACH START DEPTH
--------------------------------------------------

local function reachStartDepth(run)

    local anchorX,
        anchorZ =

        getPlayerGridPosition()


    local effectiveStart,
        effectiveEnd =

        getEffectiveDepthRange()


    --------------------------------------------------
    -- RANK LIMIT INFORMATION
    --------------------------------------------------

    if START_DEPTH
        < RANK_MAX_DEPTH
        or END_DEPTH
        < RANK_MAX_DEPTH then


        Fluent:Notify({

            Title =
                "Rank Depth Limit",

            Content =
                "Effective range: "
                .. tostring(
                    effectiveStart
                )
                .. " to "
                .. tostring(
                    effectiveEnd
                ),

            Duration =
                4

        })

    end


    Fluent:Notify({

        Title =
            "Depth Loader",

        Content =
            "Going to "
            .. tostring(
                effectiveStart
            ),

        Duration =
            2

    })


    while isRunning(run) do


        --------------------------------------------------
        -- REFRESH
        --------------------------------------------------

        rescanMine()


        --------------------------------------------------
        -- DEEPEST LOADED BLOCK THAT IS STILL
        -- INSIDE OUR ALLOWED END RANGE
        --------------------------------------------------

        local currentDeepest =
            deepestY(
                NonBedrockByY,
                nil,
                effectiveEnd
            )


        currentDeepest =
            safeNumber(
                currentDeepest
            )


        if currentDeepest == nil then


            task.wait(
                0.05
            )


            continue

        end


        --------------------------------------------------
        -- START REACHED
        --------------------------------------------------

        if currentDeepest
            <= effectiveStart then


            Fluent:Notify({

                Title =
                    "Farm Range reached",

                Content =
                    tostring(
                        effectiveStart
                    )
                    .. " to "
                    .. tostring(
                        effectiveEnd
                    ),

                Duration =
                    3

            })


            return
                true,
                anchorX,
                anchorZ

        end


        --------------------------------------------------
        -- FRONTIER
        --------------------------------------------------

        local target,
            targetY =

            getFrontierTarget(
                anchorX,
                anchorZ
            )


        targetY =
            safeNumber(
                targetY
            )


        if not target
            or targetY == nil then


            task.wait(
                0.05
            )


            continue

        end


        --------------------------------------------------
        -- DON'T GO BELOW END
        --------------------------------------------------

        if targetY
            < effectiveEnd then


            BlockedTargets[target] =
                true


            task.wait()


            continue

        end


        --------------------------------------------------
        -- RANK
        --------------------------------------------------

        if not validDepth(
            targetY
        ) then


            BlockedTargets[target] =
                true


            task.wait()


            continue

        end


        --------------------------------------------------
        -- ANCHOR
        --------------------------------------------------

        local x,
            _,
            z =

            getCoordinatesFromName(
                target
            )


        x =
            safeNumber(x)


        z =
            safeNumber(z)


        if x ~= nil then

            anchorX =
                x

        end


        if z ~= nil then

            anchorZ =
                z

        end


        --------------------------------------------------
        -- MINE PATH
        --------------------------------------------------

        mineTarget(
            target,
            "any",
            run
        )


        task.wait()


        rescanMine()

    end


    return false

end


--------------------------------------------------
-- FARM LOOP
--------------------------------------------------

local function farmingLoop(
    run,
    anchorX,
    anchorZ
)

    local counter =
        0


    while isRunning(run) do


        local effectiveStart,
            effectiveEnd =

            getEffectiveDepthRange()


        --------------------------------------------------
        -- PRIORITY 1:
        -- HIGHEST VALUE SELECTED ORE
        --------------------------------------------------

        local target =
            getSelectedTarget(
                anchorX,
                anchorZ
            )


        if target then


            local x,
                _,
                z =

                getCoordinatesFromName(
                    target
                )


            x =
                safeNumber(x)


            z =
                safeNumber(z)


            if x ~= nil then

                anchorX =
                    x

            end


            if z ~= nil then

                anchorZ =
                    z

            end


            mineTarget(
                target,
                "selected",
                run
            )


        else


            --------------------------------------------------
            -- PRIORITY 2:
            -- OPEN PATH UNTIL END DEPTH
            --------------------------------------------------

            local frontier,
                frontierY =

                getFrontierTarget(
                    anchorX,
                    anchorZ
                )


            frontierY =
                safeNumber(
                    frontierY
                )


            --------------------------------------------------
            -- IMPORTANT:
            --
            -- Start -500
            -- End   -501
            --
            -- At -500 we may mine path to reveal -501.
            --
            -- At -501 we DO NOT continue toward -502.
            --------------------------------------------------

            if frontier
                and frontierY ~= nil
                and validDepth(
                    frontierY
                )
                and frontierY
                    > effectiveEnd then


                local x,
                    _,
                    z =

                    getCoordinatesFromName(
                        frontier
                    )


                x =
                    safeNumber(x)


                z =
                    safeNumber(z)


                if x ~= nil then

                    anchorX =
                        x

                end


                if z ~= nil then

                    anchorZ =
                        z

                end


                mineTarget(
                    frontier,
                    "any",
                    run
                )


            else


                --------------------------------------------------
                -- END DEPTH REACHED
                --
                -- Wait for selected ores in the range.
                --------------------------------------------------

                task.wait(
                    0.1
                )

            end

        end


        --------------------------------------------------
        -- REFRESH
        --------------------------------------------------

        counter =
            counter + 1


        if counter % 25
            == 0 then


            rescanMine()


            rebuildSelectedIndex()

        end

    end

end


--------------------------------------------------
-- START MINING
--------------------------------------------------

local function startMining(run)

    task.spawn(function()


        --------------------------------------------------
        -- RANK
        --------------------------------------------------

        refreshRankDepth()


        --------------------------------------------------
        -- RESET FAILURES
        --------------------------------------------------

        BlockedTargets =
            {}


        --------------------------------------------------
        -- WAIT FOR MINE
        --------------------------------------------------

        if not waitForMine(
            run
        ) then

            return

        end


        --------------------------------------------------
        -- CURRENT RANK INDEX
        --------------------------------------------------

        rebuildWholeIndex()


        rebuildSelectedIndex()


        --------------------------------------------------
        -- PHASE 1
        --------------------------------------------------

        local reached,
            anchorX,
            anchorZ =

            reachStartDepth(
                run
            )


        if not reached
            or not isRunning(
                run
            ) then


            return

        end


        --------------------------------------------------
        -- REFRESH
        --------------------------------------------------

        rescanMine()


        rebuildSelectedIndex()


        --------------------------------------------------
        -- PHASE 2
        --------------------------------------------------

        farmingLoop(
            run,
            anchorX,
            anchorZ
        )

    end)

end



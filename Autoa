--------------------------------------------------
-- TOGGLE
--------------------------------------------------

Toggle:OnChanged(
    function(value)


        RunId =
            RunId + 1


        AutoMine =
            value


        if AutoMine then


            local run =
                RunId


            Fluent:Notify({

                Title =
                    "Auto Mine",

                Content =
                    "Target depth: "
                    .. tostring(
                        START_DEPTH
                    ),

                Duration =
                    2

            })


            startMining(
                run
            )


        else


            Fluent:Notify({

                Title =
                    "Auto Mine",

                Content =
                    "Stopped.",

                Duration =
                    2

            })

        end

    end
)



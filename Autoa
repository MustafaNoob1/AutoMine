local function requestStop(reason)
    if not AutoMine then
        return
    end

    AutoMine = false
    RunId = RunId + 1
    Stats.Status = "Stopped: " .. tostring(reason or "Stop condition")

    if AutoMineToggle then
        InternalToggleChange = true
        pcall(function()
            AutoMineToggle:SetValue(false)
        end)
        InternalToggleChange = false
    end

    Fluent:Notify({
        Title = "Auto Mine Stopped",
        Content = tostring(reason or "Stop condition reached"),
        Duration = 5
    })
end

local function checkStopConditions()
    if not AutoMine then
        return false
    end

    if STOP_AFTER_MINUTES_ENABLED and Stats.StartTime then
        local minutes = (os.clock() - Stats.StartTime) / 60
        if minutes >= STOP_AFTER_MINUTES then
            requestStop("Time limit reached (" .. tostring(STOP_AFTER_MINUTES) .. " min)")
            return true
        end
    end

    if STOP_AFTER_ORES_ENABLED and Stats.OresMined >= STOP_AFTER_ORES then
        requestStop("Ore limit reached (" .. tostring(STOP_AFTER_ORES) .. ")")
        return true
    end

    if STOP_AFTER_VALUE_ENABLED and Stats.EstimatedValue >= STOP_AFTER_VALUE then
        requestStop("Value limit reached (" .. formatNumber(STOP_AFTER_VALUE) .. ")")
        return true
    end

    return false
end

local function maybeAlertRare(name, info, y)
    if not RARE_ALERT_ENABLED or not info or not inFarmDepth(y) then
        return
    end

    if AlertedRareBlocks[name] or not isRareOre(info, y) then
        return
    end

    AlertedRareBlocks[name] = true
    Stats.RareFound = Stats.RareFound + 1

    local weight = getRarityWeight(info.Id, y)

    Fluent:Notify({
        Title = "RARE ORE FOUND",
        Content = tostring(info.Name or info.Id)
            .. " | Y " .. tostring(y)
            .. " | Weight " .. tostring(weight),
        Duration = 6
    })

    if STOP_ON_RARE_ENABLED then
        task.defer(function()
            requestStop("Rare ore found: " .. tostring(info.Name or info.Id))
        end)
    end
end


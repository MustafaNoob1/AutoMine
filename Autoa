local function getCoordinatesFromName(name)
    if name == nil then
        return nil, nil, nil
    end

    name = tostring(name)

    local success, x, y, z = pcall(function()
        return MiningInfo:getCoordinatesFromBlockName(name)
    end)

    if success then
        x = safeNumber(x)
        y = safeNumber(y)
        z = safeNumber(z)
        if x ~= nil and y ~= nil and z ~= nil then
            return x, y, z
        end
    end

    local sx, sy, sz = name:match("^(-?%d+)_(-?%d+)_(-?%d+)$")
    return safeNumber(sx), safeNumber(sy), safeNumber(sz)
end

local function getBlockDataByName(name)
    if name == nil or not MiningServiceClient.blocks then
        return nil
    end
    return MiningServiceClient.blocks[tostring(name)]
end

local function getBlockInfoByName(name)
    local data = getBlockDataByName(name)
    if not data then
        return nil
    end

    local id = data[1]
    if id == nil or id == "None" then
        return nil
    end

    local success, info = pcall(function()
        return MiningInfo:getBlock(id)
    end)

    if not success or not info then
        return nil
    end

    return {
        Id = id,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }
end

local function isStone(info)
    if not info then
        return false
    end
    return tostring(info.Id):match("^StoneOre%d*$") ~= nil
end

local function isBedrock(info)
    return info ~= nil and tostring(info.Id) == "Bedrock"
end

local function isRealOreId(id)
    id = tostring(id or "")
    return id:match("Ore$") ~= nil and id:match("^StoneOre%d*$") == nil
end


local RunId =
    0


local function isRunning(id)

    return
        AutoMine == true
        and id == RunId

end


--------------------------------------------------
-- SAFE NUMBER
--------------------------------------------------

local function safeNumber(value)

    if value == nil then
        return nil
    end

    return tonumber(value)

end


--------------------------------------------------
-- SAFE BLOCK COORDINATES
--------------------------------------------------

local function getCoordinatesFromName(name)

    if name == nil then
        return nil, nil, nil
    end


    name =
        tostring(name)


    --------------------------------------------------
    -- TRY GAME FUNCTION FIRST
    --------------------------------------------------

    local success,
        x,
        y,
        z =

        pcall(function()

            return
                MiningInfo:
                getCoordinatesFromBlockName(
                    name
                )

        end)


    if success then

        x = safeNumber(x)
        y = safeNumber(y)
        z = safeNumber(z)


        if x ~= nil
            and y ~= nil
            and z ~= nil then


            return
                x,
                y,
                z

        end

    end


    --------------------------------------------------
    -- FALLBACK:
    -- DIRECTLY READ X_Y_Z
    --------------------------------------------------

    local sx,
        sy,
        sz =

        string.match(
            name,
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )


    return
        safeNumber(sx),
        safeNumber(sy),
        safeNumber(sz)

end


--------------------------------------------------
-- SAFE BLOCK Y
--------------------------------------------------

local function getBlockY(block)

    if not block then
        return nil
    end


    local _,
        y,
        _ =

        getCoordinatesFromName(
            block.Name
        )


    return safeNumber(y)

end


--------------------------------------------------
-- VALID WORLD DEPTH
--------------------------------------------------

local function validDepth(y)

    y =
        safeNumber(y)


    local minimum =
        safeNumber(
            MIN_DEPTH
        )
        or -4999


    if y == nil then
        return false
    end


    return
        y <= 0
        and y >= minimum

end


--------------------------------------------------
-- FARM DEPTH
--------------------------------------------------

local function inFarmDepth(y)

    y =
        safeNumber(y)


    local startDepth =
        safeNumber(
            START_DEPTH
        )
        or 0


    local minimum =
        safeNumber(
            MIN_DEPTH
        )
        or -4999


    if y == nil then
        return false
    end


    return
        y <= startDepth
        and y >= minimum

end



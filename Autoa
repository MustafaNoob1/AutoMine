--------------------------------------------------
-- START DEPTH INPUT
--------------------------------------------------

Tabs.Main:AddInput(
    "StartDepth",
    {

        Title =
            "Start Depth",

        Description =
            "Loader goes down before full mining starts.",

        Default =
            "0",

        Placeholder =
            "-3000",

        Numeric =
            false,

        Finished =
            true,

        Callback =
            function(Value)


                --------------------------------------------------
                -- NUMBER
                --------------------------------------------------

                local number =
                    tonumber(
                        Value
                    )


                if number == nil then


                    Fluent:Notify({

                        Title =
                            "Start Depth",

                        Content =
                            "Enter something like -3000.",

                        Duration =
                            3

                    })


                    return

                end


                --------------------------------------------------
                -- INTEGER
                --------------------------------------------------

                number =
                    math.round(
                        number
                    )


                --------------------------------------------------
                -- LIMIT
                --------------------------------------------------

                number =
                    math.clamp(
                        number,
                        MIN_DEPTH,
                        0
                    )


                --------------------------------------------------
                -- SAVE
                --------------------------------------------------

                START_DEPTH =
                    number


                rebuildSelectedOreCache()


                --------------------------------------------------
                -- NOTIFY
                --------------------------------------------------

                Fluent:Notify({

                    Title =
                        "Start Depth",

                    Content =
                        "Target depth: Y = "
                        .. tostring(
                            START_DEPTH
                        ),

                    Duration =
                        3

                })


                --------------------------------------------------
                -- RESTART RUN IF ACTIVE
                --------------------------------------------------

                if AutoMine then


                    MiningRunId =
                        MiningRunId + 1


                    local runId =
                        MiningRunId


                    startMining(
                        runId
                    )

                end

            end

    }
)



Tabs.Main:AddInput(
    "DamageBurst",
    {

        Title =
            "Hits Per Cycle",

        Description =
            "Higher = more damage calls per tick.",

        Default =
            tostring(
                DAMAGE_BURST
            ),

        Placeholder =
            "10",

        Numeric =
            true,

        Finished =
            true,

        Callback =
            function(value)


                local number =
                    tonumber(value)


                if not number then
                    return
                end


                DAMAGE_BURST =
                    math.clamp(
                        math.floor(number),
                        1,
                        50
                    )


                Fluent:Notify({

                    Title =
                        "Mining Speed",

                    Content =
                        "Hits Per Cycle = "
                        .. tostring(
                            DAMAGE_BURST
                        ),

                    Duration =
                        2

                })

            end

    }
)



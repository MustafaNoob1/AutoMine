--------------------------------------------------
-- BUCKET ADD
--------------------------------------------------

local function addToBucket(
    map,
    y,
    name
)

    y = safeNumber(y)

    if y == nil then
        return
    end

    if not map[y] then
        map[y] = {}
    end

    map[y][name] = true

end


--------------------------------------------------
-- BUCKET REMOVE
--------------------------------------------------

local function removeFromBucket(
    map,
    y,
    name
)

    y = safeNumber(y)

    if y == nil
        or not map[y] then

        return

    end

    map[y][name] = nil

    if next(map[y]) == nil then
        map[y] = nil
    end

end


--------------------------------------------------
-- REMOVE INDEXED NAME
--------------------------------------------------

local function removeIndexedName(name)

    local y =
        safeNumber(
            YByName[name]
        )

    removeFromBucket(
        NonBedrockByY,
        y,
        name
    )

    removeFromBucket(
        StoneByY,
        y,
        name
    )

    removeFromBucket(
        SelectedByY,
        y,
        name
    )

    ModelsByName[name] = nil

    YByName[name] = nil

end


--------------------------------------------------
-- REGISTER BLOCK
--------------------------------------------------

local function registerBlock(block)

    if not block
        or not block.Parent then

        return

    end


    local name =
        tostring(block.Name)


    --------------------------------------------------
    -- REPLACEBLOCK:
    -- new model can appear before blocks[name]
    -- contains the new block data.
    --------------------------------------------------

    if ModelsByName[name]
        and ModelsByName[name] ~= block then

        task.wait()

    end


    --------------------------------------------------
    -- WAIT FOR BLOCK DATA
    --------------------------------------------------

    local data =
        getBlockDataByName(name)

    if not data then

        for i = 1, 10 do

            task.wait()

            data =
                getBlockDataByName(name)

            if data then
                break
            end

        end

    end

    if not data then
        return
    end


    --------------------------------------------------
    -- COORDINATES
    --------------------------------------------------

    local x, y, z =
        getCoordinatesFromName(name)

    x = safeNumber(x)
    y = safeNumber(y)
    z = safeNumber(z)

    if not validDepth(y) then
        return
    end


    --------------------------------------------------
    -- INFO
    --------------------------------------------------

    local info =
        getBlockInfoByName(name)

    if not info then
        return
    end


    --------------------------------------------------
    -- REMOVE OLD CLASSIFICATION
    --------------------------------------------------

    if ModelsByName[name] then

        removeIndexedName(name)

    end


    --------------------------------------------------
    -- SAVE
    --------------------------------------------------

    ModelsByName[name] = block

    YByName[name] = y


    --------------------------------------------------
    -- NON BEDROCK
    --------------------------------------------------

    if not isBedrock(info) then

        addToBucket(
            NonBedrockByY,
            y,
            name
        )

    end


    --------------------------------------------------
    -- STONE
    --------------------------------------------------

    if isStone(info) then

        addToBucket(
            StoneByY,
            y,
            name
        )

    end


    --------------------------------------------------
    -- SELECTED ORE
    --------------------------------------------------

    if isSelectedOre(info) then

        addToBucket(
            SelectedByY,
            y,
            name
        )

    end

end


--------------------------------------------------
-- UNREGISTER BLOCK
--------------------------------------------------

local function unregisterBlock(block)

    if not block then
        return
    end


    local name =
        tostring(block.Name)


    --------------------------------------------------
    -- REPLACEMENT PROTECTION
    --------------------------------------------------

    if ModelsByName[name]
        ~= block then

        return

    end


    removeIndexedName(name)

end


--------------------------------------------------
-- CLEAR INDEX
--------------------------------------------------

local function clearIndex()

    ModelsByName = {}

    YByName = {}

    NonBedrockByY = {}

    StoneByY = {}

    SelectedByY = {}

end


--------------------------------------------------
-- DISCONNECT FOLDER
--------------------------------------------------

local function disconnectFolder()

    for _, connection in ipairs(
        FolderConnections
    ) do

        pcall(function()

            connection:Disconnect()

        end)

    end

    FolderConnections = {}

end


--------------------------------------------------
-- RESCAN MINE
--------------------------------------------------

local function rescanMine()

    local folder =
        MiningServiceClient.mineFolder

    if not folder then
        return false
    end


    for _, block in ipairs(
        folder:GetChildren()
    ) do

        if block
            and block.Parent then

            local name =
                tostring(block.Name)


            if ModelsByName[name]
                ~= block then

                registerBlock(block)

            end

        end

    end


    return true

end


--------------------------------------------------
-- SETUP INDEX
--------------------------------------------------

local function setupIndex()

    local folder =
        MiningServiceClient.mineFolder

    if not folder then
        return false
    end


    if IndexedFolder == folder then
        return true
    end


    disconnectFolder()

    clearIndex()

    IndexedFolder = folder

    rescanMine()


    --------------------------------------------------
    -- NEW BLOCK
    --------------------------------------------------

    table.insert(
        FolderConnections,

        folder.ChildAdded:Connect(
            function(block)

                task.defer(function()

                    registerBlock(block)

                end)

            end
        )
    )


    --------------------------------------------------
    -- REMOVED BLOCK
    --------------------------------------------------

    table.insert(
        FolderConnections,

        folder.ChildRemoved:Connect(
            function(block)

                unregisterBlock(block)

            end
        )
    )


    return true

end


--------------------------------------------------
-- REBUILD SELECTED INDEX
--------------------------------------------------

local function rebuildSelectedIndex()

    SelectedByY = {}


    for name, model in pairs(
        ModelsByName
    ) do

        if model
            and model.Parent then

            local y =
                safeNumber(
                    YByName[name]
                )

            local info =
                getBlockInfoByName(name)


            if y ~= nil
                and info
                and isSelectedOre(info) then

                addToBucket(
                    SelectedByY,
                    y,
                    name
                )

            end

        end

    end

end


--------------------------------------------------
-- CLEAN BUCKET
--------------------------------------------------

local function cleanBucket(bucket)

    if not bucket then
        return false
    end


    for name in pairs(bucket) do

        local model =
            ModelsByName[name]

        local data =
            getBlockDataByName(name)


        if not model
            or not model.Parent
            or not data
            or data[1] == "None" then

            bucket[name] = nil

        end

    end


    return
        next(bucket) ~= nil

end


--------------------------------------------------
-- DEEPEST ACCESSIBLE Y
--------------------------------------------------

local function deepestY(
    map,
    maxY
)

    maxY =
        safeNumber(maxY)


    local result =
        nil


    for rawY, bucket in pairs(map) do

        local y =
            safeNumber(rawY)


        if y ~= nil
            and isAccessibleDepth(y) then


            local allowed =
                true


            if maxY ~= nil then

                allowed =
                    y <= maxY

            end


            if allowed
                and cleanBucket(bucket) then


                local usable =
                    false


                for name in pairs(bucket) do

                    if not BlockedTargets[name] then

                        local model =
                            ModelsByName[name]

                        if model
                            and model.Parent then

                            usable = true

                            break

                        end

                    end

                end


                if usable then

                    if result == nil
                        or y < result then

                        result = y

                    end

                end

            end

        end

    end


    return result

end


--------------------------------------------------
-- PLAYER GRID POSITION
--------------------------------------------------

local function getPlayerGridPosition()

    local character =
        LocalPlayer.Character


    if not character then
        return DEFAULT_X, DEFAULT_Z
    end


    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )


    if not root then
        return DEFAULT_X, DEFAULT_Z
    end


    local origin =
        MiningServiceClient.originPosition


    if not origin then
        return DEFAULT_X, DEFAULT_Z
    end


    local x =
        (
            root.Position.X
            - origin.X
        ) / 6


    local z =
        (
            root.Position.Z
            - origin.Z
        ) / 6


    return
        math.round(x),
        math.round(z)

end


--------------------------------------------------
-- PICK NEAREST ACCESSIBLE BLOCK
--------------------------------------------------

local function pickNearest(
    bucket,
    targetX,
    targetZ
)

    if not bucket then
        return nil
    end


    targetX =
        safeNumber(targetX)
        or DEFAULT_X


    targetZ =
        safeNumber(targetZ)
        or DEFAULT_Z


    local bestName = nil

    local bestDistance =
        math.huge


    for name in pairs(bucket) do


        if not BlockedTargets[name] then


            local model =
                ModelsByName[name]


            local y =
                safeNumber(
                    YByName[name]
                )


            if model
                and model.Parent
                and isAccessibleDepth(y) then


                local x, _, z =
                    getCoordinatesFromName(name)


                x = safeNumber(x)

                z = safeNumber(z)


                if x ~= nil
                    and z ~= nil then


                    local dx =
                        x - targetX

                    local dz =
                        z - targetZ


                    local distance =
                        dx * dx
                        + dz * dz


                    if distance < bestDistance then

                        bestDistance =
                            distance

                        bestName =
                            name

                    end

                end

            end

        end

    end


    return bestName

end


--------------------------------------------------
-- MODEL POSITION
--------------------------------------------------

local function getModelPosition(model)

    if not model then
        return nil
    end


    if model:IsA("BasePart") then

        return model.Position

    end


    local success, pivot =
        pcall(function()

            return model:GetPivot()

        end)


    if success
        and pivot then

        return pivot.Position

    end


    return nil

end


--------------------------------------------------
-- MOVE NEAR TARGET
--------------------------------------------------

local function moveNearTarget(model)

    if not FOLLOW_TARGET then
        return true
    end


    if not model
        or not model.Parent then

        return false

    end


    local character =
        LocalPlayer.Character


    if not character then
        return false
    end


    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )


    if not root then
        return false
    end


    local targetPosition =
        getModelPosition(model)


    if not targetPosition then
        return false
    end


    --------------------------------------------------
    -- ALREADY CLOSE
    --------------------------------------------------

    local distance =
        (
            root.Position
            - targetPosition
        ).Magnitude


    if distance <= TARGET_DISTANCE then
        return true
    end


    --------------------------------------------------
    -- MOVE ABOVE BLOCK
    --------------------------------------------------

    local destination =
        targetPosition
        + Vector3.new(
            0,
            8,
            0
        )


    local look =
        root.CFrame.LookVector


    local success =
        pcall(function()

            character:PivotTo(
                CFrame.new(
                    destination,
                    destination + look
                )
            )

            root.AssemblyLinearVelocity =
                Vector3.zero

            root.AssemblyAngularVelocity =
                Vector3.zero

        end)


    task.wait()


    return success

end


--------------------------------------------------
-- GET MINING SPEED
--------------------------------------------------

local function getMiningSpeed()

    local success, value =
        pcall(function()

            return
                DataClient:get({
                    "Boosts",
                    "Mining_Speed"
                })

        end)


    if not success then
        return 0
    end


    local number =
        safeNumber(value)


    if number == nil then
        return 0
    end


    return
        math.max(
            number,
            0
        )

end


--------------------------------------------------
-- WAIT FOR REAL COOLDOWN
--------------------------------------------------

local function waitForCooldown(run)

    while isRunning(run) do


        local last =
            MiningServiceClient.damageCooldown


        if last == nil then
            return true
        end


        --------------------------------------------------
        -- REQUEST CURRENTLY ACTIVE
        --------------------------------------------------

        if last == math.huge then

            task.wait()

            continue

        end


        last =
            safeNumber(last)


        if last == nil then

            task.wait()

            return true

        end


        local speed =
            getMiningSpeed()


        local elapsed =
            workspace:GetServerTimeNow()
            - last


        local remaining =
            speed
            - elapsed


        if remaining <= 0 then
            return true
        end


        task.wait(
            math.min(
                remaining,
                0.05
            )
        )

    end


    return false

end


--------------------------------------------------
-- BLOCK STATE
--------------------------------------------------

local function getStateKey(name)

    local data =
        getBlockDataByName(name)


    if not data then
        return "NONE"
    end


    return
        tostring(data[1])
        .. "|"
        .. tostring(data[2])

end


--------------------------------------------------
-- MODE CHECK
--------------------------------------------------

local function modeAllows(
    name,
    mode
)

    local y =
        safeNumber(
            YByName[name]
        )


    if not isAccessibleDepth(y) then
        return false
    end


    local info =
        getBlockInfoByName(name)


    if not info then
        return false
    end


    if isBedrock(info) then
        return false
    end


    if mode == "selected" then

        return
            isSelectedOre(info)

    end


    if mode == "stone" then

        return
            isStone(info)

    end


    return true

end


--------------------------------------------------
-- REGISTER SERVER REJECTION
--------------------------------------------------

local function registerRejectedTarget(
    name,
    y
)

    y = safeNumber(y)


    if y == nil then
        return false
    end


    BlockedTargets[name] =
        true


    if not RejectedByDepth[y] then

        RejectedByDepth[y] =
            {}

    end


    RejectedByDepth[y][name] =
        true


    --------------------------------------------------
    -- COUNT UNIQUE REJECTED BLOCKS
    --------------------------------------------------

    local count = 0


    for _ in pairs(
        RejectedByDepth[y]
    ) do

        count =
            count + 1

    end


    --------------------------------------------------
    -- CONFIRM LOCKED LAYER
    --------------------------------------------------

    if count >= LOCK_CONFIRM_TARGETS then


        if LockedDepth == nil
            or y > LockedDepth then

            LockedDepth =
                y

        end


        return true

    end


    return false

end


--------------------------------------------------
-- MINE TARGET
--------------------------------------------------

local function mineTarget(
    name,
    mode,
    run
)

    if name == nil then
        return false, "invalid"
    end


    name =
        tostring(name)


    if BlockedTargets[name] then
        return false, "blocked"
    end


    local targetY =
        safeNumber(
            YByName[name]
        )


    if not isAccessibleDepth(
        targetY
    ) then

        return false, "locked"

    end


    local stalled = 0


    while isRunning(run) do


        --------------------------------------------------
        -- MODEL
        --------------------------------------------------

        local model =
            ModelsByName[name]


        if not model
            or not model.Parent then


            local folder =
                MiningServiceClient.mineFolder


            if folder then

                model =
                    folder:FindFirstChild(
                        name
                    )

            end

        end


        --------------------------------------------------
        -- DATA
        --------------------------------------------------

        local data =
            getBlockDataByName(name)


        --------------------------------------------------
        -- DESTROYED
        --------------------------------------------------

        if not data
            or data[1] == "None"
            or not model
            or not model.Parent then

            BlockedTargets[name] =
                nil

            return true, "destroyed"

        end


        --------------------------------------------------
        -- ALLOWED?
        --------------------------------------------------

        if not modeAllows(
            name,
            mode
        ) then

            return false, "wrong_type"

        end


        --------------------------------------------------
        -- STAY CLOSE
        --------------------------------------------------

        moveNearTarget(model)


        --------------------------------------------------
        -- WAIT COOLDOWN
        --------------------------------------------------

        if not waitForCooldown(run) then

            return false, "stopped"

        end


        --------------------------------------------------
        -- RECHECK
        --------------------------------------------------

        data =
            getBlockDataByName(name)


        if not data
            or data[1] == "None" then

            return true, "destroyed"

        end


        model =
            ModelsByName[name]
            or model


        if not model
            or not model.Parent then

            return true, "destroyed"

        end


        if not modeAllows(
            name,
            mode
        ) then

            return false, "wrong_type"

        end


        --------------------------------------------------
        -- BEFORE STATE
        --------------------------------------------------

        local before =
            getStateKey(name)


        --------------------------------------------------
        -- SET TARGET
        --------------------------------------------------

        MiningServiceClient.currentBlock =
            model


        --------------------------------------------------
        -- GAME'S ORIGINAL DAMAGE
        --------------------------------------------------

        local success, err =
            pcall(function()

                MiningServiceClient:
                    damageBlock()

            end)


        --------------------------------------------------
        -- SERVER UPDATE FRAME
        --------------------------------------------------

        task.wait()


        --------------------------------------------------
        -- AFTER
        --------------------------------------------------

        local afterData =
            getBlockDataByName(name)


        local afterModel =
            ModelsByName[name]


        --------------------------------------------------
        -- DESTROYED
        --------------------------------------------------

        if not afterData
            or afterData[1] == "None"
            or not afterModel
            or not afterModel.Parent then

            return true, "destroyed"

        end


        local after =
            getStateKey(name)


        --------------------------------------------------
        -- STALL
        --------------------------------------------------

        if not success
            or before == after then

            stalled =
                stalled + 1

        else

            stalled = 0

        end


        --------------------------------------------------
        -- SERVER KEEPS REJECTING
        --------------------------------------------------

        if stalled >= LOCK_STALL_LIMIT then


            local locked =
                registerRejectedTarget(
                    name,
                    targetY
                )


            warn(
                "Ore Miner: target rejected:",
                name,
                "Y:",
                targetY,
                err
            )


            if locked then

                return false, "layer_locked"

            end


            return false, "rejected"

        end

    end


    return false, "stopped"

end


--------------------------------------------------
-- FRONTIER TARGET
--------------------------------------------------

local function getFrontierTarget(
    anchorX,
    anchorZ
)

    local y =
        deepestY(
            NonBedrockByY,
            nil
        )


    y = safeNumber(y)


    if y == nil then
        return nil, nil
    end


    --------------------------------------------------
    -- PREFER STONE
    --------------------------------------------------

    local name = nil


    local stoneBucket =
        StoneByY[y]


    if stoneBucket
        and cleanBucket(
            stoneBucket
        ) then

        name =
            pickNearest(
                stoneBucket,
                anchorX,
                anchorZ
            )

    end


    --------------------------------------------------
    -- OTHERWISE ANY NON-BEDROCK
    --------------------------------------------------

    if not name then

        name =
            pickNearest(
                NonBedrockByY[y],
                anchorX,
                anchorZ
            )

    end


    return name, y

end


--------------------------------------------------
-- MOST VALUABLE SELECTED ORE
--------------------------------------------------

local function getSelectedTarget(
    anchorX,
    anchorZ
)

    anchorX =
        safeNumber(anchorX)
        or DEFAULT_X


    anchorZ =
        safeNumber(anchorZ)
        or DEFAULT_Z


    local bestName = nil

    local bestValue =
        -math.huge

    local bestDistance =
        math.huge


    --------------------------------------------------
    -- CHECK ALL SELECTED ORES
    --------------------------------------------------

    for rawY, bucket in pairs(
        SelectedByY
    ) do


        local y =
            safeNumber(rawY)


        if y ~= nil
            and inFarmDepth(y) then


            for name in pairs(bucket) do


                if not BlockedTargets[name] then


                    local model =
                        ModelsByName[name]


                    if model
                        and model.Parent then


                        local info =
                            getBlockInfoByName(
                                name
                            )


                        if info
                            and isSelectedOre(info) then


                            --------------------------------------------------
                            -- VALUE
                            --------------------------------------------------

                            local value =
                                getComparableValue(
                                    info.Value
                                )


                            --------------------------------------------------
                            -- DISTANCE TIE BREAKER
                            --------------------------------------------------

                            local x, _, z =
                                getCoordinatesFromName(
                                    name
                                )


                            x =
                                safeNumber(x)

                            z =
                                safeNumber(z)


                            local distance =
                                math.huge


                            if x ~= nil
                                and z ~= nil then


                                local dx =
                                    x - anchorX

                                local dz =
                                    z - anchorZ


                                distance =
                                    dx * dx
                                    + dz * dz

                            end


                            --------------------------------------------------
                            -- BIGGEST VALUE FIRST
                            --------------------------------------------------

                            if value > bestValue then


                                bestValue =
                                    value

                                bestDistance =
                                    distance

                                bestName =
                                    name


                            --------------------------------------------------
                            -- SAME VALUE -> CLOSER BLOCK
                            --------------------------------------------------

                            elseif value == bestValue
                                and distance < bestDistance then


                                bestDistance =
                                    distance

                                bestName =
                                    name

                            end

                        end

                    end

                end

            end

        end

    end


    return bestName

end


--------------------------------------------------
-- WAIT FOR MINE
--------------------------------------------------

local function waitForMine(run)

    while isRunning(run) do


        if setupIndex() then

            rescanMine()

            return true

        end


        task.wait(0.1)

    end


    return false

end


--------------------------------------------------
-- REACH START DEPTH
--------------------------------------------------

local function reachStartDepth(run)

    local anchorX, anchorZ =
        getPlayerGridPosition()


    local minedBlocks = 0


    Fluent:Notify({

        Title =
            "Depth Loader",

        Content =
            "Digging toward "
            .. tostring(
                START_DEPTH
            ),

        Duration =
            2

    })


    while isRunning(run) do


        --------------------------------------------------
        -- REQUESTED DEPTH IS LOCKED
        --------------------------------------------------

        if LockedDepth ~= nil
            and START_DEPTH <= LockedDepth then


            Fluent:Notify({

                Title =
                    "Layer Locked",

                Content =
                    "Cannot reach "
                    .. tostring(
                        START_DEPTH
                    )
                    .. ". Farming accessible ores above Y = "
                    .. tostring(
                        LockedDepth
                    )
                    .. ".",

                Duration =
                    5

            })


            return
                true,
                anchorX,
                anchorZ

        end


        --------------------------------------------------
        -- FOLDER RESET?
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then

            setupIndex()

        end


        rescanMine()


        --------------------------------------------------
        -- DEEPEST ACCESSIBLE
        --------------------------------------------------

        local currentDeepest =
            deepestY(
                NonBedrockByY,
                nil
            )


        currentDeepest =
            safeNumber(
                currentDeepest
            )


        if currentDeepest == nil then


            --------------------------------------------------
            -- COULD ALSO MEAN EVERYTHING DEEP IS LOCKED
            --------------------------------------------------

            if LockedDepth ~= nil then


                return
                    true,
                    anchorX,
                    anchorZ

            end


            task.wait(0.05)

            continue

        end


        --------------------------------------------------
        -- START DEPTH REACHED
        --------------------------------------------------

        if currentDeepest
            <= START_DEPTH then


            Fluent:Notify({

                Title =
                    "Start Depth reached",

                Content =
                    "Deepest loaded Y = "
                    .. tostring(
                        currentDeepest
                    ),

                Duration =
                    3

            })


            return
                true,
                anchorX,
                anchorZ

        end


        --------------------------------------------------
        -- FRONTIER
        --------------------------------------------------

        local target, targetY =
            getFrontierTarget(
                anchorX,
                anchorZ
            )


        targetY =
            safeNumber(
                targetY
            )


        if not target then


            --------------------------------------------------
            -- Maybe enough targets on frontier were rejected.
            --------------------------------------------------

            if targetY
                and RejectedByDepth[
                    targetY
                ] then


                local count = 0


                for _ in pairs(
                    RejectedByDepth[targetY]
                ) do

                    count =
                        count + 1

                end


                if count >=
                    LOCK_CONFIRM_TARGETS then


                    LockedDepth =
                        targetY


                    continue

                end

            end


            task.wait(0.05)

            continue

        end


        --------------------------------------------------
        -- UPDATE ANCHOR
        --------------------------------------------------

        local x, _, z =
            getCoordinatesFromName(
                target
            )


        x = safeNumber(x)

        z = safeNumber(z)


        if x ~= nil then
            anchorX = x
        end


        if z ~= nil then
            anchorZ = z
        end


        --------------------------------------------------
        -- MINE FRONTIER
        --------------------------------------------------

        local mined, reason =
            mineTarget(
                target,
                "any",
                run
            )


        --------------------------------------------------
        -- LOCKED LAYER CONFIRMED
        --------------------------------------------------

        if not mined
            and reason ==
                "layer_locked" then


            Fluent:Notify({

                Title =
                    "Layer Locked",

                Content =
                    "Locked at Y = "
                    .. tostring(
                        LockedDepth
                        or targetY
                    )
                    .. ". Farming accessible ores.",

                Duration =
                    5

            })


            return
                true,
                anchorX,
                anchorZ

        end


        --------------------------------------------------
        -- SERVER MAY HAVE CREATED NEW BLOCKS
        --------------------------------------------------

        task.wait()

        rescanMine()


        minedBlocks =
            minedBlocks + 1


        --------------------------------------------------
        -- STATUS
        --------------------------------------------------

        if minedBlocks % 100
            == 0 then


            local depth =
                deepestY(
                    NonBedrockByY,
                    nil
                )


            Fluent:Notify({

                Title =
                    "Depth Loader",

                Content =
                    "Current deepest Y = "
                    .. tostring(
                        depth or "?"
                    ),

                Duration =
                    2

            })

        end

    end


    return false

end


--------------------------------------------------
-- FARM LOOP
--------------------------------------------------

local function farmingLoop(
    run,
    anchorX,
    anchorZ
)

    local counter = 0


    while isRunning(run) do


        --------------------------------------------------
        -- RESET?
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then

            setupIndex()

            rebuildSelectedIndex()

        end


        --------------------------------------------------
        -- PRIORITY 1:
        -- HIGHEST VALUE SELECTED ORE
        --------------------------------------------------

        local target =
            getSelectedTarget(
                anchorX,
                anchorZ
            )


        if target then


            local x, _, z =
                getCoordinatesFromName(
                    target
                )


            x = safeNumber(x)

            z = safeNumber(z)


            if x ~= nil then
                anchorX = x
            end


            if z ~= nil then
                anchorZ = z
            end


            mineTarget(
                target,
                "selected",
                run
            )


        else


            --------------------------------------------------
            -- PRIORITY 2:
            -- OPEN DEEPEST ACCESSIBLE FRONTIER
            --------------------------------------------------

            local frontier, frontierY =
                getFrontierTarget(
                    anchorX,
                    anchorZ
                )


            frontierY =
                safeNumber(
                    frontierY
                )


            if frontier
                and frontierY ~= nil then


                --------------------------------------------------
                -- HARD LIMIT
                --------------------------------------------------

                if frontierY
                    <= MIN_DEPTH then


                    task.wait(0.1)

                    continue

                end


                --------------------------------------------------
                -- LOCK LIMIT
                --------------------------------------------------

                if LockedDepth ~= nil
                    and frontierY
                        <= LockedDepth then


                    BlockedTargets[
                        frontier
                    ] = true


                    task.wait()

                    continue

                end


                --------------------------------------------------
                -- UPDATE ANCHOR
                --------------------------------------------------

                local x, _, z =
                    getCoordinatesFromName(
                        frontier
                    )


                x = safeNumber(x)

                z = safeNumber(z)


                if x ~= nil then
                    anchorX = x
                end


                if z ~= nil then
                    anchorZ = z
                end


                --------------------------------------------------
                -- OPEN FRONTIER
                --------------------------------------------------

                mineTarget(
                    frontier,
                    "any",
                    run
                )


            else


                --------------------------------------------------
                -- No frontier is available.
                -- Just continue farming when something appears.
                --------------------------------------------------

                task.wait(0.1)

            end

        end


        --------------------------------------------------
        -- PERIODIC REFRESH
        --------------------------------------------------

        counter =
            counter + 1


        if counter % 25 == 0 then

            rescanMine()

            rebuildSelectedIndex()

        end

    end

end


--------------------------------------------------
-- START MINING
--------------------------------------------------

local function startMining(run)

    task.spawn(function()


        --------------------------------------------------
        -- WAIT FOR MINE
        --------------------------------------------------

        if not waitForMine(run) then
            return
        end


        rebuildSelectedIndex()


        --------------------------------------------------
        -- PHASE 1
        --------------------------------------------------

        local reached,
            anchorX,
            anchorZ =

            reachStartDepth(run)


        if not reached
            or not isRunning(run) then

            return

        end


        --------------------------------------------------
        -- REFRESH
        --------------------------------------------------

        rescanMine()

        rebuildSelectedIndex()


        --------------------------------------------------
        -- PHASE 2
        --------------------------------------------------

        farmingLoop(
            run,
            anchorX,
            anchorZ
        )

    end)

end



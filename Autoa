local function getModelPosition(model)

    if not model then
        return nil
    end


    if model:IsA(
        "BasePart"
    ) then


        return
            model.Position

    end


    local success,
        pivot =

        pcall(function()


            return
                model:GetPivot()

        end)


    if success
        and pivot then


        return
            pivot.Position

    end


    return nil

end


--------------------------------------------------
-- FOLLOW TARGET
--------------------------------------------------

local function moveNearTarget(model)

    if not FOLLOW_TARGET then
        return true
    end


    if not model
        or not model.Parent then

        return false

    end


    local character =
        LocalPlayer.Character


    if not character then
        return false
    end


    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )


    if not root then
        return false
    end


    local targetPosition =
        getModelPosition(
            model
        )


    if not targetPosition then
        return false
    end


    local distance =
        (
            root.Position
            - targetPosition
        ).Magnitude


    if distance
        <= TARGET_DISTANCE then


        return true

    end


    --------------------------------------------------
    -- MOVE ABOVE TARGET
    --------------------------------------------------

    local destination =
        targetPosition
        + Vector3.new(
            0,
            8,
            0
        )


    local look =
        root.CFrame.LookVector


    local success =
        pcall(function()


            character:PivotTo(

                CFrame.new(
                    destination,
                    destination + look
                )

            )


            root.AssemblyLinearVelocity =
                Vector3.zero


            root.AssemblyAngularVelocity =
                Vector3.zero

        end)


    task.wait()


    return success

end



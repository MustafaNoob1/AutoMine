--------------------------------------------------
-- WAIT COOLDOWN
--------------------------------------------------

local function waitForCooldown(run)

    while isRunning(run) do


        local last =
            MiningServiceClient.damageCooldown


        --------------------------------------------------
        -- READY
        --------------------------------------------------

        if last == nil then
            return true
        end


        --------------------------------------------------
        -- REQUEST RUNNING
        --------------------------------------------------

        if last == math.huge then


            task.wait()


            continue

        end


        last =
            safeNumber(
                last
            )


        if last == nil then


            task.wait()


            return true

        end


        local speed =
            getMiningSpeed()


        local elapsed =
            workspace:GetServerTimeNow()
            - last


        local remaining =
            speed
            - elapsed


        if remaining <= 0 then
            return true
        end


        task.wait(
            math.min(
                remaining,
                0.05
            )
        )

    end


    return false

end



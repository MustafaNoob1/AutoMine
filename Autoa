local function scheduleAutoResume(reason)
    if not AUTO_RESUME or not AutoMine or AutoResumePending or IsResetting then
        return
    end

    AutoResumePending = true
    task.delay(1, function()
        AutoResumePending = false

        if AUTO_RESUME and AutoMine and not IsResetting then
            Stats.Status = "Auto resume: " .. tostring(reason or "resume")
            restartActiveMiner()
        end
    end)
end


--------------------------------------------------
-- SAFE NUMBER
--------------------------------------------------

local function safeNumber(value)

    if value == nil then
        return nil
    end

    return tonumber(value)

end


--------------------------------------------------
-- CURRENT RANK
--------------------------------------------------

local function getCurrentRankIndex()

    local success,
        result =

        pcall(function()

            return DataClient:get({
                "Mining",
                "Rank"
            })

        end)


    if not success then
        return nil
    end


    return safeNumber(result)

end


--------------------------------------------------
-- RANK DEPTH INFO
--------------------------------------------------

local function getRankDepthInfo()

    local rankIndex =
        getCurrentRankIndex()


    if not rankIndex then
        return nil
    end


    --------------------------------------------------
    -- CURRENT RANK DATA
    --------------------------------------------------

    local success,
        rankInfo =

        pcall(function()

            return MiningInfo:getRank(
                rankIndex
            )

        end)


    if not success
        or not rankInfo then

        return nil

    end


    local unlockedLayers =
        safeNumber(
            rankInfo.layers
        )


    if not unlockedLayers then
        return nil
    end


    --------------------------------------------------
    -- LAYER DATA
    --------------------------------------------------

    local layers =
        MiningInfo._layers


    if not layers then
        return nil
    end


    --------------------------------------------------
    -- NEXT LOCKED LAYER
    --------------------------------------------------

    local nextLayer =
        layers[
            unlockedLayers + 1
        ]


    local maxDepth =
        MIN_DEPTH


    local nextBoundary =
        nil


    if nextLayer then


        local depth =
            safeNumber(
                nextLayer.depth
            )


        if depth then


            --------------------------------------------------
            -- Example:
            --
            -- Next layer starts at 150
            -- Current maximum = -149
            --------------------------------------------------

            maxDepth =
                -(depth - 1)


            nextBoundary =
                -depth

        end

    end


    --------------------------------------------------
    -- NEVER BELOW BEDROCK
    --------------------------------------------------

    maxDepth =
        math.max(
            MIN_DEPTH,
            maxDepth
        )


    return {

        RankIndex =
            rankIndex,

        Name =
            tostring(
                rankInfo.name
                or (
                    "Rank "
                    .. tostring(
                        rankIndex
                    )
                )
            ),

        Layers =
            unlockedLayers,

        MaxDepth =
            maxDepth,

        NextBoundary =
            nextBoundary

    }

end


--------------------------------------------------
-- REFRESH RANK
--------------------------------------------------

local function refreshRankDepth()

    local info =
        getRankDepthInfo()


    if not info then


        RANK_MAX_DEPTH =

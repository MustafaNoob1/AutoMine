--------------------------------------------------
-- SAFE NUMBER
--------------------------------------------------

local function safeNumber(value)

    if value == nil then
        return nil
    end

    return tonumber(value)

end


--------------------------------------------------
-- RESET LOCK DETECTION
--------------------------------------------------

local function resetLockDetection()

    LockedDepth = nil

    BlockedTargets = {}

    RejectedByDepth = {}

end


--------------------------------------------------
-- SAFE BLOCK COORDINATES
--------------------------------------------------

local function getCoordinatesFromName(name)

    if name == nil then
        return nil, nil, nil
    end

    name = tostring(name)


    --------------------------------------------------
    -- GAME FUNCTION
    --------------------------------------------------

    local success, x, y, z =
        pcall(function()

            return MiningInfo:
                getCoordinatesFromBlockName(name)

        end)

    if success then

        x = safeNumber(x)
        y = safeNumber(y)
        z = safeNumber(z)

        if x ~= nil
            and y ~= nil
            and z ~= nil then

            return x, y, z

        end

    end


    --------------------------------------------------
    -- FALLBACK
    --------------------------------------------------

    local sx, sy, sz =
        string.match(
            name,
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )

    return
        safeNumber(sx),
        safeNumber(sy),
        safeNumber(sz)

end


--------------------------------------------------
-- BLOCK Y
--------------------------------------------------

local function getBlockY(block)

    if not block then
        return nil
    end

    local _, y, _ =
        getCoordinatesFromName(
            block.Name
        )

    return safeNumber(y)

end


--------------------------------------------------
-- VALID DEPTH
--------------------------------------------------

local function validDepth(y)

    y = safeNumber(y)

    local minimum =
        safeNumber(MIN_DEPTH)
        or -4999

    if y == nil then
        return false
    end

    return
        y <= 0
        and y >= minimum

end


--------------------------------------------------
-- ACCESSIBLE DEPTH
--------------------------------------------------

local function isAccessibleDepth(y)

    y = safeNumber(y)

    if y == nil then
        return false
    end

    if not validDepth(y) then
        return false
    end

    --------------------------------------------------
    -- LOCKED DEPTH AND EVERYTHING BELOW IT
    --------------------------------------------------

    if LockedDepth ~= nil
        and y <= LockedDepth then

        return false

    end

    return true

end


--------------------------------------------------
-- FARM DEPTH
--------------------------------------------------

local function inFarmDepth(y)

    y = safeNumber(y)

    if y == nil then
        return false
    end

    if not isAccessibleDepth(y) then
        return false
    end


    --------------------------------------------------
    -- REQUESTED START DEPTH IS UNREACHABLE
    --
    -- Example:
    --
    -- START_DEPTH = -3000
    -- LockedDepth = -1000
    --
    -- Then farm everything accessible instead.
    --------------------------------------------------

    if LockedDepth ~= nil
        and START_DEPTH <= LockedDepth then

        return true

    end


    return
        y <= START_DEPTH

end


--------------------------------------------------
-- SELECTED ORES
--------------------------------------------------

local SelectedOres = {}


--------------------------------------------------
-- GET BLOCK DATA
--------------------------------------------------

local function getBlockDataByName(name)

    if name == nil then
        return nil
    end

    return
        MiningServiceClient.blocks[
            tostring(name)
        ]

end


--------------------------------------------------
-- GET BLOCK INFO
--------------------------------------------------

local function getBlockInfoByName(name)

    local data =
        getBlockDataByName(name)

    if not data then
        return nil
    end


    local id =
        data[1]

    if not id
        or id == "None" then

        return nil

    end


    local info =
        MiningInfo:getBlock(id)

    if not info then
        return nil
    end


    return {
        Id = id,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }

end


--------------------------------------------------
-- STONE
--------------------------------------------------

local function isStone(info)

    if not info then
        return false
    end

    return
        string.match(
            tostring(info.Id),
            "^StoneOre%d*$"
        ) ~= nil

end


--------------------------------------------------
-- BEDROCK
--------------------------------------------------

local function isBedrock(info)

    if not info then
        return false
    end

    return
        tostring(info.Id)
        == "Bedrock"

end


--------------------------------------------------
-- SELECTED ORE
--------------------------------------------------

local function isSelectedOre(info)

    if not info then
        return false
    end

    if isStone(info) then
        return false
    end

    if isBedrock(info) then
        return false
    end

    return
        SelectedOres[
            info.Id
        ] == true

end


--------------------------------------------------
-- VALUE CONVERSION
--------------------------------------------------

local function getComparableValue(value)

    if value == nil then
        return 0
    end


    --------------------------------------------------
    -- ETERNITY NUM
    --------------------------------------------------

    local success, result =
        pcall(function()

            return
                EternityNum.bnumtofloat(
                    value
                )

        end)

    if success then

        result =
            tonumber(result)

        if result ~= nil then
            return result
        end

    end


    --------------------------------------------------
    -- NORMAL NUMBER FALLBACK
    --------------------------------------------------

    local normal =
        tonumber(value)

    if normal ~= nil then
        return normal
    end


    return 0

end


--------------------------------------------------
-- ORE VALUE
--------------------------------------------------

local function getOreValue(name)

    local info =
        getBlockInfoByName(name)

    if not info then
        return 0
    end

    return
        getComparableValue(
            info.Value
        )

end



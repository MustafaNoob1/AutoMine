--------------------------------------------------
-- LOCKED LAYER SETTINGS
--------------------------------------------------

-- Sobald erkannt:
--
-- LockedDepth = -1000
--
-- bedeutet:
-- -999  = erlaubt
-- -1000 = gesperrt
-- -1001 = gesperrt
-- usw.

local LockedDepth = nil

-- Einzelne vom Server abgelehnte Targets.
local BlockedTargets = {}

-- Anzahl verschiedener abgelehnter Blocks
-- pro Y-Ebene.
local RejectedByDepth = {}

-- Wie oft EIN Block unverändert bleiben darf.
local LOCK_STALL_LIMIT = 6

-- Wie viele verschiedene Blocks auf derselben
-- tiefsten Ebene fehlschlagen müssen,
-- bevor die Ebene als Locked gilt.
local LOCK_CONFIRM_TARGETS = 3


--------------------------------------------------

--------------------------------------------------
local function safeNumber(value)
    if value == nil then
        return nil
    end
    return tonumber(value)
end

local function isRunning(id)
    return AutoMine == true and id == RunId
end

local function formatNumber(value)
    value = tonumber(value) or 0
    local absValue = math.abs(value)
    local suffixes = {
        {1e18, "Qi"},
        {1e15, "Q"},
        {1e12, "T"},
        {1e9, "B"},
        {1e6, "M"},
        {1e3, "K"}
    }

    for _, item in ipairs(suffixes) do
        if absValue >= item[1] then
            return string.format("%.2f%s", value / item[1], item[2])
        end
    end

    if math.floor(value) == value then
        return tostring(math.floor(value))
    end

    return string.format("%.2f", value)
end

local function formatTime(seconds)
    seconds = math.max(0, math.floor(tonumber(seconds) or 0))
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = seconds % 60

    if h > 0 then
        return string.format("%02d:%02d:%02d", h, m, s)
    end
    return string.format("%02d:%02d", m, s)
end

local function parseNumberText(value)
    if value == nil then
        return nil
    end

    local text = tostring(value):lower()
    text = text:gsub(",", "")
    text = text:gsub("%s+", "")

    local numberPart, suffix = text:match("^([%+%-]?[%d%.]+)([kmbtq]?)$")
    if not numberPart then
        return tonumber(text)
    end

    local number = tonumber(numberPart)
    if not number then
        return nil
    end

    local multipliers = {
        k = 1e3,
        m = 1e6,
        b = 1e9,
        t = 1e12,
        q = 1e15
    }

    return number * (multipliers[suffix] or 1)
end

local function getComparableValue(value)
    if value == nil then
        return 0
    end

    local success, result = pcall(function()
        return EternityNum.bnumtofloat(value)
    end)

    if success then
        result = safeNumber(result)
        if result ~= nil then
            return result
        end
    end

    return safeNumber(value) or 0
end


end


--------------------------------------------------
-- DISCONNECT FOLDER
--------------------------------------------------

local function disconnectFolder()

    for _, connection in ipairs(
        FolderConnections
    ) do


        pcall(function()

            connection:Disconnect()

        end)

    end


    FolderConnections =
        {}

end


--------------------------------------------------
-- RESCAN MINE
--------------------------------------------------

local function rescanMine()

    local folder =
        MiningServiceClient.mineFolder


    if not folder then
        return false
    end


    for _, block in ipairs(
        folder:GetChildren()
    ) do


        if block
            and block.Parent then


            if ModelsByName[
                tostring(
                    block.Name
                )
            ] ~= block then


                registerBlock(
                    block
                )

            end

        end

    end


    return true

end


--------------------------------------------------
-- SETUP INDEX
--------------------------------------------------

local function setupIndex()

    local folder =
        MiningServiceClient.mineFolder


    if not folder then
        return false
    end


    --------------------------------------------------
    -- SAME FOLDER
    --------------------------------------------------

    if IndexedFolder
        == folder then


        return true

    end


    --------------------------------------------------
    -- NEW FOLDER
    --------------------------------------------------

    disconnectFolder()

    clearIndex()


    IndexedFolder =
        folder


    --------------------------------------------------
    -- INITIAL SCAN
    --------------------------------------------------

    rescanMine()


    --------------------------------------------------
    -- CHILD ADDED
    --------------------------------------------------

    table.insert(

        FolderConnections,

        folder.ChildAdded:Connect(
            function(block)


                task.defer(function()


                    registerBlock(
                        block
                    )

                end)

            end
        )

    )


    --------------------------------------------------
    -- CHILD REMOVED
    --------------------------------------------------

    table.insert(

        FolderConnections,

        folder.ChildRemoved:Connect(
            function(block)


                unregisterBlock(
                    block
                )

            end
        )

    )


    return true

end


--------------------------------------------------
-- REBUILD SELECTED INDEX
--------------------------------------------------

local function rebuildSelectedIndex()

    SelectedByY =
        {}


    for name, model in pairs(
        ModelsByName
    ) do


        if model
            and model.Parent then


            local y =
                safeNumber(
                    YByName[name]
                )


            local info =
                getBlockInfoByName(
                    name
                )


            if y ~= nil
                and info
                and isSelectedOre(info) then


                addToBucket(
                    SelectedByY,
                    y,
                    name
                )

            end

        end

    end

end


--------------------------------------------------
-- CLEAN BUCKET
--------------------------------------------------

local function cleanBucket(bucket)

    if not bucket then
        return false
    end


    for name in pairs(
        bucket
    ) do


        local model =
            ModelsByName[name]


        local data =
            getBlockDataByName(
                name
            )


        if not model
            or not model.Parent
            or not data
            or data[1] == "None" then


            bucket[name] =
                nil

        end

    end


    return
        next(bucket) ~= nil

end


--------------------------------------------------
-- GET DEEPEST Y
--------------------------------------------------

local function deepestY(
    map,
    maxY
)

    maxY =
        safeNumber(maxY)


    local minimum =
        safeNumber(
            MIN_DEPTH
        )
        or -4999


    local result =
        nil


    for rawY, bucket in pairs(
        map
    ) do


        --------------------------------------------------
        -- CRITICAL FIX
        --------------------------------------------------

        local y =
            safeNumber(
                rawY
            )


        if y ~= nil then


            local allowed =
                y >= minimum


            if maxY ~= nil then

                allowed =
                    allowed
                    and y <= maxY

            end


            if allowed
                and cleanBucket(
                    bucket
                ) then


                if result == nil
                    or y < result then


                    result =
                        y

                end

            end

        end

    end


    return result

end


--------------------------------------------------
-- PLAYER GRID POSITION
--------------------------------------------------

local function getPlayerGridPosition()

    local character =
        LocalPlayer.Character


    if not character then

        return
            DEFAULT_X,
            DEFAULT_Z

    end


    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )


    if not root then

        return
            DEFAULT_X,
            DEFAULT_Z

    end


    local origin =
        MiningServiceClient.originPosition


    if not origin then

        return
            DEFAULT_X,
            DEFAULT_Z

    end


    local x =
        (
            root.Position.X
            - origin.X
        ) / 6


    local z =
        (
            root.Position.Z
            - origin.Z
        ) / 6


    return
        math.round(x),
        math.round(z)

end


--------------------------------------------------
-- PICK NEAREST
--------------------------------------------------

local function pickNearest(
    bucket,
    targetX,
    targetZ
)

    if not bucket then
        return nil
    end


    targetX =
        safeNumber(targetX)
        or DEFAULT_X


    targetZ =
        safeNumber(targetZ)
        or DEFAULT_Z


    local bestName =
        nil


    local bestDistance =
        math.huge


    local fallback =
        nil


    for name in pairs(
        bucket
    ) do


        local model =
            ModelsByName[name]


        if model
            and model.Parent then


            if not fallback then

                fallback =
                    name

            end


            local x,
                y,
                z =

                getCoordinatesFromName(
                    name
                )


            x = safeNumber(x)
            y = safeNumber(y)
            z = safeNumber(z)


            if x ~= nil
                and z ~= nil then


                local dx =
                    x - targetX


                local dz =
                    z - targetZ


                local distance =
                    dx * dx
                    + dz * dz


                if distance
                    < bestDistance then


                    bestDistance =
                        distance


                    bestName =
                        name

                end

            end

        else


            bucket[name] =
                nil

        end

    end


    return
        bestName
        or fallback

end


--------------------------------------------------
-- MODEL POSITION
--------------------------------------------------

local function getModelPosition(model)

    if not model then
        return nil
    end


    if model:IsA(
        "BasePart"
    ) then


        return
            model.Position

    end


    local success,
        pivot =

        pcall(function()


            return
                model:GetPivot()

        end)


    if success
        and pivot then


        return
            pivot.Position

    end


    return nil

end


--------------------------------------------------
-- MOVE NEAR TARGET
--------------------------------------------------

local function moveNearTarget(model)

    if not FOLLOW_TARGET then
        return true
    end


    if not model
        or not model.Parent then

        return false
    end


    local character =
        LocalPlayer.Character


    if not character then
        return false
    end


    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )


    if not root then
        return false
    end


    local targetPosition =
        getModelPosition(
            model
        )


    if not targetPosition then
        return false
    end


    --------------------------------------------------
    -- CURRENT DISTANCE
    --------------------------------------------------

    local distance =
        (
            root.Position
            - targetPosition
        ).Magnitude


    if distance
        <= TARGET_DISTANCE then


        return true

    end


    --------------------------------------------------
    -- MOVE ABOVE TARGET
    --------------------------------------------------

    local destination =
        targetPosition
        + Vector3.new(
            0,
            8,
            0
        )


    local look =
        root.CFrame.LookVector


    local success =
        pcall(function()


            character:PivotTo(

                CFrame.new(
                    destination,
                    destination + look
                )

            )


            root.AssemblyLinearVelocity =
                Vector3.zero


            root.AssemblyAngularVelocity =
                Vector3.zero

        end)


    task.wait()


    return success

end


--------------------------------------------------
-- MINING SPEED
--------------------------------------------------

local function getMiningSpeed()

    local success,
        value =

        pcall(function()


            return
                DataClient:get({
                    "Boosts",
                    "Mining_Speed"
                })

        end)


    if not success then
        return 0
    end


    local number =
        safeNumber(
            value
        )


    if number == nil then
        return 0
    end


    return
        math.max(
            number,
            0
        )

end


--------------------------------------------------
-- WAIT FOR REAL COOLDOWN
--------------------------------------------------

local function waitForCooldown(run)

    while isRunning(run) do


        local last =
            MiningServiceClient.damageCooldown


        --------------------------------------------------
        -- READY
        --------------------------------------------------

        if last == nil then

            return true

        end


        --------------------------------------------------
        -- CURRENT REQUEST RUNNING
        --------------------------------------------------

        if last == math.huge then


            task.wait()

            continue

        end


        last =
            safeNumber(last)


        --------------------------------------------------
        -- WEIRD VALUE -> JUST YIELD
        --------------------------------------------------

        if last == nil then


            task.wait()

            return true

        end


        local speed =
            getMiningSpeed()


        local now =
            workspace:GetServerTimeNow()


        local elapsed =
            now - last


        local remaining =
            speed - elapsed


        --------------------------------------------------
        -- READY
        --------------------------------------------------

        if remaining <= 0 then


            return true

        end


        --------------------------------------------------
        -- WAIT CLOSE TO EXACT TIME
        --------------------------------------------------

        task.wait(
            math.min(
                remaining,
                0.05
            )
        )

    end


    return false

end


--------------------------------------------------
-- BLOCK STATE
--------------------------------------------------

local function getStateKey(name)

    local data =
        getBlockDataByName(
            name
        )


    if not data then
        return "NONE"
    end


    return
        tostring(
            data[1]
        )
        .. "|"
        .. tostring(

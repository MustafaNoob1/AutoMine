--------------------------------------------------
-- REACH START DEPTH
--------------------------------------------------
local function reachStartDepth(run)
    local anchorX, anchorZ = getPlayerGridPosition()
    local effectiveStart, effectiveEnd = getEffectiveDepthRange()

    Stats.Status = "Digging to range"

    if START_DEPTH < RANK_MAX_DEPTH or END_DEPTH < RANK_MAX_DEPTH then
        Fluent:Notify({
            Title = "Rank Depth Limit",
            Content = "Effective range: " .. tostring(effectiveStart) .. " to " .. tostring(effectiveEnd),
            Duration = 4
        })
    end

    Fluent:Notify({
        Title = "Depth Loader",
        Content = "Going to " .. tostring(effectiveStart),
        Duration = 2
    })

    while isRunning(run) do
        rescanMine()

        local currentDeepest = deepestY(NonBedrockByY, nil, effectiveEnd)
        currentDeepest = safeNumber(currentDeepest)

        if currentDeepest == nil then
            task.wait(0.05)
            continue
        end

        if currentDeepest <= effectiveStart then
            Stats.Status = "Farming range"
            Fluent:Notify({
                Title = "Farm Range Reached",
                Content = tostring(effectiveStart) .. " to " .. tostring(effectiveEnd),
                Duration = 3
            })
            return true, anchorX, anchorZ
        end

        local target, targetY = getFrontierTarget(anchorX, anchorZ)
        targetY = safeNumber(targetY)

        if not target or targetY == nil then
            task.wait(0.05)
            continue
        end

        if targetY < effectiveEnd or not validDepth(targetY) then
            BlockedTargets[target] = true
            task.wait()
            continue
        end

        local x, _, z = getCoordinatesFromName(target)
        x = safeNumber(x)
        z = safeNumber(z)

        if x ~= nil then
            anchorX = x
        end
        if z ~= nil then
            anchorZ = z
        end

        mineTarget(target, "any", run)
        task.wait()
        rescanMine()
    end

    return false
end

--------------------------------------------------
-- FARM LOOP
--------------------------------------------------
local function farmingLoop(run, anchorX, anchorZ)
    local counter = 0
    local completionNotified = false

    while isRunning(run) do
        local effectiveStart, effectiveEnd = getEffectiveDepthRange()
        rescanMine()

        local smartResetNow, smartResetReason = shouldSmartReset()
        if smartResetNow then
            Stats.Status = "Smart reset"
            Stats.LastResetReason = tostring(smartResetReason or "Smart reset")
            Fluent:Notify({
                Title = "Smart Reset",
                Content = Stats.LastResetReason,
                Duration = 3
            })
            return "reset"
        end

        -- Priority 1: selected ore according to chosen priority mode.
        local target = getSelectedTarget(anchorX, anchorZ)

        if target then
            completionNotified = false
            local x, _, z = getCoordinatesFromName(target)
            x = safeNumber(x)
            z = safeNumber(z)

            if x ~= nil then
                anchorX = x
            end
            if z ~= nil then
                anchorZ = z
            end

            Stats.CurrentSweepY = safeNumber(YByName[target])
            mineTarget(target, "selected", run)
            task.wait()
            rescanMine()
        else
            local sweepTarget = nil
            local sweepY = nil

            if SWEEP_MODE == "Full Layer" then
                sweepTarget, sweepY = getFullSweepTarget(anchorX, anchorZ)
            elseif SWEEP_MODE == "Valuable Ores + Reveal" then
                sweepTarget, sweepY = getRevealTarget(anchorX, anchorZ)
            elseif SWEEP_MODE == "Selected Ores Only" then
                sweepTarget, sweepY = nil, nil
            end

            sweepY = safeNumber(sweepY)

            if sweepTarget
                and sweepY ~= nil
                and sweepY <= effectiveStart
                and sweepY >= effectiveEnd
                and validDepth(sweepY) then
                completionNotified = false
                Stats.CurrentSweepY = sweepY

                local x, _, z = getCoordinatesFromName(sweepTarget)
                x = safeNumber(x)
                z = safeNumber(z)

                if x ~= nil then
                    anchorX = x
                end
                if z ~= nil then
                    anchorZ = z
                end

                mineTarget(sweepTarget, "any", run)
                task.wait()
                rescanMine()
            else
                Stats.CurrentSweepY = nil
                Stats.Status = "Range complete"

                if not completionNotified then
                    completionNotified = true
                    Fluent:Notify({
                        Title = "Farm Range Complete",
                        Content = AUTO_RESET_MINE and "Resetting mine..." or "No more targets in selected range.",
                        Duration = 3
                    })
                end

                if AUTO_RESET_MINE then
                    Stats.LastResetReason = "Range complete"
                    return "reset"
                end

                requestStop("Farm range complete")
                return "complete"
            end
        end

        counter = counter + 1
        if counter % 20 == 0 then
            rescanMine()
            rebuildSelectedIndex()
        end

        if checkStopConditions() then
            return "stopped"
        end
    end

    return "stopped"
end

--------------------------------------------------
-- AUTO RESET MINE
--------------------------------------------------
local function requestMineReset(run)
    if not isRunning(run) then
        return false
    end

    local networker = MiningServiceClient.networker
    if not networker then
        Fluent:Notify({
            Title = "Auto Reset",
            Content = "MiningService networker not ready.",
            Duration = 4
        })
        return false
    end

    Stats.Status = "Resetting mine"
    IsResetting = true
    MiningServiceClient.currentBlock = nil

    local oldBlocksTable = MiningServiceClient.blocks

    local success, err = pcall(function()
        networker:InvokeServer("resetMine_Manual")
    end)

    if not success then
        IsResetting = false
        warn("Ore Miner: reset failed:", err)
        Fluent:Notify({
            Title = "Auto Reset Failed",
            Content = tostring(err),
            Duration = 5
        })
        return false
    end

    Stats.Resets = Stats.Resets + 1
    BlockedTargets = {}
    AlertedRareBlocks = {}
    CycleMinedByDepth = {}

    local timeoutAt = os.clock() + 12
    local ready = false

    while isRunning(run) and os.clock() < timeoutAt do
        local blocks = MiningServiceClient.blocks
        local folder = MiningServiceClient.mineFolder

        if blocks ~= oldBlocksTable
            and blocks
            and next(blocks) ~= nil
            and folder
            and #folder:GetChildren() > 0 then
            ready = true
            break
        end

        task.wait(0.1)
    end

    clearIndex()
    if MiningServiceClient.mineFolder then
        IndexedFolder = MiningServiceClient.mineFolder
    end
    rescanMine()
    rebuildSelectedIndex()

    IsResetting = false

    if not ready then
        Fluent:Notify({
            Title = "Auto Reset",
            Content = "Reset response timed out.",
            Duration = 4
        })
        return false
    end

    Stats.Status = "Mine reset complete"
    CycleStartTime = os.clock()
    CycleStartBlocks = Stats.BlocksMined
    CycleStartOres = Stats.OresMined
    LastOreMinedAt = os.clock()
    return true
end

--------------------------------------------------
-- START MINING / CYCLE LOOP
--------------------------------------------------
local function startMining(run)
    task.spawn(function()
        refreshRankDepth()
        applyAutomaticDepth(false)
        BlockedTargets = {}

        if refreshOreDropdownForRange then
            refreshOreDropdownForRange()
        end
        if updateRankDisplay then
            updateRankDisplay()
        end

        if not waitForMine(run) then
            return
        end

        while isRunning(run) do
            CycleMinedByDepth = {}
            BlockedTargets = {}
            Stats.CurrentSweepY = nil
            CycleStartTime = os.clock()
            CycleStartBlocks = Stats.BlocksMined
            CycleStartOres = Stats.OresMined
            LastOreMinedAt = LastOreMinedAt or os.clock()

            rebuildWholeIndex()
            rebuildSelectedIndex()

            local reached, anchorX, anchorZ = reachStartDepth(run)
            if not reached or not isRunning(run) then
                return
            end

            rescanMine()
            rebuildSelectedIndex()

            local outcome = farmingLoop(run, anchorX, anchorZ)

            if outcome == "reset" and isRunning(run) then
                if not requestMineReset(run) then
                    requestStop("Auto reset failed")
                    return
                end
                task.wait(0.25)
            else
                return
            end
        end
    end)
end

local function restartActiveMiner()
    if not AutoMine then
        return
    end

    RunId = RunId + 1
    local run = RunId
    task.defer(function()
        startMining(run)
    end)
end


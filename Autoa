local function waitForMine(run)

    while isRunning(run) do


        if MiningServiceClient.mineFolder
            and MiningServiceClient.blocks then


            if setupIndex() then


                rescanMine()


                return true

            end

        end


        task.wait(
            0.1
        )

    end


    return false

end


--------------------------------------------------
-- REACH START DEPTH
--------------------------------------------------

local function reachStartDepth(run)

    local anchorX,
        anchorZ =

        getPlayerGridPosition()


    local effectiveStart,
        effectiveEnd =

        getEffectiveDepthRange()


    --------------------------------------------------
    -- RANK LIMIT INFO
    --------------------------------------------------

    if START_DEPTH
            < RANK_MAX_DEPTH
        or END_DEPTH
            < RANK_MAX_DEPTH then


        Fluent:Notify({

            Title =
                "Rank Depth Limit",

            Content =
                "Effective range: "
                .. tostring(
                    effectiveStart
                )
                .. " to "
                .. tostring(
                    effectiveEnd
                ),

            Duration =
                4

        })

    end


    Fluent:Notify({

        Title =
            "Depth Loader",

        Content =
            "Going to "
            .. tostring(
                effectiveStart
            ),

        Duration =
            2

    })


    --------------------------------------------------
    -- DIG DOWN
    --------------------------------------------------

    while isRunning(run) do


        rescanMine()


        local currentDeepest =
            deepestY(
                NonBedrockByY,
                nil,
                effectiveEnd
            )


        currentDeepest =
            safeNumber(
                currentDeepest
            )


        if currentDeepest == nil then


            task.wait(
                0.05
            )


            continue

        end


        --------------------------------------------------
        -- START REACHED
        --------------------------------------------------

        if currentDeepest
            <= effectiveStart then


            Fluent:Notify({

                Title =
                    "Farm Range reached",

                Content =
                    tostring(
                        effectiveStart
                    )
                    .. " to "
                    .. tostring(
                        effectiveEnd
                    )
                    .. " | Sweeping layer...",

                Duration =
                    3

            })


            return
                true,
                anchorX,
                anchorZ

        end


        --------------------------------------------------
        -- FRONTIER
        --------------------------------------------------

        local target,
            targetY =

            getFrontierTarget(
                anchorX,
                anchorZ
            )


        targetY =
            safeNumber(
                targetY
            )


        if not target
            or targetY == nil then


            task.wait(
                0.05
            )


            continue

        end


        --------------------------------------------------
        -- NEVER BELOW END DEPTH
        --------------------------------------------------

        if targetY
            < effectiveEnd then


            BlockedTargets[
                target
            ] =
                true


            task.wait()


            continue

        end


        --------------------------------------------------
        -- RANK CHECK
        --------------------------------------------------

        if not validDepth(
            targetY
        ) then


            BlockedTargets[
                target
            ] =
                true


            task.wait()


            continue

        end


        --------------------------------------------------
        -- UPDATE ANCHOR
        --------------------------------------------------

        local x,
            _,
            z =

            getCoordinatesFromName(
                target
            )


        x =
            safeNumber(
                x
            )


        z =
            safeNumber(
                z
            )


        if x ~= nil then


            anchorX =
                x

        end


        if z ~= nil then


            anchorZ =
                z

        end


        --------------------------------------------------
        -- MINE PATH
        --------------------------------------------------

        mineTarget(
            target,
            "any",
            run
        )


        task.wait()


        rescanMine()

    end


    return false

end


--------------------------------------------------
-- FARM / SWEEP LOOP
--------------------------------------------------

local function farmingLoop(
    run,
    anchorX,
    anchorZ
)

    local counter =
        0


    while isRunning(run) do


        --------------------------------------------------
        -- CURRENT RANGE
        --------------------------------------------------

        local effectiveStart,
            effectiveEnd =

            getEffectiveDepthRange()


        --------------------------------------------------
        -- KEEP CLIENT INDEX FRESH
        --------------------------------------------------

        rescanMine()


        --------------------------------------------------
        -- PRIORITY 1
        --
        -- MOST VALUABLE SELECTED ORE
        --------------------------------------------------

        local target =
            getSelectedTarget(
                anchorX,
                anchorZ
            )


        if target then


            --------------------------------------------------
            -- UPDATE ANCHOR
            --------------------------------------------------

            local x,
                _,
                z =

                getCoordinatesFromName(
                    target
                )


            x =
                safeNumber(
                    x
                )


            z =
                safeNumber(
                    z
                )


            if x ~= nil then


                anchorX =
                    x

            end


            if z ~= nil then


                anchorZ =
                    z

            end


            --------------------------------------------------
            -- MINE VALUABLE ORE
            --------------------------------------------------

            mineTarget(
                target,
                "selected",
                run
            )


            --------------------------------------------------
            -- SERVER MAY REVEAL MORE SAME-Y BLOCKS
            --------------------------------------------------

            task.wait()


            rescanMine()


        else


            --------------------------------------------------
            -- PRIORITY 2
            --
            -- SWEEP WHOLE FARM LEVEL
            --
            -- This mines Stone / other blocks on the
            -- same Y so hidden ores can be revealed.
            --------------------------------------------------

            local sweepTarget,
                sweepY =

                getRangeSweepTarget(
                    anchorX,
                    anchorZ
                )


            sweepY =
                safeNumber(
                    sweepY
                )


            if sweepTarget
                and sweepY ~= nil then


                --------------------------------------------------
                -- FINAL RANGE CHECK
                --------------------------------------------------

                if sweepY
                        <= effectiveStart
                    and sweepY
                        >= effectiveEnd
                    and validDepth(
                        sweepY
                    ) then


                    --------------------------------------------------
                    -- UPDATE ANCHOR
                    --------------------------------------------------

                    local x,
                        _,
                        z =

                        getCoordinatesFromName(
                            sweepTarget
                        )


                    x =
                        safeNumber(
                            x
                        )


                    z =
                        safeNumber(
                            z
                        )


                    if x ~= nil then


                        anchorX =
                            x

                    end


                    if z ~= nil then


                        anchorZ =
                            z

                    end


                    --------------------------------------------------
                    -- MINE ANY BLOCK ON THIS LEVEL
                    --------------------------------------------------

                    mineTarget(
                        sweepTarget,
                        "any",
                        run
                    )


                    --------------------------------------------------
                    -- NEW NEIGHBORS CAN NOW APPEAR
                    --------------------------------------------------

                    task.wait()


                    rescanMine()


                else


                    BlockedTargets[
                        sweepTarget
                    ] =
                        true


                    task.wait()

                end


            else


                --------------------------------------------------
                -- NOTHING CURRENTLY LEFT IN RANGE
                --------------------------------------------------

                task.wait(
                    0.1
                )

            end

        end


        --------------------------------------------------
        -- PERIODIC REBUILD
        --------------------------------------------------

        counter =
            counter + 1


        if counter % 20
            == 0 then


            rescanMine()


            rebuildSelectedIndex()

        end

    end

end


--------------------------------------------------
-- START MINING
--------------------------------------------------

local function startMining(run)

    task.spawn(function()


        --------------------------------------------------
        -- REFRESH CURRENT RANK
        --------------------------------------------------

        refreshRankDepth()


        --------------------------------------------------
        -- RESET FAILED BLOCKS
        --------------------------------------------------

        BlockedTargets =
            {}


        --------------------------------------------------
        -- WAIT FOR MINE
        --------------------------------------------------

        if not waitForMine(
            run
        ) then


            return

        end


        --------------------------------------------------
        -- REBUILD INDEX FOR CURRENT RANK
        --------------------------------------------------

        rebuildWholeIndex()


        rebuildSelectedIndex()


        --------------------------------------------------
        -- PHASE 1:
        -- GO TO FARM RANGE
        --------------------------------------------------

        local reached,
            anchorX,
            anchorZ =

            reachStartDepth(
                run
            )


        if not reached
            or not isRunning(
                run
            ) then


            return

        end


        --------------------------------------------------
        -- REFRESH
        --------------------------------------------------

        rescanMine()


        rebuildSelectedIndex()


        --------------------------------------------------
        -- PHASE 2:
        -- FARM / SWEEP
        --------------------------------------------------

        farmingLoop(
            run,
            anchorX,
            anchorZ
        )

    end)

end



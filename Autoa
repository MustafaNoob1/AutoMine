--------------------------------------------------
-- MODE CHECK
--------------------------------------------------

local function modeAllows(
    name,
    mode
)

    local y =
        safeNumber(
            YByName[name]
        )


    if not validDepth(y) then
        return false
    end


    local info =
        getBlockInfoByName(
            name
        )


    if not info
        or isBedrock(info) then

        return false

    end


    if mode == "selected" then


        return
            isSelectedOre(
                info
            )

    end


    if mode == "stone" then


        return
            isStone(
                info
            )

    end


    return true

end



--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local AutoMine = false

local MIN_DEPTH = -4999

-- Ab dieser Tiefe werden Stone +
-- ausgewählte Erze normal verarbeitet.
local START_DEPTH = 0

-- Damage-Aufrufe vor einem Yield.
local DAMAGE_BURST = 10

-- bevorzugte Tunnelposition
local LOADER_X = 9
local LOADER_Z = 9

-- Streaming
local STREAM_WAIT = 0.04
local STREAM_CHECKS = 40

-- Wie weit der Charakter beim Streaming
-- maximal nach unten getestet wird.
local MAX_STREAM_DROP = 48


--------------------------------------------------
-- RUN CONTROL
--------------------------------------------------

local RunId = 0


local function isRunning(id)

    return
        AutoMine
        and id == RunId

end


--------------------------------------------------
-- BLOCK COORDINATES
--------------------------------------------------

local function getCoordinates(block)

    if not block then
        return nil, nil, nil
    end

    local x, y, z =
        string.match(
            block.Name,
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )

    return
        tonumber(x),
        tonumber(y),
        tonumber(z)

end


--------------------------------------------------
-- BLOCK Y
--------------------------------------------------

local function getBlockY(block)

    if not block then
        return nil
    end

    local _, y, _ =
        getCoordinates(block)

    if y ~= nil then
        return y
    end

    -- Fallback zur ursprünglichen Namenslogik
    local value =
        string.match(
            block.Name,
            "^[^_]+_(-?%d+)_"
        )

    return tonumber(value)

end


--------------------------------------------------
-- VALID DEPTH
--------------------------------------------------

local function validDepth(y)

    return
        y ~= nil
        and y <= 0
        and y >= MIN_DEPTH

end


--------------------------------------------------
-- FULL MINING RANGE
--------------------------------------------------

local function inMiningRange(y)

    return
        y ~= nil
        and y <= START_DEPTH
        and y >= MIN_DEPTH

end


--------------------------------------------------
-- BLOCK INFO
--------------------------------------------------

local function loadBlockInfo(block)

    if not block then
        return nil
    end

    local data =
        MiningServiceClient.blocks[
            block.Name
        ]

    if not data then
        return nil
    end

    local id =
        data[1]

    if not id
        or id == "None" then

        return nil
    end

    local info =
        MiningInfo:getBlock(id)

    if not info then
        return nil
    end

    return {

        Id = id,

        Name =
            info.name,

        HP =
            info.hp,

        Value =
            info.value,

        Model =
            info.model

    }

end


--------------------------------------------------
-- BLOCK TYPES
--------------------------------------------------

local function isStone(info)

    return
        info ~= nil
        and string.match(
            info.Id,
            "^StoneOre%d*$"
        ) ~= nil

end


local function isBedrock(info)

    return
        info ~= nil
        and info.Id == "Bedrock"

end


--------------------------------------------------
-- SELECTED ORES
--------------------------------------------------

local SelectedOres = {}


local function isSelectedOre(info)

    if not info then
        return false
    end

    if isStone(info)
        or isBedrock(info) then

        return false
    end

    return
        SelectedOres[
            info.Id
        ] == true

end


--------------------------------------------------
-- INDEX
--------------------------------------------------

local AllBlocks = {}

local BlockInfoCache = {}

local BlockYCache = {}

local BlocksByY = {}

local NonBedrockByY = {}

local StoneByY = {}

local SelectedByY = {}

local IndexedFolder = nil

local Connections = {}


--------------------------------------------------
-- MAP HELPERS
--------------------------------------------------

local function addToMap(
    map,
    y,
    block
)

    if not map[y] then
        map[y] = {}
    end

    map[y][block] =
        true

end


local function removeFromMap(
    map,
    y,
    block
)

    if not y
        or not map[y] then

        return
    end

    map[y][block] =
        nil

    if next(map[y]) == nil then

        map[y] =
            nil

    end

end


--------------------------------------------------
-- REGISTER BLOCK
--------------------------------------------------

local function registerBlock(block)

    if not block then
        return
    end

    if AllBlocks[block] then
        return
    end

    local y =
        getBlockY(block)

    if not validDepth(y) then
        return
    end

    local info =
        loadBlockInfo(block)

    if not info then
        return
    end


    AllBlocks[block] =
        true

    BlockInfoCache[block] =
        info

    BlockYCache[block] =
        y


    addToMap(
        BlocksByY,
        y,
        block
    )


    if not isBedrock(info) then

        addToMap(
            NonBedrockByY,
            y,
            block
        )

    end


    if isStone(info) then

        addToMap(
            StoneByY,
            y,
            block
        )

    end


    if isSelectedOre(info) then

        addToMap(
            SelectedByY,
            y,
            block
        )

    end

end


--------------------------------------------------
-- UNREGISTER BLOCK
--------------------------------------------------

local function unregisterBlock(block)

    if not block then
        return
    end

    local y =
        BlockYCache[block]


    removeFromMap(
        BlocksByY,
        y,
        block
    )

    removeFromMap(
        NonBedrockByY,
        y,
        block
    )

    removeFromMap(
        StoneByY,
        y,
        block
    )

    removeFromMap(
        SelectedByY,
        y,
        block
    )


    AllBlocks[block] =
        nil

    BlockInfoCache[block] =
        nil

    BlockYCache[block] =
        nil

end


--------------------------------------------------
-- CLEAR INDEX
--------------------------------------------------

local function clearIndex()

    AllBlocks = {}

    BlockInfoCache = {}

    BlockYCache = {}

    BlocksByY = {}

    NonBedrockByY = {}

    StoneByY = {}

    SelectedByY = {}

end


--------------------------------------------------
-- DISCONNECT OLD FOLDER
--------------------------------------------------

local function disconnectFolder()

    for _, connection in ipairs(
        Connections
    ) do

        pcall(function()

            connection:Disconnect()

        end)

    end

    Connections = {}

end


--------------------------------------------------
-- RESCAN FOLDER
--------------------------------------------------

local function rescanFolder()

    local folder =
        MiningServiceClient.mineFolder

    if not folder then
        return false
    end

    for _, block in ipairs(
        folder:GetChildren()
    ) do

        registerBlock(block)

    end

    return true

end


--------------------------------------------------
-- SETUP FOLDER
--------------------------------------------------

local function setupFolder()

    local folder =
        MiningServiceClient.mineFolder

    if not folder then
        return false
    end


    if IndexedFolder == folder then

        return true

    end


    disconnectFolder()

    clearIndex()


    IndexedFolder =
        folder


    rescanFolder()


    table.insert(

        Connections,

        folder.ChildAdded:Connect(
            function(block)

                registerBlock(block)

            end
        )

    )


    table.insert(

        Connections,

        folder.ChildRemoved:Connect(
            function(block)

                unregisterBlock(block)

            end
        )

    )


    return true

end


--------------------------------------------------
-- REBUILD SELECTED ORES
--------------------------------------------------

local function rebuildSelectedIndex()

    SelectedByY = {}


    for block in pairs(
        AllBlocks
    ) do

        if block
            and block.Parent then

            local info =
                BlockInfoCache[block]

            local y =
                BlockYCache[block]


            if info
                and y
                and isSelectedOre(info) then

                addToMap(
                    SelectedByY,
                    y,
                    block
                )

            end

        end

    end

end


--------------------------------------------------
-- CLEAN BUCKET
--------------------------------------------------

local function cleanBucket(bucket)

    if not bucket then
        return false
    end

    for block in pairs(
        bucket
    ) do

        if not block
            or not block.Parent then

            bucket[block] =
                nil

        end

    end

    return
        next(bucket) ~= nil

end


--------------------------------------------------
-- DEEPEST Y IN MAP
--------------------------------------------------

local function deepestY(
    map,
    maximumY
)

    local best =
        nil


    for y, bucket in pairs(
        map
    ) do

        if y >= MIN_DEPTH
            and (
                maximumY == nil
                or y <= maximumY
            ) then


            if cleanBucket(bucket) then


                if best == nil
                    or y < best then

                    best =
                        y

                end

            end

        end

    end


    return best

end


--------------------------------------------------
-- GET ANY LIVE BLOCK
--------------------------------------------------

local function getAnyBlock(bucket)

    if not bucket then
        return nil
    end

    for block in pairs(
        bucket
    ) do

        if block
            and block.Parent then

            return block

        else

            bucket[block] =
                nil

        end

    end

    return nil

end


--------------------------------------------------
-- NEAREST BLOCK BY X/Z
--------------------------------------------------

local function getNearestBlock(
    bucket,
    targetX,
    targetZ
)

    if not bucket then
        return nil
    end


    local bestBlock =
        nil

    local bestDistance =
        math.huge

    local fallback =
        nil


    for block in pairs(
        bucket
    ) do


        if not block
            or not block.Parent then

            bucket[block] =
                nil


        else

            if not fallback then

                fallback =
                    block

            end


            local x, _, z =
                getCoordinates(block)


            if x ~= nil
                and z ~= nil then


                local dx =
                    x - targetX

                local dz =
                    z - targetZ


                local distance =
                    dx * dx
                    + dz * dz


                if distance
                    < bestDistance then

                    bestDistance =
                        distance

                    bestBlock =
                        block

                end

            end

        end

    end


    return
        bestBlock
        or fallback

end


--------------------------------------------------
-- BLOCK CFRAME
--------------------------------------------------

local function getBlockTransform(block)

    if not block then
        return nil, 6
    end


    if block:IsA(
        "BasePart"
    ) then

        return
            block.CFrame,
            math.max(
                block.Size.Y,
                1
            )

    end


    local success, pivot =
        pcall(function()

            return block:GetPivot()

        end)


    if success then

        return pivot, 6

    end


    return nil, 6

end


--------------------------------------------------
-- MOVE CHARACTER
--------------------------------------------------

local function moveCharacter(
    cframe,
    downAmount
)

    if not cframe then
        return false
    end


    local character =
        LocalPlayer.Character

    if not character then
        return false
    end


    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return false
    end


    downAmount =
        downAmount
        or 0


    local position =
        cframe.Position
        + Vector3.new(
            0,
            2 - downAmount,
            0
        )


    local look =
        root.CFrame.LookVector


    pcall(function()

        character:PivotTo(
            CFrame.new(
                position,
                position + look
            )
        )

        root.AssemblyLinearVelocity =
            Vector3.zero

        root.AssemblyAngularVelocity =
            Vector3.zero

    end)


    return true

end


--------------------------------------------------
-- RAW DAMAGE
--------------------------------------------------

local function damage(block)

    if not block
        or not block.Parent then

        return false
    end


    if not block:GetAttribute(
        "isBlock"
    ) then

        return false
    end


    MiningServiceClient.currentBlock =
        block

    MiningServiceClient:damageBlock()


    return true

end


--------------------------------------------------
-- FAST MINE
--------------------------------------------------

local function mineFast(
    block,
    mode,
    run
)

    if not block
        or not block.Parent then

        return false
    end


    local info =
        BlockInfoCache[block]
        or loadBlockInfo(block)


    if not info then
        return false
    end


    if isBedrock(info) then
        return false
    end


    --------------------------------------------------
    -- TYPE CHECK
    --------------------------------------------------

    if mode == "stone"
        and not isStone(info) then

        return false

    end


    if mode == "selected"
        and not isSelectedOre(info) then

        return false

    end


    --------------------------------------------------
    -- SET TARGET ONCE
    --------------------------------------------------

    MiningServiceClient.currentBlock =
        block


    --------------------------------------------------
    -- MINE UNTIL DESTROYED
    --------------------------------------------------

    while block.Parent
        and isRunning(run) do


        for i = 1, DAMAGE_BURST do


            if not block.Parent
                or not isRunning(run) then

                break

            end


            MiningServiceClient:damageBlock()

        end


        task.wait()

    end


    return
        not block.Parent

end


--------------------------------------------------
-- STREAM FOR DEEPER BLOCKS
--------------------------------------------------

local function tryLoadDeeper(
    previousY,
    blockCFrame,
    blockHeight,
    run
)

    local oldDeepest =
        previousY


    for attempt = 1, STREAM_CHECKS do


        if not isRunning(run) then
            return nil
        end


        --------------------------------------------------
        -- FORCE RESCAN SOMETIMES
        --------------------------------------------------

        if attempt % 5 == 0 then

            setupFolder()

            rescanFolder()

        end


        --------------------------------------------------
        -- CHECK NEW DEEPEST LEVEL
        --------------------------------------------------

        local currentDeepest =
            deepestY(
                NonBedrockByY,
                nil
            )


        if currentDeepest
            and currentDeepest < oldDeepest then

            return currentDeepest

        end


        --------------------------------------------------
        -- MOVE CHARACTER DOWN GRADUALLY
        --------------------------------------------------

        if blockCFrame
            and attempt % 5 == 0 then


            local stage =
                math.floor(
                    attempt / 5
                )


            local drop =
                math.min(
                    blockHeight * stage,
                    MAX_STREAM_DROP
                )


            moveCharacter(
                blockCFrame,
                drop
            )

        end


        task.wait(
            STREAM_WAIT
        )

    end


    return nil

end


--------------------------------------------------
-- DESCENT TO START DEPTH
--------------------------------------------------

local function reachStartDepth(run)

    local anchorX =
        LOADER_X

    local anchorZ =
        LOADER_Z


    local failedLoads =
        0


    Fluent:Notify({

        Title =
            "Adaptive Loader",

        Content =
            "Searching deepest loaded blocks...",

        Duration =
            2

    })


    while isRunning(run) do


        --------------------------------------------------
        -- MAKE SURE FOLDER EXISTS
        --------------------------------------------------

        if not setupFolder() then

            task.wait(0.1)

            continue

        end


        rescanFolder()


        --------------------------------------------------
        -- DEEPEST ACTUAL LOADED Y
        --------------------------------------------------

        local currentY =
            deepestY(
                NonBedrockByY,
                nil
            )


        if currentY == nil then

            task.wait(0.1)

            continue

        end


        --------------------------------------------------
        -- START DEPTH REACHED
        --------------------------------------------------

        if currentY <= START_DEPTH then


            Fluent:Notify({

                Title =
                    "Start Depth",

                Content =
                    "Reached loaded depth Y = "
                    .. tostring(currentY),

                Duration =
                    3

            })


            return
                currentY,
                anchorX,
                anchorZ

        end


        --------------------------------------------------
        -- DEEPEST LEVEL
        --------------------------------------------------

        local bucket =
            NonBedrockByY[
                currentY
            ]


        local target =
            getNearestBlock(
                bucket,
                anchorX,
                anchorZ
            )


        if not target then

            task.wait()

            continue

        end


        --------------------------------------------------
        -- UPDATE ANCHOR
        --------------------------------------------------

        local x, _, z =
            getCoordinates(
                target
            )


        if x ~= nil then
            anchorX = x
        end

        if z ~= nil then
            anchorZ = z
        end


        --------------------------------------------------
        -- SAVE POSITION
        --------------------------------------------------

        local targetCFrame,
            targetHeight =

            getBlockTransform(
                target
            )


        --------------------------------------------------
        -- MINE WHATEVER IS IN THE WAY
        --------------------------------------------------

        local mined =
            mineFast(
                target,
                "any",
                run
            )


        if not isRunning(run) then
            return nil
        end


        --------------------------------------------------
        -- MOVE INTO OPENED AREA
        --------------------------------------------------

        if mined
            and targetCFrame then

            moveCharacter(
                targetCFrame,
                0
            )

        end


        --------------------------------------------------
        -- TRY STREAMING DEEPER
        --------------------------------------------------

        local deeperY =
            tryLoadDeeper(
                currentY,
                targetCFrame,
                targetHeight,
                run
            )


        if deeperY then


            failedLoads =
                0


        else


            --------------------------------------------------
            -- IMPORTANT:
            -- DON'T STOP.
            --
            -- Mine another block on the same frontier.
            --------------------------------------------------

            failedLoads =
                failedLoads + 1


            --------------------------------------------------
            -- MORE AGGRESSIVE STREAM PROBE
            --------------------------------------------------

            if targetCFrame
                and failedLoads % 3 == 0 then


                moveCharacter(
                    targetCFrame,
                    math.min(
                        12
                        + failedLoads * 2,
                        MAX_STREAM_DROP
                    )
                )


                task.wait(0.1)

                rescanFolder()

            end

        end

    end


    return nil

end


--------------------------------------------------
-- GET DEEPEST SELECTED ORE
--------------------------------------------------

local function getSelectedTarget()

    local y =
        deepestY(
            SelectedByY,
            START_DEPTH
        )


    if not y then
        return nil
    end


    return
        getAnyBlock(
            SelectedByY[y]
        )

end


--------------------------------------------------
-- GET DEEPEST STONE
--------------------------------------------------

local function getStoneTarget()

    local y =
        deepestY(
            StoneByY,
            START_DEPTH
        )


    if not y then
        return nil
    end


    return
        getAnyBlock(
            StoneByY[y]
        )

end


--------------------------------------------------
-- FRONTIER TARGET
--------------------------------------------------

local function getFrontierTarget(
    anchorX,
    anchorZ
)

    local y =
        deepestY(
            NonBedrockByY,
            nil
        )


    if not y then
        return nil, nil
    end


    local target =
        getNearestBlock(
            NonBedrockByY[y],
            anchorX,
            anchorZ
        )


    return
        target,
        y

end


--------------------------------------------------
-- MAIN MINING LOOP
--------------------------------------------------

local function miningLoop(
    run,
    anchorX,
    anchorZ
)

    local workCounter =
        0


    while isRunning(run) do


        --------------------------------------------------
        -- FOLDER CHECK
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then

            setupFolder()

        end


        --------------------------------------------------
        -- SELECTED ORES FIRST
        --------------------------------------------------

        local target =
            getSelectedTarget()


        local mode =
            "selected"


        --------------------------------------------------
        -- THEN STONE
        --------------------------------------------------

        if not target then

            target =
                getStoneTarget()

            mode =
                "stone"

        end


        --------------------------------------------------
        -- NORMAL WORK
        --------------------------------------------------

        if target then


            local y =
                BlockYCache[target]
                or getBlockY(target)


            local cframe,
                height =

                getBlockTransform(
                    target
                )


            mineFast(
                target,
                mode,
                run
            )


            if not isRunning(run) then
                return
            end


            workCounter =
                workCounter + 1


            --------------------------------------------------
            -- FOLLOW DEEPEST AREA
            --------------------------------------------------

            local deepest =
                deepestY(
                    NonBedrockByY,
                    nil
                )


            if cframe
                and y
                and deepest
                and y <= deepest then


                moveCharacter(
                    cframe,
                    0
                )

            end


            --------------------------------------------------
            -- PERIODICALLY TRY LOADING DEEPER
            --------------------------------------------------

            if workCounter % 20 == 0
                and deepest
                and deepest > MIN_DEPTH then


                tryLoadDeeper(
                    deepest,
                    cframe,
                    height,
                    run
                )

            end


        else


            --------------------------------------------------
            -- NOTHING SELECTED/STONE LOADED.
            --
            -- OPEN THE DEEPEST FRONTIER.
            --------------------------------------------------

            local frontier,
                frontierY =

                getFrontierTarget(
                    anchorX,
                    anchorZ
                )


            if frontier
                and frontierY then


                local x, _, z =
                    getCoordinates(
                        frontier
                    )


                if x ~= nil then
                    anchorX = x
                end

                if z ~= nil then
                    anchorZ = z
                end


                local cframe,
                    height =

                    getBlockTransform(
                        frontier
                    )


                local mined =
                    mineFast(
                        frontier,
                        "any",
                        run
                    )


                if mined
                    and cframe then


                    moveCharacter(
                        cframe,
                        0
                    )


                    tryLoadDeeper(
                        frontierY,
                        cframe,
                        height,
                        run
                    )

                end


            else


                --------------------------------------------------
                -- NO CURRENT BLOCKS.
                -- KEEP WAITING FOR STREAMING.
                --------------------------------------------------

                rescanFolder()

                task.wait(0.1)

            end

        end

    end

end


--------------------------------------------------
-- START MINING
--------------------------------------------------

local function startMining(run)

    task.spawn(function()


        --------------------------------------------------
        -- WAIT FOR MINE FOLDER
        --------------------------------------------------

        while isRunning(run) do


            if setupFolder() then
                break
            end


            task.wait(0.1)

        end


        if not isRunning(run) then
            return
        end


        rebuildSelectedIndex()


        --------------------------------------------------
        -- STEP 1:
        -- ADAPTIVELY REACH START DEPTH
        --------------------------------------------------

        local actualY,
            anchorX,
            anchorZ =

            reachStartDepth(
                run
            )


        if actualY == nil
            or not isRunning(run) then

            return

        end


        --------------------------------------------------
        -- STEP 2:
        -- MINE EVERYTHING LOADED BELOW START DEPTH
        --------------------------------------------------

        rescanFolder()

        rebuildSelectedIndex()


        miningLoop(
            run,
            anchorX,
            anchorZ
        )

    end)

end


--------------------------------------------------
-- BUILD ORE LIST
--------------------------------------------------

local OreValues = {}


for id, data in pairs(
    BlocksData
) do


    if id
        and not string.match(
            id,
            "^StoneOre%d*$"
        )
        and id ~= "Bedrock" then


        local displayName =
            id


        if type(data)
            == "table" then


            displayName =
                data.name
                or data.Name
                or id

        end


        table.insert(
            OreValues,
            displayName
        )

    end

end


table.sort(
    OreValues
)



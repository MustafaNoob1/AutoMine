--------------------------------------------------
-- BUILD ORE LIST
--------------------------------------------------

local OreValues =
    {}


local OreDisplayToId =
    {}


--------------------------------------------------
-- EVERYTHING SELECTED INTERNALLY
--------------------------------------------------

SelectedOres =
    {}


for rawId,
    data in pairs(
        BlocksData
    ) do


    local id =
        tostring(
            rawId
        )


    --------------------------------------------------
    -- EXCLUDE STONE + BEDROCK
    --------------------------------------------------

    if not string.match(
        id,
        "^StoneOre%d*$"
    )
        and id ~= "Bedrock" then


        --------------------------------------------------
        -- SAFE STRING DISPLAY NAME
        --------------------------------------------------

        local displayName =
            id


        if type(
            data
        ) == "table" then


            if type(
                data.name
            ) == "string" then


                displayName =
                    data.name


            elseif type(
                data.Name
            ) == "string" then


                displayName =
                    data.Name

            end

        end


        displayName =
            tostring(
                displayName
            )


        --------------------------------------------------
        -- NO DUPLICATE DISPLAY NAMES
        --------------------------------------------------

        if OreDisplayToId[
            displayName
        ] == nil then


            table.insert(
                OreValues,
                displayName
            )


            OreDisplayToId[
                displayName
            ] =
                id


            --------------------------------------------------
            -- SELECT BY DEFAULT
            --------------------------------------------------

            SelectedOres[
                id
            ] =
                true

        end

    end

end


table.sort(
    OreValues
)


--------------------------------------------------
-- FLUENT DEFAULT SELECTION
--
-- ARRAY OF STRINGS
--------------------------------------------------

local OreDefaultValues =
    {}


for _,
    displayName in ipairs(
        OreValues
    ) do


    table.insert(
        OreDefaultValues,
        tostring(
            displayName
        )
    )

end



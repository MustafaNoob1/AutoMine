local function getGlobalNetworker()
    local networker = nil

    pcall(function()
        networker = Utils.networker
    end)

    return networker
end

local function invokeGameNetwork(...)
    local networker = getGlobalNetworker()
    if not networker then
        return false, "Utils.networker not ready"
    end

    local args = {...}
    local success, result = pcall(function()
        return networker:InvokeServer(table.unpack(args))
    end)

    if not success then
        return false, tostring(result)
    end

    return true, result
end

local function getBucksBalance()
    local success, value = pcall(function()
        return DataClient:get({"Items", "Bucks"})
    end)

    if not success then
        return 0
    end

    return getComparableValue(value)
end

local function getBucksUpgradeInfo()
    local level = 0

    pcall(function()
        level = math.max(0, math.floor(safeNumber(
            DataClient:get({"Upgrades", "MiningUpgrades", "Bucks"})
        ) or 0))
    end)

    local upgrade = MiningUpgradesData
        and MiningUpgradesData.upgrades
        and MiningUpgradesData.upgrades.Bucks

    if not upgrade then
        return {
            Level = level,
            Cap = 0,
            Cost = nil,
            Maxed = true
        }
    end

    local cap = 15
    pcall(function()
        if type(upgrade.cap) == "function" then
            cap = safeNumber(upgrade:cap(DataClient)) or cap
        end
    end)

    cap = math.max(0, math.floor(cap))

    local cost = nil
    if level < cap
        and upgrade.cost
        and type(upgrade.cost.values) == "table" then
        cost = getComparableValue(upgrade.cost.values[level + 1])
    end

    return {
        Level = level,
        Cap = cap,
        Cost = cost,
        Maxed = level >= cap
    }
end

local function getNextRankPurchaseInfo()
    local rankIndex = getCurrentRankIndex()
    if not rankIndex then
        return nil
    end

    local currentRank = nil
    local nextRank = nil

    pcall(function()
        currentRank = MiningInfo:getRank(rankIndex)
        nextRank = MiningInfo:getRank(rankIndex + 1)
    end)

    if not nextRank then
        return nil
    end

    return {
        CurrentIndex = rankIndex,
        CurrentName = currentRank and tostring(currentRank.name) or ("Rank " .. tostring(rankIndex)),
        Name = tostring(nextRank.name or ("Rank " .. tostring(rankIndex + 1))),
        Cost = getComparableValue(nextRank.cost),
        UnlocksLayer = currentRank
            and safeNumber(nextRank.layers)
            and safeNumber(currentRank.layers)
            and safeNumber(nextRank.layers) > safeNumber(currentRank.layers)
            or false
    }
end

local function getSellableInventorySummary()
    local itemCount = 0
    local estimatedBucks = 0
    local boost = 1

    pcall(function()
        boost = getComparableValue(DataClient:get({"Boosts", "Mining_Bucks"}))
    end)

    if boost <= 0 then
        boost = 1
    end

    local allBlocks = nil
    pcall(function()
        allBlocks = MiningInfo:getAllBlocks()
    end)

    if type(allBlocks) ~= "table" then
        return 0, 0
    end

    for blockId, blockInfo in pairs(allBlocks) do
        if blockInfo
            and blockInfo.item
            and not blockInfo.hide then

            local locked = false
            pcall(function()
                locked = DataClient:get({"Mining", "Ores", blockId, "locked"}) == true
            end)

            if not locked then
                local amount = 0
                pcall(function()
                    amount = getComparableValue(DataClient:get({"Items", blockInfo.item}))
                end)

                if amount > 0 then
                    itemCount = itemCount + amount
                    estimatedBucks = estimatedBucks
                        + amount * getComparableValue(blockInfo.value) * boost
                end
            end
        end
    end

    return itemCount, estimatedBucks
end

local function sellAllOresNow(ignoreToggle)
    if not ignoreToggle and not AUTO_SELL_ORES then
        return false, "Auto Sell disabled"
    end

    local itemCount = getSellableInventorySummary()
    if itemCount <= 0 then
        return false, "No sellable ores"
    end

    local ok, result = invokeGameNetwork("SellAllOres")
    if not ok then
        LastProgressionError = tostring(result)
        return false, result
    end

    LastAutoSellAt = os.clock()
    LastProgressionAction = "Sold all unlocked ores"
    LastProgressionError = "-"
    Stats.AutoSells = (Stats.AutoSells or 0) + 1
    return true, result
end

local function buyOneBucksUpgrade(ignoreToggle)
    if not ignoreToggle and not AUTO_BUCKS_UPGRADE then
        return false, "Auto Bucks Upgrade disabled"
    end

    local before = getBucksUpgradeInfo()
    if before.Maxed then
        return false, "Bucks upgrade maxed"
    end

    local bucks = getBucksBalance()
    if not before.Cost or bucks < before.Cost then
        return false, "Not enough Bucks"
    end

    local ok, result = invokeGameNetwork("BuyUpgrade", "MiningUpgrades", "Bucks")
    if not ok then
        LastProgressionError = tostring(result)
        return false, result
    end

    task.wait(PROGRESSION_BUY_DELAY)

    local after = getBucksUpgradeInfo()
    if after.Level > before.Level then
        Stats.BucksUpgradesBought = (Stats.BucksUpgradesBought or 0) + (after.Level - before.Level)
        LastProgressionAction = "Bucks Upgrade " .. tostring(before.Level) .. " -> " .. tostring(after.Level)
        LastProgressionError = "-"
        return true, result
    end

    return false, "Upgrade level did not change"
end

local function buyNextRankNow(ignoreToggle)
    if not ignoreToggle and not AUTO_RANK_UP then
        return false, "Auto Rank disabled"
    end

    local beforeRank = getCurrentRankIndex()
    local nextInfo = getNextRankPurchaseInfo()

    if not beforeRank or not nextInfo then
        return false, "Rank maxed or unavailable"
    end

    if getBucksBalance() < (nextInfo.Cost or math.huge) then
        return false, "Not enough Bucks"
    end

    local ok, result = invokeGameNetwork("BuyNextRank")
    if not ok then
        LastProgressionError = tostring(result)
        return false, result
    end

    task.wait(PROGRESSION_BUY_DELAY)

    local afterRank = getCurrentRankIndex()
    if afterRank and afterRank > beforeRank then
        Stats.RanksBought = (Stats.RanksBought or 0) + (afterRank - beforeRank)
        LastProgressionAction = "Rank Up: " .. tostring(nextInfo.Name)
        LastProgressionError = "-"
        return true, result
    end

    return false, "Rank did not change"
end

local function chooseProgressionPurchase()
    local bucks = getBucksBalance()
    local upgrade = getBucksUpgradeInfo()
    local rank = getNextRankPurchaseInfo()

    local canUpgrade = AUTO_BUCKS_UPGRADE
        and not upgrade.Maxed
        and upgrade.Cost
        and bucks >= upgrade.Cost

    local canRank = AUTO_RANK_UP
        and rank
        and rank.Cost
        and bucks >= rank.Cost

    if PROGRESSION_PRIORITY == "Rank First" then
        if canRank then return "rank" end
        if canUpgrade then return "upgrade" end
        return nil
    end

    if PROGRESSION_PRIORITY == "Bucks Upgrade First" then
        if canUpgrade then return "upgrade" end
        if canRank then return "rank" end
        return nil
    end

    -- Smart:
    -- 1) Take an affordable rank immediately when it unlocks a new layer.
    -- 2) Buy cheap Bucks multiplier upgrades when they cost <= 20% of the next rank.
    -- 3) Otherwise prefer an affordable rank, then the Bucks upgrade.
    if canRank and rank.UnlocksLayer then
        return "rank"
    end

    if canUpgrade then
        if not rank or not rank.Cost then
            return "upgrade"
        end

        if upgrade.Cost <= rank.Cost * 0.20 then
            return "upgrade"
        end

        if bucks >= rank.Cost + upgrade.Cost then
            return "upgrade"
        end
    end

    if canRank then
        return "rank"
    end

    if canUpgrade then
        return "upgrade"
    end

    return nil
end

local function runProgressionTick()
    if ProgressionBusy then
        return
    end

    ProgressionBusy = true

    local ok, err = pcall(function()
        local now = os.clock()

        if AUTO_SELL_ORES
            and (now - LastAutoSellAt) >= AUTO_SELL_INTERVAL then
            local sold = sellAllOresNow(false)
            if sold then
                task.wait(PROGRESSION_BUY_DELAY)
            end
        end

        local action = chooseProgressionPurchase()

        if action == "rank" then
            buyNextRankNow(false)
        elseif action == "upgrade" then
            local bought = 0

            while bought < PROGRESSION_MAX_UPGRADES_PER_TICK do
                local success = buyOneBucksUpgrade(false)
                if not success then
                    break
                end

                bought = bought + 1

                -- Re-evaluate after each purchase. A rank may now be the smarter spend.
                if chooseProgressionPurchase() ~= "upgrade" then
                    break
                end
            end
        end
    end)

    if not ok then
        LastProgressionError = tostring(err)
        warn("SmartOreMiner progression error:", err)
    end

    ProgressionBusy = false
end

local function getEffectiveDepthRange()
    local requestedStart = safeNumber(START_DEPTH) or 0
    local requestedEnd = safeNumber(END_DEPTH) or MIN_DEPTH
    local rankLimit = safeNumber(RANK_MAX_DEPTH) or MIN_DEPTH

    local topDepth = math.max(requestedStart, requestedEnd)
    local bottomDepth = math.min(requestedStart, requestedEnd)

    topDepth = math.max(topDepth, rankLimit)
    bottomDepth = math.max(bottomDepth, rankLimit)

    topDepth = math.clamp(topDepth, MIN_DEPTH, 0)
    bottomDepth = math.clamp(bottomDepth, MIN_DEPTH, 0)

    if bottomDepth > topDepth then
        bottomDepth = topDepth
    end

    return topDepth, bottomDepth
end

local function validDepth(y)
    y = safeNumber(y)
    if y == nil then
        return false
    end
    return y <= 0 and y >= MIN_DEPTH and y >= RANK_MAX_DEPTH
end

local function inFarmDepth(y)
    y = safeNumber(y)
    if not validDepth(y) then
        return false
    end

    local startDepth, endDepth = getEffectiveDepthRange()
    return y <= startDepth and y >= endDepth
end


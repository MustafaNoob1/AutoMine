local YByName = {}

local NonBedrockByY = {}
local StoneByY = {}
local SelectedByY = {}


--------------------------------------------------
-- BUCKET ADD
--------------------------------------------------

local function addToBucket(
    map,
    y,
    name
)

    y =
        safeNumber(y)

    if y == nil then
        return
    end


    if not map[y] then
        map[y] = {}
    end


    map[y][name] = true

end


--------------------------------------------------
-- BUCKET REMOVE
--------------------------------------------------

local function removeFromBucket(
    map,
    y,
    name
)

    y =
        safeNumber(y)

    if y == nil
        or not map[y] then

        return

    end


    map[y][name] = nil


    if next(map[y]) == nil then
        map[y] = nil
    end

end


--------------------------------------------------
-- REMOVE NAME
--------------------------------------------------

local function removeIndexedName(name)

    local y =
        safeNumber(
            YByName[name]
        )


    removeFromBucket(
        NonBedrockByY,
        y,
        name
    )


    removeFromBucket(
        StoneByY,
        y,
        name
    )


    removeFromBucket(
        SelectedByY,
        y,
        name
    )


    ModelsByName[name] = nil
    YByName[name] = nil

end


--------------------------------------------------
-- REGISTER BLOCK
--------------------------------------------------

local function registerBlock(block)

    if not block
        or not block.Parent then

        return
    end


    local name =
        tostring(
            block.Name
        )


    BlockedTargets[name] = nil


    --------------------------------------------------
    -- WAIT FOR BLOCK DATA
    --------------------------------------------------

    local data =
        getBlockDataByName(name)


    if not data then

        for _ = 1, 10 do

            task.wait()

            data =
                getBlockDataByName(name)

            if data then
                break
            end

        end

    end


    if not data then
        return
    end


    --------------------------------------------------
    -- COORDINATES
    --------------------------------------------------

    local _, y, _ =
        getCoordinatesFromName(
            name
        )


    y =
        safeNumber(y)


    if not validDepth(y) then
        return
    end


    --------------------------------------------------
    -- INFO
    --------------------------------------------------

    local info =
        getBlockInfoByName(name)


    if not info then
        return
    end


    --------------------------------------------------
    -- REMOVE OLD CLASSIFICATION
    --------------------------------------------------

    if ModelsByName[name] then

        removeIndexedName(
            name
        )

    end


    --------------------------------------------------
    -- STORE
    --------------------------------------------------

    ModelsByName[name] =
        block

    YByName[name] =
        y


    if not isBedrock(info) then

        addToBucket(
            NonBedrockByY,
            y,
            name
        )

    end


    if isStone(info) then

        addToBucket(
            StoneByY,
            y,
            name
        )

    end


    if isSelectedOre(info) then

        addToBucket(
            SelectedByY,
            y,
            name
        )

    end

end


--------------------------------------------------
-- UNREGISTER BLOCK
--------------------------------------------------

local function unregisterBlock(block)

    if not block then
        return
    end


    local name =
        tostring(
            block.Name
        )


    -- Prevent old model from deleting new replacement
    if ModelsByName[name] ~= block then
        return
    end


    removeIndexedName(
        name
    )

end


--------------------------------------------------
-- CLEAR INDEX
--------------------------------------------------

local function clearIndex()

    ModelsByName = {}
    YByName = {}

    NonBedrockByY = {}
    StoneByY = {}
    SelectedByY = {}

end


--------------------------------------------------
-- DISCONNECT FOLDER
--------------------------------------------------

local function disconnectFolder()

    for _, connection in ipairs(
        FolderConnections
    ) do

        pcall(function()
            connection:Disconnect()
        end)

    end


    FolderConnections = {}

end


--------------------------------------------------
-- RESCAN
--------------------------------------------------

local function rescanMine()

    local folder =
        MiningServiceClient.mineFolder


    if not folder then
        return false
    end


    for _, block in ipairs(
        folder:GetChildren()
    ) do

        if block
            and block.Parent then


            local name =
                tostring(
                    block.Name
                )


            if ModelsByName[name]
                ~= block then

                registerBlock(
                    block
                )

            end

        end

    end


    return true

end


--------------------------------------------------
-- SETUP INDEX
--------------------------------------------------

local function setupIndex()

    local folder =
        MiningServiceClient.mineFolder


    if not folder then
        return false
    end


    if IndexedFolder == folder then
        return true
    end


    disconnectFolder()
    clearIndex()


    IndexedFolder =
        folder


    rescanMine()


    --------------------------------------------------
    -- CHILD ADDED
    --------------------------------------------------

    table.insert(
        FolderConnections,

        folder.ChildAdded:Connect(
            function(block)

                task.defer(function()

                    registerBlock(
                        block
                    )

                end)

            end
        )
    )


    --------------------------------------------------
    -- CHILD REMOVED
    --------------------------------------------------

    table.insert(
        FolderConnections,

        folder.ChildRemoved:Connect(
            function(block)

                unregisterBlock(
                    block
                )

            end
        )
    )


    return true

end


--------------------------------------------------
-- REBUILD EVERYTHING
--------------------------------------------------

local function rebuildWholeIndex()

    clearIndex()

    rescanMine()

end


--------------------------------------------------
-- REBUILD SELECTED
--------------------------------------------------

local function rebuildSelectedIndex()

    SelectedByY = {}


    for name, model in pairs(
        ModelsByName
    ) do

        if model
            and model.Parent then


            local y =
                safeNumber(
                    YByName[name]
                )


            local info =
                getBlockInfoByName(
                    name
                )


            if y ~= nil
                and validDepth(y)
                and info
                and isSelectedOre(info) then

                addToBucket(
                    SelectedByY,
                    y,
                    name
                )

            end

        end

    end

end


--------------------------------------------------
-- CLEAN BUCKET
--------------------------------------------------

local function cleanBucket(bucket)

    if not bucket then
        return false
    end


    for name in pairs(
        bucket
    ) do

        local model =
            ModelsByName[name]


        local data =
            getBlockDataByName(
                name
            )


        if BlockedTargets[name]
            or not model
            or not model.Parent
            or not data
            or data[1] == "None" then

            bucket[name] = nil

        end

    end


    return next(bucket) ~= nil

end


--------------------------------------------------
-- DEEPEST Y
--------------------------------------------------

local function deepestY(
    map,
    maxY,
    minY
)

    maxY =
        safeNumber(maxY)

    minY =
        safeNumber(minY)


    local result =
        nil


    for rawY, bucket in pairs(
        map
    ) do

        local y =
            safeNumber(
                rawY
            )


        if y ~= nil
            and validDepth(y) then


            local allowed = true


            if maxY ~= nil then
                allowed = allowed
                    and y <= maxY
            end


            if minY ~= nil then
                allowed = allowed
                    and y >= minY
            end


            if allowed
                and cleanBucket(
                    bucket
                ) then


                if result == nil
                    or y < result then

                    result = y

                end

            end

        end

    end


    return result

end


--------------------------------------------------
-- PLAYER GRID
--------------------------------------------------

local function getPlayerGridPosition()

    local character =
        LocalPlayer.Character


    if not character then
        return DEFAULT_X, DEFAULT_Z
    end


    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )


    if not root then
        return DEFAULT_X, DEFAULT_Z
    end


    local origin =
        MiningServiceClient.originPosition


    if not origin then
        return DEFAULT_X, DEFAULT_Z
    end


    local x =
        math.round(
            (
                root.Position.X
                - origin.X
            ) / 6
        )


    local z =
        math.round(
            (
                root.Position.Z
                - origin.Z
            ) / 6
        )


    return x, z

end


--------------------------------------------------
-- PICK NEAREST
--------------------------------------------------

local function pickNearest(
    bucket,
    targetX,
    targetZ
)

    if not bucket then
        return nil
    end


    targetX =
        safeNumber(targetX)
        or DEFAULT_X


    targetZ =
        safeNumber(targetZ)
        or DEFAULT_Z


    local bestName =
        nil


    local bestDistance =
        math.huge


    for name in pairs(
        bucket
    ) do

        if not BlockedTargets[name] then


            local model =
                ModelsByName[name]


            local y =
                safeNumber(
                    YByName[name]
                )


            if model
                and model.Parent
                and validDepth(y) then


                local x, _, z =
                    getCoordinatesFromName(
                        name
                    )


                x = safeNumber(x)
                z = safeNumber(z)


                if x ~= nil
                    and z ~= nil then


                    local dx =
                        x - targetX


                    local dz =
                        z - targetZ


                    local distance =
                        dx * dx
                        + dz * dz


                    if distance < bestDistance then

                        bestDistance =
                            distance

                        bestName =
                            name

                    end

                end

            end

        end

    end


    return bestName

end


--------------------------------------------------
-- MODEL POSITION
--------------------------------------------------

local function getModelPosition(model)

    if not model then
        return nil
    end


    if model:IsA("BasePart") then
        return model.Position
    end


    local success, pivot =
        pcall(function()

            return model:GetPivot()

        end)


    if success
        and pivot then

        return pivot.Position

    end


    return nil

end


--------------------------------------------------
-- FOLLOW TARGET
--------------------------------------------------

local function moveNearTarget(model)

    if not FOLLOW_TARGET then
        return true
    end


    if not model
        or not model.Parent then

        return false
    end


    local character =
        LocalPlayer.Character


    if not character then
        return false
    end


    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )


    if not root then
        return false
    end


    local targetPosition =
        getModelPosition(
            model
        )


    if not targetPosition then
        return false
    end


    local distance =
        (
            root.Position
            - targetPosition
        ).Magnitude


    if distance <= TARGET_DISTANCE then
        return true
    end


    local destination =
        targetPosition
        + Vector3.new(
            0,
            8,
            0
        )


    local look =
        root.CFrame.LookVector


    local success =
        pcall(function()


            character:PivotTo(
                CFrame.new(
                    destination,
                    destination + look
                )
            )


            root.AssemblyLinearVelocity =
                Vector3.zero


            root.AssemblyAngularVelocity =
                Vector3.zero

        end)


    task.wait()


    return success

end


--------------------------------------------------
-- MINING SPEED
--------------------------------------------------

local function getMiningSpeed()

    local success, value =
        pcall(function()

            return DataClient:get({
                "Boosts",
                "Mining_Speed"
            })

        end)


    if not success then
        return 0
    end


    return math.max(
        safeNumber(value)
        or 0,

--------------------------------------------------
-- SAFE NUMBER
--------------------------------------------------

local function safeNumber(value)

    if value == nil then
        return nil
    end

    return tonumber(value)

end


--------------------------------------------------
-- CURRENT RANK
--------------------------------------------------

local function getCurrentRankIndex()

    local success, result =
        pcall(function()

            return DataClient:get({
                "Mining",
                "Rank"
            })

        end)

    if not success then
        return nil
    end

    return safeNumber(result)

end


--------------------------------------------------
-- RANK DEPTH INFO
--------------------------------------------------

local function getRankDepthInfo()

    local rankIndex =
        getCurrentRankIndex()

    if not rankIndex then
        return nil
    end


    local success, rankInfo =
        pcall(function()

            return MiningInfo:getRank(
                rankIndex
            )

        end)

    if not success or not rankInfo then
        return nil
    end


    local unlockedLayers =
        safeNumber(
            rankInfo.layers
        )

    if not unlockedLayers then
        return nil
    end


    local layers =
        MiningInfo._layers

    if not layers then
        return nil
    end


    local nextLayer =
        layers[
            unlockedLayers + 1
        ]


    local maxDepth =
        MIN_DEPTH

    local nextBoundary =
        nil


    if nextLayer then

        local depth =
            safeNumber(
                nextLayer.depth
            )

        if depth then

            -- Example:
            -- next layer starts at 150
            -- current rank can mine through -149

            maxDepth =
                -(depth - 1)

            nextBoundary =
                -depth

        end

    end


    maxDepth =
        math.max(
            MIN_DEPTH,
            maxDepth
        )


    return {
        RankIndex = rankIndex,

        Name =
            tostring(
                rankInfo.name
                or ("Rank " .. tostring(rankIndex))
            ),

        Layers =
            unlockedLayers,

        MaxDepth =
            maxDepth,

        NextBoundary =
            nextBoundary
    }

end


--------------------------------------------------
-- REFRESH RANK
--------------------------------------------------

local function refreshRankDepth()

    local info =
        getRankDepthInfo()

    if not info then

        RANK_MAX_DEPTH =
            MIN_DEPTH

        return nil

    end


    RANK_MAX_DEPTH =
        safeNumber(
            info.MaxDepth
        )
        or MIN_DEPTH


    return info

end


--------------------------------------------------
-- EFFECTIVE FARM RANGE
--------------------------------------------------

local function getEffectiveDepthRange()

    local requestedStart =
        safeNumber(
            START_DEPTH
        )
        or 0


    local requestedEnd =
        safeNumber(
            END_DEPTH
        )
        or MIN_DEPTH


    --------------------------------------------------
    -- Automatically normalize:
    --
    -- Start -500 / End -501
    -- =>
    -- Top    -500
    -- Bottom -501
    --------------------------------------------------

    local topDepth =
        math.max(
            requestedStart,
            requestedEnd
        )


    local bottomDepth =
        math.min(
            requestedStart,
            requestedEnd
        )


    --------------------------------------------------
    -- APPLY RANK LIMIT
    --------------------------------------------------

    local rankLimit =
        safeNumber(
            RANK_MAX_DEPTH
        )
        or MIN_DEPTH


    topDepth =
        math.max(
            topDepth,
            rankLimit
        )


    bottomDepth =
        math.max(
            bottomDepth,
            rankLimit
        )


    --------------------------------------------------
    -- HARD LIMIT
    --------------------------------------------------

    topDepth =
        math.clamp(
            topDepth,
            MIN_DEPTH,
            0
        )


    bottomDepth =
        math.clamp(
            bottomDepth,
            MIN_DEPTH,
            0
        )


    if bottomDepth > topDepth then
        bottomDepth = topDepth
    end


    return
        topDepth,
        bottomDepth

end


--------------------------------------------------
-- COORDINATES
--------------------------------------------------

local function getCoordinatesFromName(name)

    if name == nil then
        return nil, nil, nil
    end


    name =
        tostring(name)


    --------------------------------------------------
    -- ORIGINAL GAME FUNCTION
    --------------------------------------------------

    local success, x, y, z =
        pcall(function()

            return
                MiningInfo:
                getCoordinatesFromBlockName(
                    name
                )

        end)


    if success then

        x = safeNumber(x)
        y = safeNumber(y)
        z = safeNumber(z)


        if x ~= nil
            and y ~= nil
            and z ~= nil then

            return x, y, z

        end

    end


    --------------------------------------------------
    -- FALLBACK
    --------------------------------------------------

    local sx, sy, sz =
        name:match(
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )


    return
        safeNumber(sx),
        safeNumber(sy),
        safeNumber(sz)

end


--------------------------------------------------
-- VALID DEPTH
--------------------------------------------------

local function validDepth(y)

    y =
        safeNumber(y)

    if y == nil then
        return false
    end


    if y > 0 then
        return false
    end


    if y < MIN_DEPTH then
        return false
    end


    if y < RANK_MAX_DEPTH then
        return false
    end


    return true

end


--------------------------------------------------
-- FARM RANGE CHECK
--------------------------------------------------

local function inFarmDepth(y)

    y =
        safeNumber(y)

    if not validDepth(y) then
        return false
    end


    local startDepth,
        endDepth =

        getEffectiveDepthRange()


    return
        y <= startDepth
        and y >= endDepth

end


--------------------------------------------------
-- ORE SELECTION
--------------------------------------------------

local SelectedOres = {}


--------------------------------------------------
-- BLOCK DATA
--------------------------------------------------

local function getBlockDataByName(name)

    if name == nil then
        return nil
    end


    if not MiningServiceClient.blocks then
        return nil
    end


    return MiningServiceClient.blocks[
        tostring(name)
    ]

end


--------------------------------------------------
-- BLOCK INFO
--------------------------------------------------

local function getBlockInfoByName(name)

    local data =
        getBlockDataByName(name)

    if not data then
        return nil
    end


    local id =
        data[1]


    if id == nil
        or id == "None" then

        return nil

    end


    local success, info =
        pcall(function()

            return MiningInfo:getBlock(
                id
            )

        end)


    if not success
        or not info then

        return nil

    end


    return {
        Id = id,
        Name = info.name,
        HP = info.hp,
        Value = info.value,
        Model = info.model
    }

end


--------------------------------------------------
-- STONE
--------------------------------------------------

local function isStone(info)

    if not info then
        return false
    end


    return string.match(
        tostring(info.Id),
        "^StoneOre%d*$"
    ) ~= nil

end


--------------------------------------------------
-- BEDROCK
--------------------------------------------------

local function isBedrock(info)

    if not info then
        return false
    end


    return tostring(
        info.Id
    ) == "Bedrock"

end


--------------------------------------------------
-- SELECTED ORE
--------------------------------------------------

local function isSelectedOre(info)

    if not info then
        return false
    end


    if isStone(info)
        or isBedrock(info) then

        return false

    end


    return SelectedOres[
        info.Id
    ] == true

end


--------------------------------------------------
-- VALUE CONVERSION
--------------------------------------------------

local function getComparableValue(value)

    if value == nil then
        return 0
    end


    local success, result =
        pcall(function()

            return
                EternityNum.bnumtofloat(
                    value
                )

        end)


    if success then

        result =
            safeNumber(result)

        if result ~= nil then
            return result
        end

    end


    return safeNumber(value) or 0

end



--------------------------------------------------
-- SAFE NUMBER
--------------------------------------------------

local function safeNumber(value)

    if value == nil then
        return nil
    end

    return tonumber(value)

end


--------------------------------------------------
-- RANK SYSTEM
--------------------------------------------------

local function getCurrentRankIndex()

    local success, result =
        pcall(function()

            return DataClient:get({
                "Mining",
                "Rank"
            })

        end)

    if not success then
        return nil
    end

    return safeNumber(result)

end


--------------------------------------------------
-- GET RANK DEPTH INFO
--------------------------------------------------

local function getRankDepthInfo()

    local rankIndex =
        getCurrentRankIndex()

    if not rankIndex then
        return nil
    end


    --------------------------------------------------
    -- RANK DATA
    --------------------------------------------------

    local success, rankInfo =
        pcall(function()

            return
                MiningInfo:getRank(
                    rankIndex
                )

        end)

    if not success
        or not rankInfo then

        return nil

    end


    local unlockedLayers =
        safeNumber(
            rankInfo.layers
        )

    if not unlockedLayers then
        return nil
    end


    --------------------------------------------------
    -- LAYER DATA
    --------------------------------------------------

    local layers =
        MiningInfo._layers

    if not layers then
        return nil
    end


    --------------------------------------------------
    -- NEXT LOCKED LAYER
    --------------------------------------------------

    local nextLayer =
        layers[
            unlockedLayers + 1
        ]


    local maxDepth =
        MIN_DEPTH

    local nextBoundary =
        nil


    if nextLayer
        and safeNumber(
            nextLayer.depth
        ) then


        local depth =
            safeNumber(
                nextLayer.depth
            )


        --------------------------------------------------
        -- Example:
        --
        -- Next Layer = 150
        --
        -- Last allowed Y = -149
        --------------------------------------------------

        maxDepth =
            -(depth - 1)

        nextBoundary =
            -depth

    end


    --------------------------------------------------
    -- NEVER GO BEYOND BEDROCK
    --------------------------------------------------

    maxDepth =
        math.max(
            MIN_DEPTH,
            maxDepth
        )


    return {

        RankIndex =
            rankIndex,

        Name =
            rankInfo.name
            or (
                "Rank "
                .. tostring(
                    rankIndex
                )
            ),

        Layers =
            unlockedLayers,

        MaxDepth =
            maxDepth,

        NextBoundary =
            nextBoundary

    }

end


--------------------------------------------------
-- REFRESH RANK LIMIT
--------------------------------------------------

local function refreshRankDepth()

    local info =
        getRankDepthInfo()


    if not info then

        RANK_MAX_DEPTH =
            MIN_DEPTH

        return nil

    end


    RANK_MAX_DEPTH =
        safeNumber(
            info.MaxDepth
        )
        or MIN_DEPTH


    return info

end


--------------------------------------------------
-- EFFECTIVE START DEPTH
--------------------------------------------------

local function getEffectiveStartDepth()

    local requested =
        safeNumber(
            START_DEPTH
        )
        or 0


    local rankLimit =
        safeNumber(
            RANK_MAX_DEPTH
        )
        or MIN_DEPTH


    --------------------------------------------------
    -- Example:
    --
    -- User: -3000
    -- Rank: -149
    --
    -- Effective = -149
    --------------------------------------------------

    return
        math.max(
            requested,
            rankLimit
        )

end


--------------------------------------------------
-- BLOCK COORDINATES
--------------------------------------------------

local function getCoordinatesFromName(name)

    if name == nil then
        return nil, nil, nil
    end


    name =
        tostring(name)


    --------------------------------------------------
    -- GAME FUNCTION FIRST
    --------------------------------------------------

    local success,
        x,
        y,
        z =

        pcall(function()

            return
                MiningInfo:
                getCoordinatesFromBlockName(
                    name
                )

        end)


    if success then

        x = safeNumber(x)
        y = safeNumber(y)
        z = safeNumber(z)


        if x ~= nil
            and y ~= nil
            and z ~= nil then


            return
                x,
                y,
                z

        end

    end


    --------------------------------------------------
    -- FALLBACK
    --------------------------------------------------

    local sx,
        sy,
        sz =

        string.match(
            name,
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )


    return
        safeNumber(sx),
        safeNumber(sy),
        safeNumber(sz)

end


--------------------------------------------------
-- VALID DEPTH
--------------------------------------------------

local function validDepth(y)

    y =
        safeNumber(y)

    if y == nil then
        return false
    end


    --------------------------------------------------
    -- ABOVE SURFACE
    --------------------------------------------------

    if y > 0 then
        return false
    end


    --------------------------------------------------
    -- BEDROCK LIMIT
    --------------------------------------------------

    if y < MIN_DEPTH then
        return false
    end


    --------------------------------------------------
    -- PLAYER RANK LIMIT
    --------------------------------------------------

    if y < RANK_MAX_DEPTH then
        return false
    end


    return true

end


--------------------------------------------------
-- FARM DEPTH
--------------------------------------------------

local function inFarmDepth(y)

    y =
        safeNumber(y)

    if not validDepth(y) then
        return false
    end


    local effective =
        getEffectiveStartDepth()


    return
        y <= effective
        and y >= RANK_MAX_DEPTH

end



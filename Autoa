local MultiDropdown =
    Tabs.Main:AddDropdown(
        "OreSelection",
        {

            Title =
                "Select Ores",

            Description =
                "Selected ores are mined first.",

            Values =
                OreValues,

            Multi =
                true,

            Default =
                {}

        }
    )


--------------------------------------------------
-- ORE SELECTION
--------------------------------------------------

MultiDropdown:OnChanged(
    function(values)


        SelectedOres =
            {}


        for name, enabled in pairs(
            values
        ) do


            if enabled then


                for id, data in pairs(
                    BlocksData
                ) do


                    local displayName =
                        id


                    if type(data)
                        == "table" then


                        displayName =
                            data.name
                            or data.Name
                            or id

                    end


                    if displayName
                        == name then


                        SelectedOres[id] =
                            true


                        break

                    end

                end

            end

        end


        rebuildSelectedIndex()

    end
)


--------------------------------------------------
-- START DEPTH INPUT
--------------------------------------------------

Tabs.Main:AddInput(
    "StartDepth",
    {

        Title =
            "Start Depth",

        Description =
            "Farm selected ores from this depth downward.",

        Default =
            "0",

        Placeholder =
            "-3000",

        Numeric =
            false,

        Finished =
            true,

        Callback =
            function(value)


                local number =
                    tonumber(
                        value
                    )


                if number == nil then


                    Fluent:Notify({

                        Title =
                            "Start Depth",

                        Content =
                            "Example: -3000",

                        Duration =
                            2

                    })


                    return

                end


                START_DEPTH =
                    math.clamp(
                        math.round(
                            number
                        ),
                        MIN_DEPTH,
                        0
                    )


                rebuildSelectedIndex()


                Fluent:Notify({

                    Title =
                        "Start Depth",

                    Content =
                        "Start Depth = "
                        .. tostring(
                            START_DEPTH
                        ),

                    Duration =
                        2

                })


                --------------------------------------------------
                -- RESTART IF RUNNING
                --------------------------------------------------

                if AutoMine then


                    RunId =
                        RunId + 1


                    local run =
                        RunId


                    startMining(
                        run
                    )

                end

            end

    }
)



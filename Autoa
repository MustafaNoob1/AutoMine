        return nil

    end


    RANK_MAX_DEPTH =
        safeNumber(
            info.MaxDepth
        )
        or MIN_DEPTH


    return info

end


--------------------------------------------------
-- EFFECTIVE DEPTH RANGE
--------------------------------------------------

local function getEffectiveDepthRange()

    local requestedStart =
        safeNumber(
            START_DEPTH
        )
        or 0


    local requestedEnd =
        safeNumber(
            END_DEPTH
        )
        or MIN_DEPTH


    local rankLimit =
        safeNumber(
            RANK_MAX_DEPTH
        )
        or MIN_DEPTH


    --------------------------------------------------
    -- NORMALIZE
    --
    -- -500 / -501
    --
    -- TOP    = -500
    -- BOTTOM = -501
    --------------------------------------------------

    local topDepth =
        math.max(
            requestedStart,
            requestedEnd
        )


    local bottomDepth =
        math.min(
            requestedStart,
            requestedEnd
        )


    --------------------------------------------------
    -- RANK LIMIT
    --------------------------------------------------

    topDepth =
        math.max(
            topDepth,
            rankLimit
        )


    bottomDepth =
        math.max(
            bottomDepth,
            rankLimit
        )


    --------------------------------------------------
    -- GAME LIMIT
    --------------------------------------------------

    topDepth =
        math.clamp(
            topDepth,
            MIN_DEPTH,
            0
        )


    bottomDepth =
        math.clamp(
            bottomDepth,
            MIN_DEPTH,
            0
        )


    --------------------------------------------------
    -- SAFETY
    --------------------------------------------------

    if bottomDepth > topDepth then

        bottomDepth =
            topDepth

    end


    return
        topDepth,
        bottomDepth

end


--------------------------------------------------
-- EFFECTIVE START
--------------------------------------------------

local function getEffectiveStartDepth()

    local startDepth =
        getEffectiveDepthRange()


    return
        startDepth

end


--------------------------------------------------
-- EFFECTIVE END
--------------------------------------------------

local function getEffectiveEndDepth()

    local _,
        endDepth =

        getEffectiveDepthRange()


    return
        endDepth

end


--------------------------------------------------
-- BLOCK COORDINATES
--------------------------------------------------

local function getCoordinatesFromName(name)

    if name == nil then
        return nil, nil, nil
    end


    name =
        tostring(name)


    --------------------------------------------------
    -- GAME FUNCTION
    --------------------------------------------------

    local success,
        x,
        y,
        z =

        pcall(function()

            return
                MiningInfo:
                getCoordinatesFromBlockName(
                    name
                )

        end)


    if success then

        x =
            safeNumber(x)

        y =
            safeNumber(y)

        z =
            safeNumber(z)


        if x ~= nil
            and y ~= nil
            and z ~= nil then


            return
                x,
                y,
                z

        end

    end


    --------------------------------------------------
    -- FALLBACK
    --------------------------------------------------

    local sx,
        sy,
        sz =

        string.match(
            name,
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )


    return
        safeNumber(sx),
        safeNumber(sy),
        safeNumber(sz)

end


--------------------------------------------------
-- VALID DEPTH
--------------------------------------------------

local function validDepth(y)

    y =
        safeNumber(y)


    if y == nil then
        return false
    end


    --------------------------------------------------
    -- ABOVE SURFACE
    --------------------------------------------------

    if y > 0 then
        return false
    end


    --------------------------------------------------
    -- BEDROCK
    --------------------------------------------------

    if y < MIN_DEPTH then
        return false
    end


    --------------------------------------------------
    -- RANK
    --------------------------------------------------

    if y < RANK_MAX_DEPTH then
        return false
    end


    return true

end


--------------------------------------------------
-- INSIDE FARM RANGE
--------------------------------------------------

local function inFarmDepth(y)

    y =
        safeNumber(y)


    if not validDepth(y) then
        return false
    end


    local startDepth,
        endDepth =

        getEffectiveDepthRange()


    --------------------------------------------------
    -- EXAMPLE:
    --
    -- Start = -500
    -- End   = -501
    --
    -- ONLY:
    -- -500
    -- -501
    --------------------------------------------------

    return
        y <= startDepth
        and y >= endDepth

end



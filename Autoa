local function registerBlock(block)
    if not block or not block.Parent then
        return
    end

    local name = tostring(block.Name)
    BlockedTargets[name] = nil

    local data = getBlockDataByName(name)
    if not data then
        for _ = 1, 10 do
            task.wait()
            data = getBlockDataByName(name)
            if data then
                break
            end
        end
    end

    if not data then
        return
    end

    local _, y, _ = getCoordinatesFromName(name)
    y = safeNumber(y)

    if not validDepth(y) then
        return
    end

    local info = getBlockInfoByName(name)
    if not info then
        return
    end

    if ModelsByName[name] then
        removeIndexedName(name)
    end

    ModelsByName[name] = block
    YByName[name] = y

    if not isBedrock(info) then
        addToBucket(NonBedrockByY, y, name)
    end

    if isStone(info) then
        addToBucket(StoneByY, y, name)
    end

    if isSelectedOre(info) then
        addToBucket(SelectedByY, y, name)
    end

    maybeAlertRare(name, info, y)
end

local function unregisterBlock(block)
    if not block then
        return
    end

    local name = tostring(block.Name)
    if ModelsByName[name] ~= block then
        return
    end

    removeIndexedName(name)
end

local function clearIndex()
    ModelsByName = {}
    YByName = {}
    NonBedrockByY = {}
    StoneByY = {}
    SelectedByY = {}
end

local function disconnectFolder()
    for _, connection in ipairs(FolderConnections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    FolderConnections = {}
end

local function rescanMine()
    local folder = MiningServiceClient.mineFolder
    if not folder then
        return false
    end

    for _, block in ipairs(folder:GetChildren()) do
        if block and block.Parent then
            local name = tostring(block.Name)
            if ModelsByName[name] ~= block then
                registerBlock(block)
            end
        end
    end

    return true
end

local function setupIndex()
    local folder = MiningServiceClient.mineFolder
    if not folder then
        return false
    end

    if IndexedFolder == folder then
        return true
    end

    disconnectFolder()
    clearIndex()
    IndexedFolder = folder
    rescanMine()

    table.insert(FolderConnections, folder.ChildAdded:Connect(function(block)
        task.defer(function()
            registerBlock(block)
        end)
    end))

    table.insert(FolderConnections, folder.ChildRemoved:Connect(function(block)
        unregisterBlock(block)
    end))

    return true
end

local function rebuildWholeIndex()
    clearIndex()
    rescanMine()
end

local function rebuildSelectedIndex()
    SelectedByY = {}

    for name, model in pairs(ModelsByName) do
        if model and model.Parent then
            local y = safeNumber(YByName[name])
            local info = getBlockInfoByName(name)

            if y ~= nil and validDepth(y) and info and isSelectedOre(info) then
                addToBucket(SelectedByY, y, name)
            end
        end
    end
end

local function cleanBucket(bucket)
    if not bucket then
        return false
    end

    for name in pairs(bucket) do
        local model = ModelsByName[name]
        local data = getBlockDataByName(name)

        if BlockedTargets[name]
            or not model
            or not model.Parent
            or not data
            or data[1] == "None" then
            bucket[name] = nil
        end
    end

    return next(bucket) ~= nil
end

local function deepestY(map, maxY, minY)
    maxY = safeNumber(maxY)
    minY = safeNumber(minY)
    local result = nil

    for rawY, bucket in pairs(map) do
        local y = safeNumber(rawY)

        if y ~= nil and validDepth(y) then
            local allowed = true

            if maxY ~= nil then
                allowed = allowed and y <= maxY
            end

            if minY ~= nil then
                allowed = allowed and y >= minY
            end

            if allowed and cleanBucket(bucket) then
                if result == nil or y < result then
                    result = y
                end
            end
        end
    end

    return result
end


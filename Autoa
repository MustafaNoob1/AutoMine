-- SELECT ORES DROPDOWN
--------------------------------------------------

local MultiDropdown =
    Tabs.Main:AddDropdown(
        "OreSelection",
        {

            Title =
                "Select Ores",

            Description =
                "Choose which ores to mine.",

            Values =
                OreValues,

            Multi =
                true,

            Default =
                {}

        }
    )


--------------------------------------------------
-- UPDATE SELECTED ORES
--------------------------------------------------

MultiDropdown:OnChanged(
    function(values)


        SelectedOres = {}


        for name, enabled in pairs(
            values
        ) do


            if enabled then


                for id, data in pairs(
                    BlocksData
                ) do


                    local displayName =
                        id


                    if type(data)
                        == "table" then


                        displayName =
                            data.name
                            or data.Name
                            or id

                    end


                    if displayName
                        == name then


                        SelectedOres[id] =
                            true


                        break

                    end

                end

            end

        end


        --------------------------------------------------
        -- UPDATE FAST ORE CACHE
        --------------------------------------------------

        rebuildSelectedOreCache()

    end
)


--------------------------------------------------
-- START DEPTH INPUT
--------------------------------------------------

local StartDepthInput


StartDepthInput =
    Tabs.Main:AddInput(
        "StartDepth",
        {

            Title =
                "Start Depth",

            Description =
                "Mine from this level down to -4999.",

            Default =
                "0",

            Placeholder =
                "-3000",

            -- false because we validate it ourselves.
            -- This also makes entering '-' reliable.
            Numeric =
                false,

            -- Callback only after Enter is pressed.
            Finished =
                true,

            Callback =
                function(Value)


                    --------------------------------------------------
                    -- CONVERT INPUT
                    --------------------------------------------------

                    local number =
                        tonumber(Value)


                    if not number then


                        Fluent:Notify({
                            Title =
                                "Start Depth",

                            Content =
                                "Enter a number, for example -3000.",

                            Duration =
                                3
                        })


                        return

                    end


                    --------------------------------------------------
                    -- INTEGER
                    --------------------------------------------------

                    number =
                        math.round(number)


                    --------------------------------------------------
                    -- LIMIT:
                    -- MAX = 0
                    -- MIN = -4999
                    --------------------------------------------------

                    local newDepth =
                        math.clamp(
                            number,
                            MIN_DEPTH,
                            0
                        )


                    --------------------------------------------------
                    -- SAVE
                    --------------------------------------------------

                    START_DEPTH =
                        newDepth


                    --------------------------------------------------
                    -- UPDATE ORE CACHE
                    --------------------------------------------------

                    rebuildSelectedOreCache()


                    --------------------------------------------------
                    -- NOTIFICATION
                    --------------------------------------------------

                    Fluent:Notify({
                        Title =
                            "Start Depth",

                        Content =
                            "Mining will start at Y = "
                            .. tostring(START_DEPTH)
                            .. " and continue to "
                            .. tostring(MIN_DEPTH)
                            .. ".",

                        Duration =
                            3
                    })


                    --------------------------------------------------
                    -- IF MINER IS ALREADY RUNNING:
                    -- RESTART WITH NEW DEPTH
                    --------------------------------------------------

                    if AutoMine then


                        MiningRunId =
                            MiningRunId + 1


                        local runId =
                            MiningRunId


                        startMining(
                            runId
                        )

                    end

                end

        }
    )


--------------------------------------------------
-- AUTO MINE TOGGLE
--------------------------------------------------

local Toggle =
    Tabs.Main:AddToggle(
        "AutoMine",
        {

            Title =
                "Auto Mine",

            Description =
                "Mine from Start Depth to -4999.",

            Default =
                false

        }
    )


--------------------------------------------------
-- TOGGLE CHANGED
--------------------------------------------------

Toggle:OnChanged(
    function(value)


        --------------------------------------------------
        -- INVALIDATE OLD THREAD
        --------------------------------------------------

        MiningRunId =
            MiningRunId + 1


        AutoMine =
            value


        --------------------------------------------------
        -- START
        --------------------------------------------------

        if AutoMine then


            local runId =
                MiningRunId


            Fluent:Notify({
                Title =
                    "Fast Auto Mine",

                Content =
                    "Mining from Y = "
                    .. tostring(START_DEPTH)
                    .. " to "
                    .. tostring(MIN_DEPTH)
                    .. ".",

                Duration =
                    3
            })


            startMining(
                runId
            )


        --------------------------------------------------
        -- STOP
        --------------------------------------------------

        else


            Fluent:Notify({
                Title =
                    "Fast Auto Mine",

                Content =
                    "Mining stopped.",

                Duration =
                    2
            })

        end

    end
)



--------------------------------------------------
-- REACH START DEPTH
--------------------------------------------------
local function reachStartDepth(run)
    local anchorX, anchorZ = getPlayerGridPosition()
    local effectiveStart, effectiveEnd = getEffectiveDepthRange()

    Stats.Status = "Digging to range"

    if START_DEPTH < RANK_MAX_DEPTH or END_DEPTH < RANK_MAX_DEPTH then
        Fluent:Notify({
            Title = "Rank Depth Limit",
            Content = "Effective range: " .. tostring(effectiveStart) .. " to " .. tostring(effectiveEnd),
            Duration = 4
        })
    end

    Fluent:Notify({
        Title = "Depth Loader",
        Content = "Going to " .. tostring(effectiveStart),
        Duration = 2
    })

    while isRunning(run) do
        rescanMine()

        local currentDeepest = deepestY(NonBedrockByY, nil, effectiveEnd)
        currentDeepest = safeNumber(currentDeepest)

        if currentDeepest == nil then
            task.wait(0.05)
            continue
        end

        if currentDeepest <= effectiveStart then
            Stats.Status = "Farming range"
            Fluent:Notify({
                Title = "Farm Range Reached",
                Content = tostring(effectiveStart) .. " to " .. tostring(effectiveEnd),
                Duration = 3
            })
            return true, anchorX, anchorZ
        end

        local target, targetY = getFrontierTarget(anchorX, anchorZ)
        targetY = safeNumber(targetY)

        if not target or targetY == nil then
            task.wait(0.05)
            continue
        end

        if targetY < effectiveEnd or not validDepth(targetY) then
            BlockedTargets[target] = true
            task.wait()
            continue
        end

        local x, _, z = getCoordinatesFromName(target)
        x = safeNumber(x)
        z = safeNumber(z)

        if x ~= nil then
            anchorX = x
        end
        if z ~= nil then
            anchorZ = z
        end

        mineTarget(target, "any", run)
        task.wait()
        rescanMine()
    end

    return false
end

--------------------------------------------------
-- FARM LOOP
--------------------------------------------------
local function farmingLoop(run, anchorX, anchorZ)
    local counter = 0
    local completionNotified = false

    while isRunning(run) do
        local effectiveStart, effectiveEnd = getEffectiveDepthRange()
        rescanMine()

        local smartResetNow, smartResetReason = shouldSmartReset()
        if smartResetNow then
            Stats.Status = "Smart reset"
            Stats.LastResetReason = tostring(smartResetReason or "Smart reset")
            Fluent:Notify({
                Title = "Smart Reset",
                Content = Stats.LastResetReason,
                Duration = 3
            })
            return "reset"
        end

        -- Priority 1: selected ore according to chosen priority mode.
        local target = getSelectedTarget(anchorX, anchorZ)

        if target then
            completionNotified = false
            local x, _, z = getCoordinatesFromName(target)
            x = safeNumber(x)
            z = safeNumber(z)

            if x ~= nil then
                anchorX = x
            end
            if z ~= nil then
                anchorZ = z
            end

            Stats.CurrentSweepY = safeNumber(YByName[target])
            mineTarget(target, "selected", run)
            task.wait()
            rescanMine()
        else
            local sweepTarget = nil
            local sweepY = nil

            if SWEEP_MODE == "Full Layer" then
                sweepTarget, sweepY = getFullSweepTarget(anchorX, anchorZ)
            elseif SWEEP_MODE == "Valuable Ores + Reveal" then
                sweepTarget, sweepY = getRevealTarget(anchorX, anchorZ)
            elseif SWEEP_MODE == "Selected Ores Only" then
                sweepTarget, sweepY = nil, nil
            end

            sweepY = safeNumber(sweepY)

            if sweepTarget
                and sweepY ~= nil
                and sweepY <= effectiveStart
                and sweepY >= effectiveEnd
                and validDepth(sweepY) then
                completionNotified = false
                Stats.CurrentSweepY = sweepY

                local x, _, z = getCoordinatesFromName(sweepTarget)
                x = safeNumber(x)
                z = safeNumber(z)

                if x ~= nil then
                    anchorX = x
                end
                if z ~= nil then
                    anchorZ = z
                end

                mineTarget(sweepTarget, "any", run)
                task.wait()
                rescanMine()
            else
                Stats.CurrentSweepY = nil
                Stats.Status = "Range complete"

                if not completionNotified then
                    completionNotified = true
                    Fluent:Notify({
                        Title = "Farm Range Complete",
                        Content = AUTO_RESET_MINE and "Resetting mine..." or "No more targets in selected range.",
                        Duration = 3
                    })
                end

                if AUTO_RESET_MINE then
                    Stats.LastResetReason = "Range complete"
                    return "reset"
                end

                requestStop("Farm range complete")
                return "complete"
            end
        end

        counter = counter + 1
        if counter % 20 == 0 then
            rescanMine()
            rebuildSelectedIndex()
        end

        if checkStopConditions() then
            return "stopped"
        end
    end

    return "stopped"
end


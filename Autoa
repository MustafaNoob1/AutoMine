        return nil

    end


    RANK_MAX_DEPTH =
        safeNumber(
            info.MaxDepth
        )
        or MIN_DEPTH


    return info

end


--------------------------------------------------
-- EFFECTIVE FARM RANGE
--------------------------------------------------

local function getEffectiveDepthRange()

    local requestedStart =
        safeNumber(
            START_DEPTH
        )
        or 0


    local requestedEnd =
        safeNumber(
            END_DEPTH
        )
        or MIN_DEPTH


    --------------------------------------------------
    -- NORMALIZE
    --
    -- START -500
    -- END   -501
    --
    -- TOP    -500
    -- BOTTOM -501
    --------------------------------------------------

    local topDepth =
        math.max(
            requestedStart,
            requestedEnd
        )


    local bottomDepth =
        math.min(
            requestedStart,
            requestedEnd
        )


    --------------------------------------------------
    -- RANK LIMIT
    --------------------------------------------------

    local rankLimit =
        safeNumber(
            RANK_MAX_DEPTH
        )
        or MIN_DEPTH


    topDepth =
        math.max(
            topDepth,
            rankLimit
        )


    bottomDepth =
        math.max(
            bottomDepth,
            rankLimit
        )


    --------------------------------------------------
    -- HARD LIMIT
    --------------------------------------------------

    topDepth =
        math.clamp(
            topDepth,
            MIN_DEPTH,
            0
        )


    bottomDepth =
        math.clamp(
            bottomDepth,
            MIN_DEPTH,
            0
        )


    if bottomDepth > topDepth then

        bottomDepth =
            topDepth

    end


    return
        topDepth,
        bottomDepth

end


--------------------------------------------------
-- COORDINATES
--------------------------------------------------

local function getCoordinatesFromName(name)

    if name == nil then
        return nil, nil, nil
    end


    name =
        tostring(name)


    --------------------------------------------------
    -- ORIGINAL GAME FUNCTION
    --------------------------------------------------

    local success,
        x,
        y,
        z =

        pcall(function()

            return
                MiningInfo:
                getCoordinatesFromBlockName(
                    name
                )

        end)


    if success then


        x =
            safeNumber(x)

        y =
            safeNumber(y)

        z =
            safeNumber(z)


        if x ~= nil
            and y ~= nil
            and z ~= nil then


            return
                x,
                y,
                z

        end

    end


    --------------------------------------------------
    -- FALLBACK
    --------------------------------------------------

    local sx,
        sy,
        sz =

        name:match(
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )


    return
        safeNumber(sx),
        safeNumber(sy),
        safeNumber(sz)

end


--------------------------------------------------
-- VALID DEPTH
--------------------------------------------------

local function validDepth(y)

    y =
        safeNumber(y)


    if y == nil then
        return false
    end


    if y > 0 then
        return false
    end


    if y < MIN_DEPTH then
        return false
    end


    if y < RANK_MAX_DEPTH then
        return false
    end


    return true

end


--------------------------------------------------
-- FARM RANGE CHECK
--------------------------------------------------

local function inFarmDepth(y)

    y =
        safeNumber(y)


    if not validDepth(y) then
        return false
    end


    local startDepth,
        endDepth =

        getEffectiveDepthRange()


    return
        y <= startDepth
        and y >= endDepth

end



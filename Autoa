local function getLayerForDepth(y)
    y = safeNumber(y)
    if y == nil then
        return nil, nil
    end

    local success, layer, index = pcall(function()
        return MiningInfo:getLayerByDepth(y)
    end)

    if success then
        return layer, index
    end

    return nil, nil
end

local function getRarityWeight(id, y)
    id = tostring(id or "")
    local layer = getLayerForDepth(y)
    if not layer then
        return math.huge
    end

    for _, entry in pairs(layer.blocks or {}) do
        if tostring(entry.block) == id then
            local weight = safeNumber(entry.weight)
            if weight ~= nil then
                return weight
            end

            if tostring(layer.defaultBlock or "") == id then
                return 100
            end

            return math.huge
        end
    end

    if tostring(layer.defaultBlock or "") == id then
        return 100
    end

    return math.huge
end

local function isRareOre(info, y)
    if not info or not isRealOreId(info.Id) then
        return false
    end
    return getRarityWeight(info.Id, y) <= RARE_WEIGHT_THRESHOLD
end


--------------------------------------------------
-- SMART DEPTH ANALYSIS
--------------------------------------------------
local function getBlockValueById(id)
    local success, info = pcall(function()
        return MiningInfo:getBlock(tostring(id))
    end)

    if not success or not info then
        return 0
    end

    return getComparableValue(info.value)
end

local function getLayerProfitScore(layer)
    if not layer then
        return 0
    end

    local score = 0
    for _, entry in pairs(layer.blocks or {}) do
        local id = tostring(entry.block or "")
        local weight = safeNumber(entry.weight)

        if isRealOreId(id) and weight and weight > 0 then
            local value = getBlockValueById(id)
            if value > 0 then
                -- Log value keeps huge-number ores stable while still rewarding value.
                local valuePower = math.log(value + 1) / math.log(10)
                score = score + (valuePower * weight)
            end
        end
    end

    return score
end

local function getLayerRarestWeight(layer)
    if not layer then
        return math.huge
    end

    local best = math.huge
    for _, entry in pairs(layer.blocks or {}) do
        local id = tostring(entry.block or "")
        local weight = safeNumber(entry.weight)
        if isRealOreId(id) and weight and weight > 0 and weight < best then
            best = weight
        end
    end
    return best
end

local function getAutoDepthCandidate(mode)
    mode = tostring(mode or AUTO_DEPTH_MODE)

    if mode == "Manual" then
        return nil, nil, nil
    end

    local rank = getRankDepthInfo()
    if not rank then
        return nil, nil, nil
    end

    if mode == "Deepest Unlocked" then
        return RANK_MAX_DEPTH, math.huge, rank.Layers
    end

    local layers = MiningInfo._layers or {}
    local bestY = nil
    local bestScore = nil
    local bestIndex = nil

    for index = 1, math.min(rank.Layers or 0, #layers) do
        local layer = layers[index]
        local depth = safeNumber(layer and layer.depth)

        if depth ~= nil and depth <= math.abs(RANK_MAX_DEPTH) then
            local y = -depth
            y = math.max(y, RANK_MAX_DEPTH)

            if mode == "Rarest Layer" then
                local rarity = getLayerRarestWeight(layer)
                local profit = getLayerProfitScore(layer)
                local score = rarity < math.huge and (1 / math.max(rarity, 1e-12)) or 0
                score = score + (profit * 0.000001)

                if bestScore == nil or score > bestScore then
                    bestScore = score
                    bestY = y
                    bestIndex = index
                end
            else
                -- Best Profit
                local score = getLayerProfitScore(layer)
                if bestScore == nil or score > bestScore or (score == bestScore and y < bestY) then
                    bestScore = score
                    bestY = y
                    bestIndex = index
                end
            end
        end
    end

    return bestY, bestScore, bestIndex
end

local function applyAutomaticDepth(showNotification)
    local mode = AUTO_DEPTH_MODE

    if SMART_RANK_GRIND and mode == "Manual" then
        mode = "Deepest Unlocked"
    end

    if mode == "Manual" then
        Stats.BestAutoDepth = nil
        Stats.BestAutoDepthScore = 0
        return false
    end

    local depth, score = getAutoDepthCandidate(mode)
    depth = safeNumber(depth)

    if depth == nil then
        return false
    end

    START_DEPTH = math.clamp(math.round(depth), MIN_DEPTH, 0)
    END_DEPTH = START_DEPTH
    Stats.BestAutoDepth = START_DEPTH
    Stats.BestAutoDepthScore = safeNumber(score) or 0

    if showNotification then
        Fluent:Notify({
            Title = "Smart Depth",
            Content = tostring(mode) .. " -> " .. tostring(START_DEPTH),
            Duration = 3
        })
    end

    return true
end


local function addToBucket(map, y, name)
    y = safeNumber(y)
    if y == nil then
        return
    end

    if not map[y] then
        map[y] = {}
    end

    map[y][name] = true
end

local function removeFromBucket(map, y, name)
    y = safeNumber(y)
    if y == nil or not map[y] then
        return
    end

    map[y][name] = nil
    if next(map[y]) == nil then
        map[y] = nil
    end
end

local function removeIndexedName(name)
    local y = safeNumber(YByName[name])
    removeFromBucket(NonBedrockByY, y, name)
    removeFromBucket(StoneByY, y, name)
    removeFromBucket(SelectedByY, y, name)
    ModelsByName[name] = nil
    YByName[name] = nil
end


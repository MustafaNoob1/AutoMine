local function getCurrentRankIndex()
    local success, result = pcall(function()
        return DataClient:get({"Mining", "Rank"})
    end)

    if not success then
        return nil
    end

    return safeNumber(result)
end

local function getRankDepthInfo()
    local rankIndex = getCurrentRankIndex()
    if not rankIndex then
        return nil
    end

    local success, rankInfo = pcall(function()
        return MiningInfo:getRank(rankIndex)
    end)

    if not success or not rankInfo then
        return nil
    end

    local unlockedLayers = safeNumber(rankInfo.layers)
    if not unlockedLayers then
        return nil
    end

    local layers = MiningInfo._layers
    if not layers then
        return nil
    end

    local nextLayer = layers[unlockedLayers + 1]
    local maxDepth = MIN_DEPTH
    local nextBoundary = nil

    if nextLayer then
        local depth = safeNumber(nextLayer.depth)
        if depth then
            maxDepth = -(depth - 1)
            nextBoundary = -depth
        end
    end

    maxDepth = math.max(MIN_DEPTH, maxDepth)

    return {
        RankIndex = rankIndex,
        Name = tostring(rankInfo.name or ("Rank " .. tostring(rankIndex))),
        Layers = unlockedLayers,
        MaxDepth = maxDepth,
        NextBoundary = nextBoundary
    }
end

local function refreshRankDepth()
    local info = getRankDepthInfo()

    if not info then
        RANK_MAX_DEPTH = MIN_DEPTH
        return nil
    end

    RANK_MAX_DEPTH = safeNumber(info.MaxDepth) or MIN_DEPTH
    return info
end

local function getEffectiveDepthRange()
    local requestedStart = safeNumber(START_DEPTH) or 0
    local requestedEnd = safeNumber(END_DEPTH) or MIN_DEPTH
    local rankLimit = safeNumber(RANK_MAX_DEPTH) or MIN_DEPTH

    local topDepth = math.max(requestedStart, requestedEnd)
    local bottomDepth = math.min(requestedStart, requestedEnd)

    topDepth = math.max(topDepth, rankLimit)
    bottomDepth = math.max(bottomDepth, rankLimit)

    topDepth = math.clamp(topDepth, MIN_DEPTH, 0)
    bottomDepth = math.clamp(bottomDepth, MIN_DEPTH, 0)

    if bottomDepth > topDepth then
        bottomDepth = topDepth
    end

    return topDepth, bottomDepth
end

local function validDepth(y)
    y = safeNumber(y)
    if y == nil then
        return false
    end
    return y <= 0 and y >= MIN_DEPTH and y >= RANK_MAX_DEPTH
end

local function inFarmDepth(y)
    y = safeNumber(y)
    if not validDepth(y) then
        return false
    end

    local startDepth, endDepth = getEffectiveDepthRange()
    return y <= startDepth and y >= endDepth
end


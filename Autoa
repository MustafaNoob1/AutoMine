--------------------------------------------------
-- BLOCK STATE
--------------------------------------------------

local function getStateKey(name)

    local data =
        getBlockDataByName(
            name
        )


    if not data then
        return "NONE"
    end


    return
        tostring(data[1])
        .. "|"

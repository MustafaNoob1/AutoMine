local MIN_DEPTH = -4999

-- Farm range
local START_DEPTH = 0
local END_DEPTH = MIN_DEPTH

-- Calculated from player's rank
local RANK_MAX_DEPTH = MIN_DEPTH

local FOLLOW_TARGET = true
local TARGET_DISTANCE = 25


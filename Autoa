--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local AutoMine = false


-- Tiefstes erlaubtes Mining-Level.
local MIN_DEPTH = -4999


-- Gewünschter Startpunkt für Full Mining.
--
-- Beispiel:
--
-- -3000
--
-- Loader geht zuerst nach unten.
-- Ab ungefähr -3000 werden komplette Ebenen bearbeitet.
local START_DEPTH = 0


--------------------------------------------------
-- LOADER POSITION
--------------------------------------------------

-- Bevorzugte X/Z Position.
--
-- Falls dort kein Block existiert,
-- wird automatisch ein anderer Block auf
-- derselben Ebene gesucht.

local LOADER_X = 9
local LOADER_Z = 9


--------------------------------------------------
-- SPEED
--------------------------------------------------

-- Anzahl Damage-Aufrufe pro Yield.
--
-- Falls Probleme:
--
-- 5 -> 3 -> 2 -> 1

local DAMAGE_BURST = 5


--------------------------------------------------
-- LOADING
--------------------------------------------------

-- 300 * 0.05 = viele kurze Versuche,
-- damit neue Mine-Blöcke erscheinen können.

local LOAD_RETRIES = 300

local LOAD_WAIT = 0.05


--------------------------------------------------
-- PLAYER MOVE
--------------------------------------------------

-- Position etwas oberhalb des gerade
-- zerstörten Blocks.

local PLAYER_OFFSET_Y = 2


--------------------------------------------------
-- RUN CONTROL
--------------------------------------------------

local MiningRunId = 0


local function isCurrentRun(runId)

    return
        AutoMine
        and MiningRunId == runId

end


--------------------------------------------------
-- GET BLOCK COORDINATES
--------------------------------------------------

local function getBlockCoordinates(block)

    if not block then
        return nil, nil, nil
    end


    local x, y, z =
        string.match(
            block.Name,
            "^(-?%d+)_(-?%d+)_(-?%d+)$"
        )


    return
        tonumber(x),
        tonumber(y),
        tonumber(z)

end


--------------------------------------------------
-- GET Y
--------------------------------------------------

local function getBlockY(block)

    if not block then
        return nil
    end


    local _, y, _ =
        getBlockCoordinates(block)


    if y ~= nil then
        return y
    end


    --------------------------------------------------
    -- FALLBACK TO ORIGINAL PATTERN
    --------------------------------------------------

    local fallbackY =
        string.match(
            block.Name,
            "^[^_]+_(-?%d+)_"
        )


    return tonumber(
        fallbackY
    )

end


--------------------------------------------------
-- WORLD DEPTH CHECK
--------------------------------------------------

local function isValidWorldDepth(y)

    if y == nil then
        return false
    end


    return
        y <= 0
        and y >= MIN_DEPTH

end


--------------------------------------------------
-- FULL MINING DEPTH CHECK
--------------------------------------------------

local function isMiningDepth(y)

    if y == nil then
        return false
    end


    return
        y <= START_DEPTH
        and y >= MIN_DEPTH

end


--------------------------------------------------
-- GET BLOCK INFO
--------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end


    local blockData =
        MiningServiceClient.blocks[
            block.Name
        ]


    if not blockData then
        return nil
    end


    local blockId =
        blockData[1]


    if not blockId
        or blockId == "None" then

        return nil

    end


    local info =
        MiningInfo:getBlock(
            blockId
        )


    if not info then
        return nil
    end


    return {

        Id = blockId,

        Name = info.name,

        HP = info.hp,

        Value = info.value,

        Model = info.model

    }

end


--------------------------------------------------
-- STONE CHECK
--------------------------------------------------

local function isStone(info)

    if not info then
        return false
    end


    return
        string.match(
            info.Id,
            "^StoneOre%d*$"
        ) ~= nil

end


--------------------------------------------------
-- BEDROCK CHECK
--------------------------------------------------

local function isBedrock(info)

    if not info then
        return false
    end


    return
        info.Id == "Bedrock"

end


--------------------------------------------------
-- SELECTED ORES
--------------------------------------------------

local SelectedOres = {}


local function isSelectedOre(info)

    if not info then
        return false
    end


    if isStone(info) then
        return false
    end


    if isBedrock(info) then
        return false
    end


    return
        SelectedOres[
            info.Id
        ] == true

end


--------------------------------------------------
-- BLOCK POSITION
--------------------------------------------------

local function getBlockCFrame(block)

    if not block then
        return nil
    end


    --------------------------------------------------
    -- BASEPART
    --------------------------------------------------

    if block:IsA("BasePart") then

        return block.CFrame

    end


    --------------------------------------------------
    -- MODEL / OTHER PVINSTANCE
    --------------------------------------------------

    local success, result =
        pcall(function()

            return block:GetPivot()

        end)


    if success then
        return result
    end


    return nil

end


--------------------------------------------------
-- MOVE PLAYER
--------------------------------------------------

local function movePlayerToBlockPosition(
    targetCFrame
)

    if not targetCFrame then
        return false
    end


    local character =
        LocalPlayer.Character


    if not character then
        return false
    end


    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )


    if not root then
        return false
    end


    local targetPosition =
        targetCFrame.Position
        + Vector3.new(
            0,
            PLAYER_OFFSET_Y,
            0
        )


    local lookVector =
        root.CFrame.LookVector


    local target =
        CFrame.new(
            targetPosition,
            targetPosition + lookVector
        )


    local success =
        pcall(function()

            character:PivotTo(
                target
            )

        end)


    task.wait(0.15)


    return success

end


--------------------------------------------------
-- MOVE PLAYER SLIGHTLY DOWN
--------------------------------------------------

local function nudgePlayerDown(
    baseCFrame,
    amount
)

    if not baseCFrame then
        return
    end


    local target =
        CFrame.new(
            baseCFrame.Position
            + Vector3.new(
                0,
                -amount,
                0
            )
        )


    movePlayerToBlockPosition(
        target
    )

end


--------------------------------------------------
-- GET EXACT BLOCK
--------------------------------------------------

local function getBlockAt(
    x,
    y,
    z
)

    local folder =
        MiningServiceClient.mineFolder


    if not folder then
        return nil
    end


    local blockName =
        tostring(x)
        .. "_"
        .. tostring(y)
        .. "_"
        .. tostring(z)


    return
        folder:FindFirstChild(
            blockName
        )

end


--------------------------------------------------
-- INDEX
--------------------------------------------------

local BlocksByY = {}

local AllBlocks = {}

local BlockYCache = {}

local SelectedOreBlocks = {}


local IndexedFolder = nil

local FolderConnections = {}


--------------------------------------------------
-- CLEAR CONNECTIONS
--------------------------------------------------

local function clearConnections()

    for _, connection in ipairs(
        FolderConnections
    ) do


        pcall(function()

            connection:Disconnect()

        end)

    end


    FolderConnections = {}

end


--------------------------------------------------
-- CLEAR INDEX
--------------------------------------------------

local function clearIndex()

    BlocksByY = {}

    AllBlocks = {}

    BlockYCache = {}

    SelectedOreBlocks = {}

end


--------------------------------------------------
-- REGISTER BLOCK
--------------------------------------------------

local function registerBlock(block)

    if not block then
        return
    end


    if AllBlocks[block] then
        return
    end


    local y =
        getBlockY(block)


    if not isValidWorldDepth(y) then
        return
    end


    --------------------------------------------------
    -- ALL BLOCKS
    --------------------------------------------------

    AllBlocks[block] =
        true


    BlockYCache[block] =
        y


    --------------------------------------------------
    -- Y INDEX
    --------------------------------------------------

    if not BlocksByY[y] then

        BlocksByY[y] = {}

    end


    BlocksByY[y][block] =
        true


    --------------------------------------------------
    -- ORE CACHE
    --------------------------------------------------

    if isMiningDepth(y) then


        local info =
            getBlockInfo(block)


        if info
            and isSelectedOre(info) then


            SelectedOreBlocks[block] =
                true

        end

    end

end


--------------------------------------------------
-- UNREGISTER BLOCK
--------------------------------------------------

local function unregisterBlock(block)

    if not block then
        return
    end


    local y =
        BlockYCache[block]


    --------------------------------------------------
    -- REMOVE FROM Y
    --------------------------------------------------

    if y
        and BlocksByY[y] then


        BlocksByY[y][block] =
            nil


        if next(
            BlocksByY[y]
        ) == nil then


            BlocksByY[y] =
                nil

        end

    end


    --------------------------------------------------
    -- REMOVE FROM CACHES
    --------------------------------------------------

    AllBlocks[block] =
        nil


    BlockYCache[block] =
        nil


    SelectedOreBlocks[block] =
        nil

end


--------------------------------------------------
-- REFRESH INDEX
--------------------------------------------------

local function refreshIndex()

    local folder =
        MiningServiceClient.mineFolder


    if not folder then
        return
    end


    for _, block in ipairs(
        folder:GetChildren()
    ) do


        registerBlock(
            block
        )

    end

end


--------------------------------------------------
-- REBUILD SELECTED ORE CACHE
--------------------------------------------------

local function rebuildSelectedOreCache()

    SelectedOreBlocks = {}


    for block in pairs(
        AllBlocks
    ) do


        if block
            and block.Parent then


            local y =
                BlockYCache[block]
                or getBlockY(block)


            if isMiningDepth(y) then


                local info =
                    getBlockInfo(block)


                if info
                    and isSelectedOre(info) then


                    SelectedOreBlocks[block] =
                        true

                end

            end

        end

    end

end


--------------------------------------------------
-- SETUP INDEX
--------------------------------------------------

local function setupMineIndex()

    local folder =
        MiningServiceClient.mineFolder


    if not folder then
        return false
    end


    --------------------------------------------------
    -- SAME FOLDER
    --------------------------------------------------

    if IndexedFolder == folder then

        return true

    end


    --------------------------------------------------
    -- RESET
    --------------------------------------------------

    clearConnections()

    clearIndex()


    IndexedFolder =
        folder


    --------------------------------------------------
    -- INITIAL BLOCKS
    --------------------------------------------------

    refreshIndex()


    --------------------------------------------------
    -- CHILD ADDED
    --------------------------------------------------

    table.insert(

        FolderConnections,

        folder.ChildAdded:Connect(
            function(block)


                registerBlock(
                    block
                )

            end
        )

    )


    --------------------------------------------------
    -- CHILD REMOVED
    --------------------------------------------------

    table.insert(

        FolderConnections,

        folder.ChildRemoved:Connect(
            function(block)


                unregisterBlock(
                    block
                )

            end
        )

    )


    return true

end


--------------------------------------------------
-- CHECK LEVEL
--------------------------------------------------

local function levelExists(y)

    local level =
        BlocksByY[y]


    if not level then
        return false
    end


    for block in pairs(level) do


        if block
            and block.Parent then


            return true

        end

    end


    return false

end


--------------------------------------------------
-- FIND HIGHEST LOADED LEVEL <= VALUE
--------------------------------------------------

local function getHighestLoadedYAtOrBelow(
    maximumY
)

    local bestY =
        nil


    for y, level in pairs(
        BlocksByY
    ) do


        if y <= maximumY
            and y >= MIN_DEPTH
            and level
            and next(level) ~= nil then


            if bestY == nil
                or y > bestY then


                bestY =
                    y

            end

        end

    end


    return bestY

end


--------------------------------------------------
-- FIND NEXT REAL Y BELOW CURRENT
--------------------------------------------------

local function getNextLoadedYBelow(
    currentY
)

    local bestY =
        nil


    for y, level in pairs(
        BlocksByY
    ) do


        if y < currentY
            and y >= MIN_DEPTH
            and level
            and next(level) ~= nil then


            --------------------------------------------------
            -- CLOSEST Y BELOW CURRENT
            --------------------------------------------------

            if bestY == nil
                or y > bestY then


                bestY =
                    y

            end

        end

    end


    return bestY

end


--------------------------------------------------
-- GET CLOSEST BLOCK ON LEVEL
--------------------------------------------------

local function getClosestBlockOnLevel(
    y,
    preferredX,
    preferredZ
)

    --------------------------------------------------
    -- EXACT BLOCK FIRST
    --------------------------------------------------

    local exact =
        getBlockAt(
            preferredX,
            y,
            preferredZ
        )


    if exact
        and exact.Parent then


        local info =
            getBlockInfo(exact)


        if info
            and not isBedrock(info) then


            return exact

        end

    end


    --------------------------------------------------
    -- SEARCH LEVEL
    --------------------------------------------------

    local level =
        BlocksByY[y]


    if not level then
        return nil
    end


    local bestBlock =
        nil


    local bestDistance =
        math.huge


    local fallback =
        nil


    for block in pairs(level) do


        if block
            and block.Parent then


            local info =
                getBlockInfo(block)


            --------------------------------------------------
            -- SKIP BEDROCK
            --------------------------------------------------

            if info
                and not isBedrock(info) then


                if not fallback then

                    fallback =
                        block

                end


                local x, _, z =
                    getBlockCoordinates(
                        block
                    )


                if x ~= nil
                    and z ~= nil then


                    local dx =
                        x - preferredX


                    local dz =
                        z - preferredZ


                    local distance =
                        dx * dx
                        + dz * dz


                    if distance
                        < bestDistance then


                        bestDistance =
                            distance


                        bestBlock =
                            block

                    end

                end

            end

        end

    end


    return
        bestBlock
        or fallback

end


--------------------------------------------------
-- RAW DAMAGE
--------------------------------------------------

local function damageBlockRaw(block)

    if not block then
        return false
    end


    if not block.Parent then
        return false
    end


    if not block:GetAttribute(
        "isBlock"
    ) then


        return false

    end


    local y =
        getBlockY(block)


    if not isValidWorldDepth(y) then
        return false
    end


    local info =
        getBlockInfo(block)


    if not info then
        return false
    end


    --------------------------------------------------
    -- BEDROCK
    --------------------------------------------------

    if isBedrock(info) then
        return false
    end


    --------------------------------------------------
    -- DAMAGE
    --------------------------------------------------

    MiningServiceClient.currentBlock =
        block


    MiningServiceClient:damageBlock()


    return true

end


--------------------------------------------------
-- MINE ANY BLOCK
--------------------------------------------------

-- Wird ausschließlich für den Loader benutzt.
--
-- Damit kann auch ein nicht ausgewähltes Erz
-- im Weg abgebaut werden.

local function mineAnyBlock(
    block,
    runId
)

    if not block then
        return false
    end


    while
        block.Parent
        and isCurrentRun(runId)
    do


        local info =
            getBlockInfo(block)


        if not info then
            return false
        end


        if isBedrock(info) then
            return false
        end


        --------------------------------------------------
        -- DAMAGE BURST
        --------------------------------------------------

        for i = 1, DAMAGE_BURST do


            if not isCurrentRun(runId) then
                return false
            end


            if not block.Parent then
                return true
            end


            if not damageBlockRaw(block) then
                break
            end

        end


        task.wait()

    end


    --------------------------------------------------
    -- BLOCK DESTROYED
    --------------------------------------------------

    if not block.Parent then
        return true
    end


    return false

end


--------------------------------------------------
-- MINE BLOCK FAST
--------------------------------------------------

local function mineBlockFast(
    block,
    checkFunction,
    runId
)

    if not block then
        return
    end


    while
        block.Parent
        and isCurrentRun(runId)
    do


        local y =
            getBlockY(block)


        if not isMiningDepth(y) then
            return
        end


        local info =
            getBlockInfo(block)


        if not info then
            return
        end


        if isBedrock(info) then
            return
        end


        if not checkFunction(info) then
            return
        end


        --------------------------------------------------
        -- DAMAGE BURST
        --------------------------------------------------

        for i = 1, DAMAGE_BURST do


            if not block.Parent then
                return
            end


            if not isCurrentRun(runId) then
                return
            end


            if not damageBlockRaw(block) then
                return
            end

        end


        task.wait()

    end

end


--------------------------------------------------
-- MINE SELECTED ORE
--------------------------------------------------

local function mineSelectedOre(
    block,
    runId
)

    mineBlockFast(
        block,
        isSelectedOre,
        runId
    )

end


--------------------------------------------------
-- MINE STONE
--------------------------------------------------

local function mineStone(
    block,
    runId
)

    mineBlockFast(
        block,
        isStone,
        runId
    )

end


--------------------------------------------------
-- WAIT FOR NEXT LOADED LEVEL
--------------------------------------------------

local function waitForNextLoadedY(
    currentY,
    runId,
    loaderCFrame
)

    for attempt = 1, LOAD_RETRIES do


        if not isCurrentRun(runId) then
            return nil
        end


        --------------------------------------------------
        -- FOLDER MAY HAVE CHANGED
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then


            setupMineIndex()

        end


        --------------------------------------------------
        -- FORCE OCCASIONAL RESCAN
        --------------------------------------------------

        if attempt % 20 == 0 then


            refreshIndex()

        end


        --------------------------------------------------
        -- FIND REAL NEXT Y
        --------------------------------------------------

        local nextY =
            getNextLoadedYBelow(
                currentY
            )


        if nextY then

            return nextY

        end


        --------------------------------------------------
        -- MOVE PLAYER DEEPER OCCASIONALLY
        --------------------------------------------------

        if loaderCFrame
            and attempt % 30 == 0 then


            local stage =
                math.floor(
                    attempt / 30
                )


            local nudge =
                math.min(
                    stage * 2,
                    10
                )


            nudgePlayerDown(
                loaderCFrame,
                nudge
            )

        end


        task.wait(
            LOAD_WAIT
        )

    end


    return nil

end


--------------------------------------------------
-- WAIT FOR INITIAL LEVEL
--------------------------------------------------

local function waitForInitialLevel(
    runId
)

    for attempt = 1, LOAD_RETRIES do


        if not isCurrentRun(runId) then
            return nil
        end


        setupMineIndex()

        refreshIndex()


        local y =
            getHighestLoadedYAtOrBelow(
                0
            )


        if y ~= nil then

            return y

        end


        task.wait(
            LOAD_WAIT
        )

    end


    return nil

end


--------------------------------------------------
-- MINE LOADER BLOCK
--------------------------------------------------

local function mineLoaderAtLevel(
    y,
    preferredX,
    preferredZ,
    runId
)

    --------------------------------------------------
    -- GET BEST BLOCK
    --------------------------------------------------

    local block =
        getClosestBlockOnLevel(
            y,
            preferredX,
            preferredZ
        )


    if not block then
        return false, preferredX, preferredZ, nil
    end


    --------------------------------------------------
    -- REMEMBER POSITION
    --------------------------------------------------

    local blockCFrame =
        getBlockCFrame(
            block
        )


    local blockX, _, blockZ =
        getBlockCoordinates(
            block
        )


    if blockX == nil then

        blockX =
            preferredX

    end


    if blockZ == nil then

        blockZ =
            preferredZ

    end


    --------------------------------------------------
    -- MINE
    --------------------------------------------------

    local success =
        mineAnyBlock(
            block,
            runId
        )


    if not success then

        return
            false,
            blockX,
            blockZ,
            blockCFrame

    end


    --------------------------------------------------
    -- MOVE PLAYER INTO OPENED AREA
    --------------------------------------------------

    if blockCFrame then


        movePlayerToBlockPosition(
            blockCFrame
        )

    end


    return
        true,
        blockX,
        blockZ,
        blockCFrame

end


--------------------------------------------------
-- REACH START DEPTH
--------------------------------------------------

local function reachStartDepth(
    runId
)

    --------------------------------------------------
    -- GET FIRST REAL LOADED LEVEL
    --------------------------------------------------

    local currentY =
        waitForInitialLevel(
            runId
        )


    if currentY == nil then


        Fluent:Notify({

            Title =
                "Loader Error",

            Content =
                "No mine level found.",

            Duration =
                4

        })


        return nil, nil, nil

    end


    --------------------------------------------------
    -- LOADER POSITION
    --------------------------------------------------

    local currentX =
        LOADER_X


    local currentZ =
        LOADER_Z


    --------------------------------------------------
    -- START IS ALREADY REACHED
    --------------------------------------------------

    if currentY <= START_DEPTH then


        return
            currentY,
            currentX,
            currentZ

    end


    --------------------------------------------------
    -- NOTIFICATION
    --------------------------------------------------

    Fluent:Notify({

        Title =
            "Loader",

        Content =
            "Finding way to Y = "
            .. tostring(START_DEPTH)
            .. ".",

        Duration =
            3

    })


    --------------------------------------------------
    -- DYNAMIC LEVEL LOOP
    --------------------------------------------------

    while currentY > START_DEPTH do


        if not isCurrentRun(runId) then
            return nil, nil, nil
        end


        --------------------------------------------------
        -- MINE CURRENT LOADER BLOCK
        --------------------------------------------------

        local success,
            newX,
            newZ,
            loaderCFrame =

            mineLoaderAtLevel(
                currentY,
                currentX,
                currentZ,
                runId
            )


        if not success then


            Fluent:Notify({

                Title =
                    "Loader stopped",

                Content =
                    "Could not mine loader block at Y = "
                    .. tostring(currentY),

                Duration =
                    4

            })


            return nil, nil, nil

        end


        currentX =
            newX


        currentZ =
            newZ


        --------------------------------------------------
        -- WAIT FOR REAL NEXT LEVEL
        --------------------------------------------------

        local nextY =
            waitForNextLoadedY(
                currentY,
                runId,
                loaderCFrame
            )


        if nextY == nil then


            Fluent:Notify({

                Title =
                    "Loader stopped",

                Content =
                    "No deeper level loaded below Y = "
                    .. tostring(currentY),

                Duration =
                    5

            })


            return nil, nil, nil

        end


        --------------------------------------------------
        -- NEXT
        --------------------------------------------------

        currentY =
            nextY


        --------------------------------------------------
        -- SMALL YIELD
        --------------------------------------------------

        task.wait()

    end


    --------------------------------------------------
    -- ACTUAL START LEVEL
    --------------------------------------------------

    Fluent:Notify({

        Title =
            "Start Depth reached",

        Content =
            "Actual loaded level: Y = "
            .. tostring(currentY),

        Duration =
            3

    })


    return
        currentY,
        currentX,
        currentZ

end


--------------------------------------------------
-- MINE COMPLETE LEVEL
--------------------------------------------------

local function mineLevel(
    y,
    runId
)

    if not isCurrentRun(runId) then
        return
    end


    if not isMiningDepth(y) then
        return
    end


    local level =
        BlocksByY[y]


    if not level then
        return
    end


    --------------------------------------------------
    -- SNAPSHOT
    --------------------------------------------------

    local blocks = {}


    for block in pairs(level) do


        if block
            and block.Parent then


            table.insert(
                blocks,
                block
            )

        end

    end


    --------------------------------------------------
    -- MINE
    --------------------------------------------------

    for _, block in ipairs(
        blocks
    ) do


        if not isCurrentRun(runId) then
            return
        end


        if block
            and block.Parent then


            local info =
                getBlockInfo(
                    block
                )


            if info then


                --------------------------------------------------
                -- SELECTED ORE
                --------------------------------------------------

                if isSelectedOre(info) then


                    mineSelectedOre(
                        block,
                        runId
                    )


                --------------------------------------------------
                -- STONE
                --------------------------------------------------

                elseif isStone(info) then


                    mineStone(
                        block,
                        runId
                    )


                --------------------------------------------------
                -- BEDROCK
                --------------------------------------------------

                elseif isBedrock(info) then


                    -- Skip


                --------------------------------------------------
                -- OTHER ORE
                --------------------------------------------------

                else


                    -- Nicht ausgewähltes Erz bleibt stehen.

                end

            end

        end

    end

end


--------------------------------------------------
-- FULL DYNAMIC MINING
--------------------------------------------------

local function mineFromStartToBottom(
    startY,
    loaderX,
    loaderZ,
    runId
)

    local currentY =
        startY


    local currentX =
        loaderX


    local currentZ =
        loaderZ


    --------------------------------------------------
    -- LOOP THROUGH REAL LEVELS
    --------------------------------------------------

    while
        currentY
        and currentY >= MIN_DEPTH
        and isCurrentRun(runId)
    do


        --------------------------------------------------
        -- ENSURE FOLDER
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then


            setupMineIndex()

        end


        --------------------------------------------------
        -- LOADER FIRST
        --
        -- This opens the path toward the next
        -- actual loaded level.
        --------------------------------------------------

        local success,
            newX,
            newZ,
            loaderCFrame =

            mineLoaderAtLevel(
                currentY,
                currentX,
                currentZ,
                runId
            )


        if not success then


            Fluent:Notify({

                Title =
                    "Mining stopped",

                Content =
                    "Could not open loader path at Y = "
                    .. tostring(currentY),

                Duration =
                    4

            })


            return

        end


        currentX =
            newX


        currentZ =
            newZ


        --------------------------------------------------
        -- START LOADING NEXT LEVEL
        --------------------------------------------------

        local nextY =
            nil


        if currentY > MIN_DEPTH then


            nextY =
                waitForNextLoadedY(
                    currentY,
                    runId,
                    loaderCFrame
                )

        end


        --------------------------------------------------
        -- MINE COMPLETE CURRENT LEVEL
        --------------------------------------------------

        mineLevel(
            currentY,
            runId
        )


        if not isCurrentRun(runId) then
            return
        end


        --------------------------------------------------
        -- FINISHED / NO DEEPER LEVEL
        --------------------------------------------------

        if nextY == nil then


            Fluent:Notify({

                Title =
                    "Deepest loaded level",

                Content =
                    "No level found below Y = "
                    .. tostring(currentY),

                Duration =
                    4

            })


            return

        end


        --------------------------------------------------
        -- NEXT REAL LEVEL
        --------------------------------------------------

        currentY =
            nextY


        task.wait()

    end

end


--------------------------------------------------
-- GET NEXT SELECTED ORE
--------------------------------------------------

local function getNextSelectedOre()

    for block in pairs(
        SelectedOreBlocks
    ) do


        --------------------------------------------------
        -- REMOVED
        --------------------------------------------------

        if not block
            or not block.Parent then


            SelectedOreBlocks[block] =
                nil


        else


            local y =
                BlockYCache[block]
                or getBlockY(block)


            --------------------------------------------------
            -- WRONG DEPTH
            --------------------------------------------------

            if not isMiningDepth(y) then


                SelectedOreBlocks[block] =
                    nil


            else


                local info =
                    getBlockInfo(block)


                if not info
                    or not isSelectedOre(info) then


                    SelectedOreBlocks[block] =
                        nil


                else


                    return block

                end

            end

        end

    end


    return nil

end


--------------------------------------------------
-- CONTINUOUS ORE MINING
--------------------------------------------------

local function selectedOreMining(
    runId
)

    while isCurrentRun(runId) do


        --------------------------------------------------
        -- CHECK FOLDER
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then


            setupMineIndex()

        end


        --------------------------------------------------
        -- TARGET
        --------------------------------------------------

        local target =
            getNextSelectedOre()


        if target then


            mineSelectedOre(
                target,
                runId
            )


        else


            task.wait(0.1)

        end

    end

end


--------------------------------------------------
-- START MINER
--------------------------------------------------

local function startMining(
    runId
)

    task.spawn(function()


        --------------------------------------------------
        -- WAIT FOR MINE
        --------------------------------------------------

        while isCurrentRun(runId) do


            if setupMineIndex() then
                break
            end


            task.wait(0.1)

        end


        if not isCurrentRun(runId) then
            return
        end


        --------------------------------------------------
        -- CACHE
        --------------------------------------------------

        rebuildSelectedOreCache()


        --------------------------------------------------
        -- PHASE 1:
        -- REACH REQUESTED DEPTH
        --------------------------------------------------

        local actualStartY,
            loaderX,
            loaderZ =

            reachStartDepth(
                runId
            )


        if actualStartY == nil then
            return
        end


        if not isCurrentRun(runId) then
            return
        end


        --------------------------------------------------
        -- REFRESH AFTER NEW LEVELS LOADED
        --------------------------------------------------

        refreshIndex()

        rebuildSelectedOreCache()


        --------------------------------------------------
        -- PHASE 2:
        -- FULL LEVEL MINING
        --------------------------------------------------

        mineFromStartToBottom(
            actualStartY,
            loaderX,
            loaderZ,
            runId
        )


        --------------------------------------------------
        -- PHASE 3:
        -- KEEP MINING SELECTED ORES
        --------------------------------------------------

        if isCurrentRun(runId) then


            selectedOreMining(
                runId
            )

        end

    end)

end



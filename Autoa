--------------------------------------------------
-- ORE SELECTION CHANGED
--------------------------------------------------

MultiDropdown:OnChanged(
    function(values)


        SelectedOres = {}


        for name, enabled in pairs(
            values
        ) do


            if enabled then


                for id, data in pairs(
                    BlocksData
                ) do


                    local displayName =
                        id


                    if type(data)
                        == "table" then


                        displayName =
                            data.name
                            or data.Name
                            or id

                    end


                    if displayName
                        == name then


                        SelectedOres[id] =
                            true


                        break

                    end

                end

            end

        end


        rebuildSelectedIndex()

    end
)


--------------------------------------------------
-- START DEPTH
--------------------------------------------------

Tabs.Main:AddInput(
    "StartDepth",
    {

        Title =
            "Start Depth",

        Description =
            "Full mining starts from this depth.",

        Default =
            "0",

        Placeholder =
            "-3000",

        Numeric =
            false,

        Finished =
            true,

        Callback =
            function(value)


                local number =
                    tonumber(value)


                if number == nil then


                    Fluent:Notify({

                        Title =
                            "Start Depth",

                        Content =
                            "Example: -3000",

                        Duration =
                            2

                    })


                    return

                end


                number =
                    math.round(number)


                START_DEPTH =
                    math.clamp(
                        number,
                        MIN_DEPTH,
                        0
                    )


                rebuildSelectedIndex()


                Fluent:Notify({

                    Title =
                        "Start Depth",

                    Content =
                        "Start Depth = "
                        .. tostring(
                            START_DEPTH
                        ),

                    Duration =
                        2

                })


                --------------------------------------------------
                -- RESTART MINER WITH NEW DEPTH
                --------------------------------------------------

                if AutoMine then


                    RunId =
                        RunId + 1


                    local newRun =
                        RunId


                    startMining(
                        newRun
                    )

                end

            end

    }
)



--------------------------------------------------
-- PLAYER / DISTANCE
--------------------------------------------------
local function getPlayerGridPosition()
    local character = LocalPlayer.Character
    if not character then
        return DEFAULT_X, DEFAULT_Z
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then
        return DEFAULT_X, DEFAULT_Z
    end

    local origin = MiningServiceClient.originPosition
    if not origin then
        return DEFAULT_X, DEFAULT_Z
    end

    return
        math.round((root.Position.X - origin.X) / 6),
        math.round((root.Position.Z - origin.Z) / 6)
end

local function getGridDistanceSquared(name, targetX, targetZ)
    local x, _, z = getCoordinatesFromName(name)
    x = safeNumber(x)
    z = safeNumber(z)

    if x == nil or z == nil then
        return math.huge
    end

    local dx = x - (safeNumber(targetX) or DEFAULT_X)
    local dz = z - (safeNumber(targetZ) or DEFAULT_Z)
    return dx * dx + dz * dz
end

local function pickNearest(bucket, targetX, targetZ)
    if not bucket then
        return nil
    end

    local bestName = nil
    local bestDistance = math.huge

    for name in pairs(bucket) do
        if not BlockedTargets[name] then
            local model = ModelsByName[name]
            local y = safeNumber(YByName[name])

            if model and model.Parent and validDepth(y) then
                local distance = getGridDistanceSquared(name, targetX, targetZ)
                if distance < bestDistance then
                    bestDistance = distance
                    bestName = name
                end
            end
        end
    end

    return bestName
end


local function pickSystematic(bucket, targetX, targetZ)
    if not bucket then
        return nil
    end

    targetX = safeNumber(targetX) or DEFAULT_X
    targetZ = safeNumber(targetZ) or DEFAULT_Z

    local best = nil

    for name in pairs(bucket) do
        if not BlockedTargets[name] then
            local model = ModelsByName[name]
            local y = safeNumber(YByName[name])

            if model and model.Parent and validDepth(y) then
                local x, _, z = getCoordinatesFromName(name)
                x = safeNumber(x)
                z = safeNumber(z)

                if x ~= nil and z ~= nil then
                    local rowDistance = math.abs(z - targetZ)
                    local direction = (math.abs(z) % 2 == 0) and 1 or -1
                    local xKey = direction == 1 and x or -x
                    local distance = ((x - targetX) ^ 2) + ((z - targetZ) ^ 2)

                    local candidate = {
                        Name = name,
                        RowDistance = rowDistance,
                        Z = z,
                        XKey = xKey,
                        Distance = distance
                    }

                    if best == nil
                        or candidate.RowDistance < best.RowDistance
                        or (candidate.RowDistance == best.RowDistance and candidate.Z < best.Z)
                        or (candidate.RowDistance == best.RowDistance and candidate.Z == best.Z and candidate.XKey < best.XKey)
                        or (candidate.RowDistance == best.RowDistance and candidate.Z == best.Z and candidate.XKey == best.XKey and candidate.Distance < best.Distance) then
                        best = candidate
                    end
                end
            end
        end
    end

    return best and best.Name or nil
end

local function pickSweepTarget(bucket, targetX, targetZ)
    if SYSTEMATIC_SWEEP then
        return pickSystematic(bucket, targetX, targetZ)
    end
    return pickNearest(bucket, targetX, targetZ)
end

local function getModelPosition(model)
    if not model then
        return nil
    end

    if model:IsA("BasePart") then
        return model.Position
    end

    local success, pivot = pcall(function()
        return model:GetPivot()
    end)

    if success and pivot then
        return pivot.Position
    end

    return nil
end

local function moveNearTarget(model)
    if not FOLLOW_TARGET then
        return true
    end

    if not model or not model.Parent then
        return false
    end

    local character = LocalPlayer.Character
    if not character then
        return false
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then
        return false
    end

    local targetPosition = getModelPosition(model)
    if not targetPosition then
        return false
    end

    local distance = (root.Position - targetPosition).Magnitude
    if distance <= TARGET_DISTANCE then
        return true
    end

    local destination = targetPosition + Vector3.new(0, 8, 0)
    local look = root.CFrame.LookVector

    local success = pcall(function()
        character:PivotTo(CFrame.new(destination, destination + look))
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)

    task.wait()
    return success
end

--------------------------------------------------
-- COOLDOWN / STATE
--------------------------------------------------
local function getMiningSpeed()
    local success, value = pcall(function()
        return DataClient:get({"Boosts", "Mining_Speed"})
    end)

    if not success then
        return 0
    end

    return math.max(safeNumber(value) or 0, 0)
end

local function waitForCooldown(run)
    while isRunning(run) do
        local last = MiningServiceClient.damageCooldown

        if last == nil then
            return true
        end

        if last == math.huge then
            task.wait()
            continue
        end

        last = safeNumber(last)
        if last == nil then
            task.wait()
            return true
        end

        local speed = getMiningSpeed()
        local elapsed = workspace:GetServerTimeNow() - last
        local remaining = speed - elapsed

        if remaining <= 0 then
            return true
        end

        task.wait(math.min(remaining, 0.05))
    end

    return false
end

local function getHPKey(value)
    local success, result = pcall(function()
        return EternityNum.bnumtofloat(value)
    end)

    if success then
        return tostring(result)
    end

    return tostring(value)
end

local function getStateKey(name)
    local data = getBlockDataByName(name)
    if not data then
        return "NONE"
    end

    return tostring(data[1]) .. "|" .. getHPKey(data[2])
end

local function modeAllows(name, mode)
    local y = safeNumber(YByName[name])
    if not validDepth(y) then
        return false
    end

    local info = getBlockInfoByName(name)
    if not info or isBedrock(info) then
        return false
    end

    if mode == "selected" then
        return isSelectedOre(info)
    end

    if mode == "stone" then
        return isStone(info)
    end

    return true
end


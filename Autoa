--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local AutoMine = false

-- Tiefste erlaubte Ebene
local MIN_DEPTH = -4999

-- Ab welcher Ebene angefangen wird
-- 0 = komplette Mine
-- -3000 = nur -3000 bis -4999
local START_DEPTH = 0


--------------------------------------------------
-- SPEED
--------------------------------------------------

-- Damage-Aufrufe pro Tick
-- Falls Probleme auftreten:
-- 5 -> 3 -> 2 -> 1

local DAMAGE_BURST = 5


--------------------------------------------------
-- RUN ID
--------------------------------------------------

-- Verhindert mehrere Auto-Mine Threads gleichzeitig.

local MiningRunId = 0


local function isCurrentRun(runId)

    return
        AutoMine
        and runId == MiningRunId

end


--------------------------------------------------
-- Y RANGE CHECK
--------------------------------------------------

local function isYInMiningRange(y)

    if y == nil then
        return false
    end

    return
        y >= MIN_DEPTH
        and y <= START_DEPTH

end


--------------------------------------------------
-- GET BLOCK INFO
--------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end


    local blockData =
        MiningServiceClient.blocks[
            block.Name
        ]


    if not blockData then
        return nil
    end


    local blockId =
        blockData[1]


    if not blockId
        or blockId == "None" then

        return nil

    end


    local info =
        MiningInfo:getBlock(
            blockId
        )


    if not info then
        return nil
    end


    return {

        Id = blockId,

        Name = info.name,

        HP = info.hp,

        Value = info.value,

        Model = info.model

    }

end


--------------------------------------------------
-- STONE
--------------------------------------------------

local function isStone(info)

    if not info then
        return false
    end


    return
        string.match(
            info.Id,
            "^StoneOre%d*$"
        ) ~= nil

end


--------------------------------------------------
-- BEDROCK
--------------------------------------------------

local function isBedrock(info)

    if not info then
        return false
    end


    return
        info.Id == "Bedrock"

end


--------------------------------------------------
-- SELECTED ORES
--------------------------------------------------

local SelectedOres = {}


local function isSelectedOre(info)

    if not info then
        return false
    end


    if isStone(info) then
        return false
    end


    if isBedrock(info) then
        return false
    end


    return
        SelectedOres[
            info.Id
        ] == true

end


--------------------------------------------------
-- GET BLOCK Y
--------------------------------------------------

local function getBlockY(block)

    if not block then
        return nil
    end


    local y =
        string.match(
            block.Name,
            "^[^_]+_(-?%d+)_"
        )


    return tonumber(y)

end


--------------------------------------------------
-- DEPTH CHECK
--------------------------------------------------

local function isAllowedDepth(block)

    local y =
        getBlockY(block)


    return
        isYInMiningRange(y)

end


--------------------------------------------------
-- BLOCK INDEX
--------------------------------------------------

-- Speichert Blöcke nach ihrer Y-Ebene.
-- Dadurch muss nicht ständig die komplette Mine
-- durchsucht werden.

local BlocksByY = {}

local AllBlocks = {}

local BlockYCache = {}

local SelectedOreBlocks = {}


local IndexedFolder = nil

local FolderConnections = {}


--------------------------------------------------
-- CLEAR CONNECTIONS
--------------------------------------------------

local function clearFolderConnections()

    for _, connection in ipairs(
        FolderConnections
    ) do

        pcall(function()

            connection:Disconnect()

        end)

    end


    FolderConnections = {}

end


--------------------------------------------------
-- CLEAR BLOCK INDEX
--------------------------------------------------

local function clearBlockIndex()

    BlocksByY = {}

    AllBlocks = {}

    BlockYCache = {}

    SelectedOreBlocks = {}

end


--------------------------------------------------
-- REGISTER BLOCK
--------------------------------------------------

local function registerBlock(block)

    if not block then
        return
    end


    if AllBlocks[block] then
        return
    end


    local y =
        getBlockY(block)


    if y == nil then
        return
    end


    --------------------------------------------------
    -- IGNORE IMPOSSIBLE LEVELS
    --------------------------------------------------

    if y < MIN_DEPTH then
        return
    end


    if y > 0 then
        return
    end


    --------------------------------------------------
    -- SAVE BLOCK
    --------------------------------------------------

    AllBlocks[block] =
        true


    BlockYCache[block] =
        y


    --------------------------------------------------
    -- SAVE BY Y
    --------------------------------------------------

    if not BlocksByY[y] then

        BlocksByY[y] = {}

    end


    BlocksByY[y][block] =
        true


    --------------------------------------------------
    -- SELECTED ORE CACHE
    --------------------------------------------------

    if isYInMiningRange(y) then

        local info =
            getBlockInfo(block)


        if info
            and isSelectedOre(info) then

            SelectedOreBlocks[block] =
                true

        end

    end

end


--------------------------------------------------
-- UNREGISTER BLOCK
--------------------------------------------------

local function unregisterBlock(block)

    if not block then
        return
    end


    local y =
        BlockYCache[block]


    --------------------------------------------------
    -- REMOVE FROM LEVEL
    --------------------------------------------------

    if y
        and BlocksByY[y] then


        BlocksByY[y][block] =
            nil


        if next(
            BlocksByY[y]
        ) == nil then

            BlocksByY[y] =
                nil

        end

    end


    --------------------------------------------------
    -- REMOVE FROM CACHE
    --------------------------------------------------

    AllBlocks[block] =
        nil


    BlockYCache[block] =
        nil


    SelectedOreBlocks[block] =
        nil

end


--------------------------------------------------
-- REBUILD SELECTED ORE CACHE
--------------------------------------------------

local function rebuildSelectedOreCache()

    SelectedOreBlocks = {}


    for block in pairs(
        AllBlocks
    ) do


        if block
            and block.Parent then


            local y =
                BlockYCache[block]
                or getBlockY(block)


            if isYInMiningRange(y) then


                local info =
                    getBlockInfo(block)


                if info
                    and isSelectedOre(info) then


                    SelectedOreBlocks[block] =
                        true

                end

            end

        end

    end

end


--------------------------------------------------
-- SETUP MINE INDEX
--------------------------------------------------

local function setupMineIndex()

    local folder =
        MiningServiceClient.mineFolder


    if not folder then
        return false
    end


    --------------------------------------------------
    -- ALREADY INDEXED
    --------------------------------------------------

    if IndexedFolder == folder then
        return true
    end


    --------------------------------------------------
    -- RESET OLD FOLDER
    --------------------------------------------------

    clearFolderConnections()

    clearBlockIndex()


    IndexedFolder =
        folder


    --------------------------------------------------
    -- INITIAL SCAN
    --------------------------------------------------

    for _, block in ipairs(
        folder:GetChildren()
    ) do

        registerBlock(block)

    end


    --------------------------------------------------
    -- NEW BLOCK
    --------------------------------------------------

    table.insert(
        FolderConnections,

        folder.ChildAdded:Connect(
            function(block)

                registerBlock(block)

            end
        )

    )


    --------------------------------------------------
    -- REMOVED BLOCK
    --------------------------------------------------

    table.insert(
        FolderConnections,

        folder.ChildRemoved:Connect(
            function(block)

                unregisterBlock(block)

            end
        )

    )


    return true

end


--------------------------------------------------
-- DAMAGE BLOCK
--------------------------------------------------

local function damageBlock(block)

    if not block then
        return false
    end


    if not block.Parent then
        return false
    end


    if not block:GetAttribute(
        "isBlock"
    ) then

        return false

    end


    --------------------------------------------------
    -- CHECK START / MIN DEPTH
    --------------------------------------------------

    if not isAllowedDepth(block) then
        return false
    end


    local info =
        getBlockInfo(block)


    if not info then
        return false
    end


    --------------------------------------------------
    -- NEVER BEDROCK
    --------------------------------------------------

    if isBedrock(info) then
        return false
    end


    --------------------------------------------------
    -- DAMAGE
    --------------------------------------------------

    MiningServiceClient.currentBlock =
        block


    MiningServiceClient:damageBlock()


    return true

end


--------------------------------------------------
-- FAST BLOCK MINING
--------------------------------------------------

local function mineBlockFast(
    block,
    checkFunction,
    runId
)

    if not block then
        return
    end


    while
        block.Parent
        and isCurrentRun(runId)
    do


        --------------------------------------------------
        -- CHECK Y
        --------------------------------------------------

        local y =
            getBlockY(block)


        if not isYInMiningRange(y) then
            return
        end


        --------------------------------------------------
        -- CHECK BLOCK TYPE
        --------------------------------------------------

        local info =
            getBlockInfo(block)


        if not info then
            return
        end


        if isBedrock(info) then
            return
        end


        if not checkFunction(info) then
            return
        end


        --------------------------------------------------
        -- DAMAGE BURST
        --------------------------------------------------

        for i = 1, DAMAGE_BURST do


            if not block.Parent then
                return
            end


            if not isCurrentRun(runId) then
                return
            end


            if not damageBlock(block) then
                return
            end

        end


        --------------------------------------------------
        -- YIELD AFTER BURST
        --------------------------------------------------

        task.wait()

    end

end


--------------------------------------------------
-- MINE SELECTED ORE
--------------------------------------------------

local function mineSelectedOre(
    block,
    runId
)

    mineBlockFast(
        block,
        isSelectedOre,
        runId
    )

end


--------------------------------------------------
-- MINE STONE
--------------------------------------------------

local function mineStone(
    block,
    runId
)

    mineBlockFast(
        block,
        isStone,
        runId
    )

end


--------------------------------------------------
-- MINE Y LEVEL
--------------------------------------------------

local function mineLevel(
    y,
    runId
)

    if not isCurrentRun(runId) then
        return
    end


    --------------------------------------------------
    -- DO NOT MINE ABOVE START DEPTH
    --------------------------------------------------

    if not isYInMiningRange(y) then
        return
    end


    local level =
        BlocksByY[y]


    if not level then
        return
    end


    --------------------------------------------------
    -- SNAPSHOT
    --------------------------------------------------

    local blocks = {}


    for block in pairs(level) do

        table.insert(
            blocks,
            block
        )

    end


    --------------------------------------------------
    -- MINE LEVEL
    --------------------------------------------------

    for _, block in ipairs(
        blocks
    ) do


        if not isCurrentRun(runId) then
            return
        end


        if block
            and block.Parent then


            local info =
                getBlockInfo(block)


            if info then


                --------------------------------------------------
                -- SELECTED ORE
                --------------------------------------------------

                if isSelectedOre(info) then


                    mineSelectedOre(
                        block,
                        runId
                    )


                --------------------------------------------------
                -- STONE
                --------------------------------------------------

                elseif isStone(info) then


                    mineStone(
                        block,
                        runId
                    )


                --------------------------------------------------
                -- BEDROCK
                --------------------------------------------------

                elseif isBedrock(info) then

                    -- Bedrock überspringen


                --------------------------------------------------
                -- UNSELECTED ORE
                --------------------------------------------------

                else

                    -- Nicht ausgewähltes Erz überspringen

                end

            end

        end

    end

end


--------------------------------------------------
-- MINE FROM START DEPTH TO BOTTOM
--------------------------------------------------

local function mineDownToBottom(
    runId
)

    --------------------------------------------------
    -- IMPORTANT:
    --
    -- START_DEPTH = -3000
    --
    -- macht:
    --
    -- -3000
    -- -3001
    -- -3002
    -- ...
    -- -4999
    --------------------------------------------------

    for y = START_DEPTH, MIN_DEPTH, -1 do


        if not isCurrentRun(runId) then
            return
        end


        --------------------------------------------------
        -- MINE FOLDER CHANGED?
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then


            setupMineIndex()

        end


        --------------------------------------------------
        -- COMPLETE LEVEL
        --------------------------------------------------

        mineLevel(
            y,
            runId
        )


        --------------------------------------------------
        -- YIELD EVERY 25 LEVELS
        --------------------------------------------------

        if y % 25 == 0 then

            task.wait()

        end

    end

end


--------------------------------------------------
-- GET NEXT SELECTED ORE
--------------------------------------------------

local function getNextSelectedOre()

    for block in pairs(
        SelectedOreBlocks
    ) do


        --------------------------------------------------
        -- DEAD BLOCK
        --------------------------------------------------

        if not block
            or not block.Parent then


            SelectedOreBlocks[block] =
                nil


        else


            local y =
                BlockYCache[block]
                or getBlockY(block)


            --------------------------------------------------
            -- OUTSIDE START DEPTH
            --------------------------------------------------

            if not isYInMiningRange(y) then


                SelectedOreBlocks[block] =
                    nil


            else


                local info =
                    getBlockInfo(block)


                --------------------------------------------------
                -- NOT SELECTED ANYMORE
                --------------------------------------------------

                if not info
                    or not isSelectedOre(info) then


                    SelectedOreBlocks[block] =
                        nil


                --------------------------------------------------
                -- VALID TARGET
                --------------------------------------------------

                else

                    return block

                end

            end

        end

    end


    return nil

end


--------------------------------------------------
-- KEEP MINING SELECTED ORES
--------------------------------------------------

local function selectedOreMining(
    runId
)

    while isCurrentRun(runId) do


        --------------------------------------------------
        -- MINE FOLDER CHANGED?
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then


            setupMineIndex()

        end


        --------------------------------------------------
        -- GET ORE
        --------------------------------------------------

        local target =
            getNextSelectedOre()


        if target then


            mineSelectedOre(
                target,
                runId
            )


        else


            task.wait(0.1)

        end

    end

end


--------------------------------------------------
-- START MINING
--------------------------------------------------

local function startMining(
    runId
)

    task.spawn(function()


        --------------------------------------------------
        -- WAIT FOR MINE FOLDER
        --------------------------------------------------

        while isCurrentRun(runId) do


            if setupMineIndex() then
                break
            end


            task.wait(0.1)

        end


        if not isCurrentRun(runId) then
            return
        end


        --------------------------------------------------
        -- REFRESH ORES
        --------------------------------------------------

        rebuildSelectedOreCache()


        --------------------------------------------------
        -- START AT SELECTED DEPTH
        --------------------------------------------------

        mineDownToBottom(
            runId
        )


        --------------------------------------------------
        -- AFTER BOTTOM KEEP MINING ORES
        --------------------------------------------------

        if isCurrentRun(runId) then


            selectedOreMining(
                runId
            )

        end

    end)

end


--------------------------------------------------
-- BUILD ORE LIST
--------------------------------------------------

local OreValues = {}


for id, data in pairs(
    BlocksData
) do


    if id

        and not string.match(
            id,
            "^StoneOre%d*$"
        )

        and id ~= "Bedrock"

    then


        local displayName =
            id


        if type(data) == "table" then


            displayName =
                data.name
                or data.Name
                or id

        end


        table.insert(
            OreValues,
            displayName
        )

    end

end


table.sort(
    OreValues
)



--------------------------------------------------
-- ADD BUCKET
--------------------------------------------------

local function addToBucket(
    map,
    y,
    name
)

    y =
        safeNumber(y)

    if y == nil then
        return
    end


    if not map[y] then

        map[y] =
            {}

    end


    map[y][name] =
        true

end


--------------------------------------------------
-- REMOVE BUCKET
--------------------------------------------------

local function removeFromBucket(
    map,
    y,
    name
)

    y =
        safeNumber(y)


    if y == nil
        or not map[y] then

        return

    end


    map[y][name] =
        nil


    if next(
        map[y]
    ) == nil then

        map[y] =
            nil

    end

end


--------------------------------------------------
-- REMOVE INDEXED NAME
--------------------------------------------------

local function removeIndexedName(name)

    local y =
        safeNumber(
            YByName[name]
        )


    removeFromBucket(
        NonBedrockByY,
        y,
        name
    )


    removeFromBucket(
        StoneByY,
        y,
        name
    )


    removeFromBucket(
        SelectedByY,
        y,
        name
    )


    ModelsByName[name] =
        nil


    YByName[name] =
        nil

end


--------------------------------------------------
-- REGISTER BLOCK
--------------------------------------------------

local function registerBlock(block)

    if not block
        or not block.Parent then

        return

    end


    local name =
        tostring(
            block.Name
        )


    --------------------------------------------------
    -- NEW BLOCK = REMOVE OLD BLOCKED STATE
    --------------------------------------------------

    BlockedTargets[name] =
        nil


    --------------------------------------------------
    -- WAIT FOR GAME DATA
    --------------------------------------------------

    local data =
        getBlockDataByName(
            name
        )


    if not data then


        for i = 1, 10 do

            task.wait()


            data =
                getBlockDataByName(
                    name
                )


            if data then
                break
            end

        end

    end


    if not data then
        return
    end


    --------------------------------------------------
    -- COORDINATES
    --------------------------------------------------

    local x,
        y,
        z =

        getCoordinatesFromName(
            name
        )


    x = safeNumber(x)
    y = safeNumber(y)
    z = safeNumber(z)


    --------------------------------------------------
    -- RANK CHECK
    --------------------------------------------------

    if not validDepth(y) then
        return
    end


    --------------------------------------------------
    -- INFO
    --------------------------------------------------

    local info =
        getBlockInfoByName(
            name
        )


    if not info then
        return
    end


    --------------------------------------------------
    -- REMOVE OLD CLASSIFICATION
    --------------------------------------------------

    if ModelsByName[name] then

        removeIndexedName(
            name
        )

    end


    --------------------------------------------------
    -- SAVE MODEL
    --------------------------------------------------

    ModelsByName[name] =
        block


    YByName[name] =
        y


    --------------------------------------------------
    -- NON BEDROCK
    --------------------------------------------------

    if not isBedrock(info) then

        addToBucket(
            NonBedrockByY,
            y,
            name
        )

    end


    --------------------------------------------------
    -- STONE
    --------------------------------------------------

    if isStone(info) then

        addToBucket(
            StoneByY,
            y,
            name
        )

    end


    --------------------------------------------------
    -- SELECTED
    --------------------------------------------------

    if isSelectedOre(info) then

        addToBucket(
            SelectedByY,
            y,
            name
        )

    end

end


--------------------------------------------------
-- UNREGISTER BLOCK
--------------------------------------------------

local function unregisterBlock(block)

    if not block then
        return
    end


    local name =
        tostring(
            block.Name
        )


    --------------------------------------------------
    -- REPLACEBLOCK PROTECTION
    --------------------------------------------------

    if ModelsByName[name]
        ~= block then

        return

    end


    removeIndexedName(
        name
    )

end


--------------------------------------------------
-- CLEAR INDEX
--------------------------------------------------

local function clearIndex()

    ModelsByName =

--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local AutoMine = false


-- Tiefste Ebene
local MIN_DEPTH = -4999


-- Ab hier wird die komplette Mine abgebaut.
--
-- Beispiel:
-- -3000 = Loader Tunnel bis -3000
-- danach komplette Ebenen von -3000 bis -4999
local START_DEPTH = 0


--------------------------------------------------
-- LOADER TUNNEL
--------------------------------------------------

-- Diese X/Z Koordinate wird benutzt,
-- um einen schmalen Tunnel nach unten zu graben.
--
-- Dadurch sollen tiefere Ebenen nachgeladen werden.

local LOADER_X = 9
local LOADER_Z = 9


--------------------------------------------------
-- LOADING SETTINGS
--------------------------------------------------

-- Wie oft auf eine neue Ebene gewartet wird.

local LOAD_RETRIES = 80


-- Pause zwischen den Versuchen.

local LOAD_WAIT = 0.05


--------------------------------------------------
-- SPEED
--------------------------------------------------

-- Damage-Aufrufe pro Tick.
--
-- Falls 5 Probleme macht:
--
-- 5 -> 3 -> 2 -> 1

local DAMAGE_BURST = 5


--------------------------------------------------
-- RUN ID
--------------------------------------------------

-- Damit niemals zwei Miner gleichzeitig laufen.

local MiningRunId = 0


local function isCurrentRun(runId)

    return
        AutoMine
        and runId == MiningRunId

end


--------------------------------------------------
-- GET BLOCK INFO
--------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end


    local blockData =
        MiningServiceClient.blocks[
            block.Name
        ]


    if not blockData then
        return nil
    end


    local blockId =
        blockData[1]


    if not blockId
        or blockId == "None" then

        return nil

    end


    local info =
        MiningInfo:getBlock(
            blockId
        )


    if not info then
        return nil
    end


    return {

        Id = blockId,

        Name = info.name,

        HP = info.hp,

        Value = info.value,

        Model = info.model

    }

end


--------------------------------------------------
-- STONE
--------------------------------------------------

local function isStone(info)

    if not info then
        return false
    end


    return
        string.match(
            info.Id,
            "^StoneOre%d*$"
        ) ~= nil

end


--------------------------------------------------
-- BEDROCK
--------------------------------------------------

local function isBedrock(info)

    if not info then
        return false
    end


    return
        info.Id == "Bedrock"

end


--------------------------------------------------
-- SELECTED ORES
--------------------------------------------------

local SelectedOres = {}


local function isSelectedOre(info)

    if not info then
        return false
    end


    if isStone(info) then
        return false
    end


    if isBedrock(info) then
        return false
    end


    return
        SelectedOres[
            info.Id
        ] == true

end


--------------------------------------------------
-- GET Y
--------------------------------------------------

local function getBlockY(block)

    if not block then
        return nil
    end


    local y =
        string.match(
            block.Name,
            "^[^_]+_(-?%d+)_"
        )


    return tonumber(y)

end


--------------------------------------------------
-- BASIC DEPTH CHECK
--------------------------------------------------

local function isValidWorldDepth(y)

    if y == nil then
        return false
    end


    return
        y >= MIN_DEPTH
        and y <= 0

end


--------------------------------------------------
-- AUTO MINE RANGE CHECK
--------------------------------------------------

local function isMiningDepth(y)

    if y == nil then
        return false
    end


    return
        y >= MIN_DEPTH
        and y <= START_DEPTH

end


--------------------------------------------------
-- GET BLOCK AT XYZ
--------------------------------------------------

local function getBlockAt(x, y, z)

    if not MiningServiceClient.mineFolder then
        return nil
    end


    local name =
        tostring(x)
        .. "_"
        .. tostring(y)
        .. "_"
        .. tostring(z)


    return
        MiningServiceClient.mineFolder:
        FindFirstChild(name)

end


--------------------------------------------------
-- BLOCK INDEX
--------------------------------------------------

-- Statt für jede Ebene die komplette Mine
-- neu zu durchsuchen, speichern wir Blöcke
-- direkt nach ihrer Y-Ebene.

local BlocksByY = {}

local AllBlocks = {}

local BlockYCache = {}

local SelectedOreBlocks = {}


local IndexedFolder = nil

local FolderConnections = {}


--------------------------------------------------
-- CLEAR CONNECTIONS
--------------------------------------------------

local function clearFolderConnections()

    for _, connection in ipairs(
        FolderConnections
    ) do

        pcall(function()

            connection:Disconnect()

        end)

    end


    FolderConnections = {}

end


--------------------------------------------------
-- CLEAR INDEX
--------------------------------------------------

local function clearBlockIndex()

    BlocksByY = {}

    AllBlocks = {}

    BlockYCache = {}

    SelectedOreBlocks = {}

end


--------------------------------------------------
-- REGISTER BLOCK
--------------------------------------------------

local function registerBlock(block)

    if not block then
        return
    end


    if AllBlocks[block] then
        return
    end


    local y =
        getBlockY(block)


    if not isValidWorldDepth(y) then
        return
    end


    --------------------------------------------------
    -- ALL BLOCKS
    --------------------------------------------------

    AllBlocks[block] =
        true


    BlockYCache[block] =
        y


    --------------------------------------------------
    -- Y INDEX
    --------------------------------------------------

    if not BlocksByY[y] then

        BlocksByY[y] = {}

    end


    BlocksByY[y][block] =
        true


    --------------------------------------------------
    -- SELECTED ORE CACHE
    --------------------------------------------------

    if isMiningDepth(y) then


        local info =
            getBlockInfo(block)


        if info
            and isSelectedOre(info) then


            SelectedOreBlocks[block] =
                true

        end

    end

end


--------------------------------------------------
-- UNREGISTER BLOCK
--------------------------------------------------

local function unregisterBlock(block)

    if not block then
        return
    end


    local y =
        BlockYCache[block]


    --------------------------------------------------
    -- REMOVE FROM LEVEL
    --------------------------------------------------

    if y
        and BlocksByY[y] then


        BlocksByY[y][block] =
            nil


        if next(
            BlocksByY[y]
        ) == nil then


            BlocksByY[y] =
                nil

        end

    end


    --------------------------------------------------
    -- REMOVE FROM CACHE
    --------------------------------------------------

    AllBlocks[block] =
        nil


    BlockYCache[block] =
        nil


    SelectedOreBlocks[block] =
        nil

end


--------------------------------------------------
-- REBUILD SELECTED ORES
--------------------------------------------------

local function rebuildSelectedOreCache()

    SelectedOreBlocks = {}


    for block in pairs(
        AllBlocks
    ) do


        if block
            and block.Parent then


            local y =
                BlockYCache[block]
                or getBlockY(block)


            if isMiningDepth(y) then


                local info =
                    getBlockInfo(block)


                if info
                    and isSelectedOre(info) then


                    SelectedOreBlocks[block] =
                        true

                end

            end

        end

    end

end


--------------------------------------------------
-- SETUP INDEX
--------------------------------------------------

local function setupMineIndex()

    local folder =
        MiningServiceClient.mineFolder


    if not folder then
        return false
    end


    --------------------------------------------------
    -- ALREADY INDEXED
    --------------------------------------------------

    if IndexedFolder == folder then
        return true
    end


    --------------------------------------------------
    -- RESET
    --------------------------------------------------

    clearFolderConnections()

    clearBlockIndex()


    IndexedFolder =
        folder


    --------------------------------------------------
    -- INITIAL SCAN
    --------------------------------------------------

    for _, block in ipairs(
        folder:GetChildren()
    ) do


        registerBlock(block)

    end


    --------------------------------------------------
    -- NEW BLOCK
    --------------------------------------------------

    table.insert(

        FolderConnections,

        folder.ChildAdded:Connect(

            function(block)

                registerBlock(block)

            end

        )

    )


    --------------------------------------------------
    -- REMOVED BLOCK
    --------------------------------------------------

    table.insert(

        FolderConnections,

        folder.ChildRemoved:Connect(

            function(block)

                unregisterBlock(block)

            end

        )

    )


    return true

end


--------------------------------------------------
-- RAW DAMAGE BLOCK
--------------------------------------------------

-- Dieser Damage-Call darf AUCH oberhalb von
-- START_DEPTH benutzt werden.
--
-- Das brauchen wir für den Loader-Tunnel.

local function damageBlockRaw(block)

    if not block then
        return false
    end


    if not block.Parent then
        return false
    end


    if not block:GetAttribute(
        "isBlock"
    ) then

        return false

    end


    local y =
        getBlockY(block)


    if not isValidWorldDepth(y) then
        return false
    end


    local info =
        getBlockInfo(block)


    if not info then
        return false
    end


    --------------------------------------------------
    -- NEVER BEDROCK
    --------------------------------------------------

    if isBedrock(info) then
        return false
    end


    --------------------------------------------------
    -- DAMAGE
    --------------------------------------------------

    MiningServiceClient.currentBlock =
        block


    MiningServiceClient:damageBlock()


    return true

end


--------------------------------------------------
-- FAST MINE ANY BLOCK
--------------------------------------------------

-- Wird für den Loader Tunnel benutzt.
--
-- Erztyp ist egal.
--
-- Stone     -> abbauen
-- Gold      -> abbauen
-- Diamond   -> abbauen
-- anderes   -> abbauen
-- Bedrock   -> NICHT abbauen

local function mineAnyBlock(
    block,
    runId
)

    if not block then
        return false
    end


    while
        block.Parent
        and isCurrentRun(runId)
    do


        local info =
            getBlockInfo(block)


        if not info then
            return false
        end


        --------------------------------------------------
        -- BEDROCK
        --------------------------------------------------

        if isBedrock(info) then
            return false
        end


        --------------------------------------------------
        -- DAMAGE BURST
        --------------------------------------------------

        for i = 1, DAMAGE_BURST do


            if not block.Parent then
                return true
            end


            if not isCurrentRun(runId) then
                return false
            end


            if not damageBlockRaw(block) then
                break
            end

        end


        task.wait()

    end


    return true

end


--------------------------------------------------
-- FAST MINE WITH CHECK
--------------------------------------------------

local function mineBlockFast(
    block,
    checkFunction,
    runId
)

    if not block then
        return
    end


    while
        block.Parent
        and isCurrentRun(runId)
    do


        local y =
            getBlockY(block)


        --------------------------------------------------
        -- ONLY MINE BELOW START DEPTH
        --------------------------------------------------

        if not isMiningDepth(y) then
            return
        end


        local info =
            getBlockInfo(block)


        if not info then
            return
        end


        if isBedrock(info) then
            return
        end


        if not checkFunction(info) then
            return
        end


        --------------------------------------------------
        -- DAMAGE BURST
        --------------------------------------------------

        for i = 1, DAMAGE_BURST do


            if not block.Parent then
                return
            end


            if not isCurrentRun(runId) then
                return
            end


            if not damageBlockRaw(block) then
                return
            end

        end


        task.wait()

    end

end


--------------------------------------------------
-- SELECTED ORE
--------------------------------------------------

local function mineSelectedOre(
    block,
    runId
)

    mineBlockFast(
        block,
        isSelectedOre,
        runId
    )

end


--------------------------------------------------
-- STONE
--------------------------------------------------

local function mineStone(
    block,
    runId
)

    mineBlockFast(
        block,
        isStone,
        runId
    )

end


--------------------------------------------------
-- CHECK IF LEVEL EXISTS
--------------------------------------------------

local function levelExists(y)

    local level =
        BlocksByY[y]


    if not level then
        return false
    end


    for block in pairs(level) do


        if block
            and block.Parent then

            return true

        end

    end


    return false

end


--------------------------------------------------
-- WAIT FOR LEVEL
--------------------------------------------------

local function waitForLevel(
    y,
    runId
)

    for attempt = 1, LOAD_RETRIES do


        if not isCurrentRun(runId) then
            return false
        end


        --------------------------------------------------
        -- MINE FOLDER CHANGED
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then


            setupMineIndex()

        end


        --------------------------------------------------
        -- CHECK DIRECT LOADER BLOCK
        --------------------------------------------------

        local block =
            getBlockAt(
                LOADER_X,
                y,
                LOADER_Z
            )


        if block then
            return true
        end


        --------------------------------------------------
        -- OR ANY BLOCK ON THE LEVEL
        --------------------------------------------------

        if levelExists(y) then
            return true
        end


        task.wait(
            LOAD_WAIT
        )

    end


    return false

end


--------------------------------------------------
-- MINE LOADER BLOCK
--------------------------------------------------

local function mineLoaderBlock(
    y,
    runId
)

    --------------------------------------------------
    -- WAIT FOR LEVEL TO APPEAR
    --------------------------------------------------

    local loaded =
        waitForLevel(
            y,
            runId
        )


    if not loaded then
        return false
    end


    --------------------------------------------------
    -- FIND EXACT LOADER BLOCK
    --------------------------------------------------

    local block =
        getBlockAt(
            LOADER_X,
            y,
            LOADER_Z
        )


    --------------------------------------------------
    -- If the exact loader block does not exist,
    -- but the level exists, it may already have
    -- been destroyed.
    --------------------------------------------------

    if not block then
        return true
    end


    --------------------------------------------------
    -- BEDROCK CHECK
    --------------------------------------------------

    local info =
        getBlockInfo(block)


    if not info then
        return true
    end


    if isBedrock(info) then

        return false

    end


    --------------------------------------------------
    -- MINE REGARDLESS OF ORE TYPE
    --------------------------------------------------

    return
        mineAnyBlock(
            block,
            runId
        )

end


--------------------------------------------------
-- REACH START DEPTH
--------------------------------------------------

-- Beispiel START_DEPTH = -3000
--
-- Hier wird NUR ein Tunnel gegraben:
--
-- 9,0,9
-- 9,-1,9
-- 9,-2,9
-- ...
-- 9,-3000,9

local function reachStartDepth(
    runId
)

    --------------------------------------------------
    -- START DEPTH 0
    --------------------------------------------------

    if START_DEPTH >= 0 then
        return true
    end


    Fluent:Notify({

        Title =
            "Loader Tunnel",

        Content =
            "Loading mine down to Y = "
            .. tostring(START_DEPTH)
            .. ".",

        Duration =
            3

    })


    --------------------------------------------------
    -- LOADER TUNNEL
    --------------------------------------------------

    for y = 0, START_DEPTH, -1 do


        if not isCurrentRun(runId) then
            return false
        end


        local success =
            mineLoaderBlock(
                y,
                runId
            )


        --------------------------------------------------
        -- COULD NOT LOAD DEEPER
        --------------------------------------------------

        if not success then


            Fluent:Notify({

                Title =
                    "Loader stopped",

                Content =
                    "Could not load Y = "
                    .. tostring(y)
                    .. ".",

                Duration =
                    4

            })


            return false

        end


        --------------------------------------------------
        -- SMALL YIELD
        --------------------------------------------------

        if y % 25 == 0 then

            task.wait()

        end

    end


    Fluent:Notify({

        Title =
            "Start Depth reached",

        Content =
            "Reached Y = "
            .. tostring(START_DEPTH)
            .. ".",

        Duration =
            3

    })


    return true

end


--------------------------------------------------
-- MINE COMPLETE Y LEVEL
--------------------------------------------------

local function mineLevel(
    y,
    runId
)

    if not isCurrentRun(runId) then
        return
    end


    if not isMiningDepth(y) then
        return
    end


    local level =
        BlocksByY[y]


    if not level then
        return
    end


    --------------------------------------------------
    -- COPY CURRENT LEVEL
    --------------------------------------------------

    local blocks = {}


    for block in pairs(level) do


        if block
            and block.Parent then


            table.insert(
                blocks,
                block
            )

        end

    end


    --------------------------------------------------
    -- PROCESS LEVEL
    --------------------------------------------------

    for _, block in ipairs(
        blocks
    ) do


        if not isCurrentRun(runId) then
            return
        end


        if block
            and block.Parent then


            local info =
                getBlockInfo(block)


            if info then


                --------------------------------------------------
                -- SELECTED ORE
                --------------------------------------------------

                if isSelectedOre(info) then


                    mineSelectedOre(
                        block,
                        runId
                    )


                --------------------------------------------------
                -- STONE
                --------------------------------------------------

                elseif isStone(info) then


                    mineStone(
                        block,
                        runId
                    )


                --------------------------------------------------
                -- BEDROCK
                --------------------------------------------------

                elseif isBedrock(info) then


                    -- Never mine


                --------------------------------------------------
                -- UNSELECTED ORE
                --------------------------------------------------

                else


                    -- Skip

                end

            end

        end

    end

end


--------------------------------------------------
-- MINE FROM START DEPTH TO BOTTOM
--------------------------------------------------

local function mineFromStartToBottom(
    runId
)

    Fluent:Notify({

        Title =
            "Full Mining",

        Content =
            "Mining from Y = "
            .. tostring(START_DEPTH)
            .. " to "
            .. tostring(MIN_DEPTH)
            .. ".",

        Duration =
            3

    })


    --------------------------------------------------
    -- START -> BOTTOM
    --------------------------------------------------

    for y = START_DEPTH, MIN_DEPTH, -1 do


        if not isCurrentRun(runId) then
            return
        end


        --------------------------------------------------
        -- IMPORTANT
        --
        -- Keep digging the loader tunnel even below
        -- START_DEPTH.
        --
        -- This helps reveal/load the next levels.
        --------------------------------------------------

        local loaded =
            mineLoaderBlock(
                y,
                runId
            )


        --------------------------------------------------
        -- STOP IF NEXT LEVEL DOESN'T LOAD
        --------------------------------------------------

        if not loaded then


            Fluent:Notify({

                Title =
                    "Mine loading stopped",

                Content =
                    "Could not load deeper than Y = "
                    .. tostring(y)
                    .. ".",

                Duration =
                    4

            })


            return

        end


        --------------------------------------------------
        -- MINE ALL LOADED X/Z ON THIS Y
        --------------------------------------------------

        mineLevel(
            y,
            runId
        )


        --------------------------------------------------
        -- YIELD
        --------------------------------------------------

        if y % 10 == 0 then

            task.wait()

        end

    end

end


--------------------------------------------------
-- GET NEXT SELECTED ORE
--------------------------------------------------

local function getNextSelectedOre()

    for block in pairs(
        SelectedOreBlocks
    ) do


        --------------------------------------------------
        -- DEAD
        --------------------------------------------------

        if not block
            or not block.Parent then


            SelectedOreBlocks[block] =
                nil


        else


            local y =
                BlockYCache[block]
                or getBlockY(block)


            --------------------------------------------------
            -- WRONG DEPTH
            --------------------------------------------------

            if not isMiningDepth(y) then


                SelectedOreBlocks[block] =
                    nil


            else


                local info =
                    getBlockInfo(block)


                --------------------------------------------------
                -- NO LONGER SELECTED
                --------------------------------------------------

                if not info
                    or not isSelectedOre(info) then


                    SelectedOreBlocks[block] =
                        nil


                else


                    return block

                end

            end

        end

    end


    return nil

end


--------------------------------------------------
-- KEEP MINING SELECTED ORES
--------------------------------------------------

local function selectedOreMining(
    runId
)

    while isCurrentRun(runId) do


        --------------------------------------------------
        -- CHECK FOLDER
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then


            setupMineIndex()

        end


        --------------------------------------------------
        -- TARGET
        --------------------------------------------------

        local target =
            getNextSelectedOre()


        if target then


            mineSelectedOre(
                target,
                runId
            )


        else


            task.wait(0.1)

        end

    end

end


--------------------------------------------------
-- START MINER
--------------------------------------------------

local function startMining(
    runId
)

    task.spawn(function()


        --------------------------------------------------
        -- WAIT FOR MINE FOLDER
        --------------------------------------------------

        while isCurrentRun(runId) do


            if setupMineIndex() then
                break
            end


            task.wait(0.1)

        end


        if not isCurrentRun(runId) then
            return
        end


        --------------------------------------------------
        -- UPDATE CACHE
        --------------------------------------------------

        rebuildSelectedOreCache()


        --------------------------------------------------
        -- PHASE 1
        --
        -- Dig loader tunnel from 0 to START_DEPTH
        --------------------------------------------------

        local reached =
            reachStartDepth(
                runId
            )


        if not reached then
            return
        end


        if not isCurrentRun(runId) then
            return
        end


        --------------------------------------------------
        -- PHASE 2
        --
        -- Mine complete levels from START_DEPTH
        -- down to MIN_DEPTH
        --------------------------------------------------

        mineFromStartToBottom(
            runId
        )


        --------------------------------------------------
        -- PHASE 3
        --
        -- Keep mining selected ores
        --------------------------------------------------

        if isCurrentRun(runId) then


            selectedOreMining(
                runId
            )

        end

    end)

end


--------------------------------------------------
-- BUILD ORE LIST
--------------------------------------------------

local OreValues = {}


for id, data in pairs(
    BlocksData
) do


    if id

        and not string.match(
            id,
            "^StoneOre%d*$"
        )

        and id ~= "Bedrock"

    then


        local displayName =
            id


        if type(data)
            == "table" then


            displayName =
                data.name
                or data.Name
                or id

        end


        table.insert(
            OreValues,
            displayName
        )

    end

end


table.sort(
    OreValues
)



--------------------------------------------------
-- DISCONNECT
--------------------------------------------------

local function disconnectFolder()

    for _,
        connection in ipairs(
            FolderConnections
        ) do


        pcall(function()

            connection:Disconnect()

        end)

    end


    FolderConnections =
        {}

end


--------------------------------------------------
-- RESCAN
--------------------------------------------------

local function rescanMine()

    local folder =
        MiningServiceClient.mineFolder


    if not folder then
        return false
    end


    for _,
        block in ipairs(
            folder:GetChildren()
        ) do


        if block
            and block.Parent then


            local name =
                tostring(
                    block.Name
                )


            if ModelsByName[name]
                ~= block then


                registerBlock(
                    block
                )

            end

        end

    end


    return true

end


--------------------------------------------------
-- SETUP INDEX
--------------------------------------------------

local function setupIndex()

    local folder =
        MiningServiceClient.mineFolder


    if not folder then
        return false
    end


    if IndexedFolder
        == folder then

        return true

    end


    disconnectFolder()

    clearIndex()


    IndexedFolder =
        folder


    rescanMine()


    --------------------------------------------------
    -- CHILD ADDED
    --------------------------------------------------

    table.insert(

        FolderConnections,

        folder.ChildAdded:Connect(
            function(block)


                task.defer(function()


                    registerBlock(
                        block
                    )

                end)

            end
        )

    )


    --------------------------------------------------
    -- CHILD REMOVED
    --------------------------------------------------

    table.insert(

        FolderConnections,

        folder.ChildRemoved:Connect(
            function(block)


                unregisterBlock(
                    block
                )

            end
        )

    )


    return true

end


--------------------------------------------------
-- REBUILD WHOLE INDEX
--------------------------------------------------

local function rebuildWholeIndex()

    clearIndex()

    rescanMine()

end


--------------------------------------------------
-- REBUILD SELECTED
--------------------------------------------------

local function rebuildSelectedIndex()

    SelectedByY =
        {}


    for name,
        model in pairs(
            ModelsByName
        ) do


        if model
            and model.Parent then


            local y =
                safeNumber(
                    YByName[name]
                )


            local info =
                getBlockInfoByName(
                    name
                )


            if y ~= nil
                and validDepth(y)
                and info
                and isSelectedOre(
                    info
                ) then


                addToBucket(
                    SelectedByY,
                    y,
                    name
                )

            end

        end

    end

end


--------------------------------------------------
-- CLEAN BUCKET
--------------------------------------------------

local function cleanBucket(bucket)

    if not bucket then
        return false
    end


    for name in pairs(
        bucket
    ) do


        local model =
            ModelsByName[name]


        local data =
            getBlockDataByName(
                name
            )


        if BlockedTargets[name]
            or not model
            or not model.Parent
            or not data
            or data[1] == "None" then


            bucket[name] =
                nil

        end

    end


    return
        next(
            bucket
        ) ~= nil

end


--------------------------------------------------
-- DEEPEST Y
--------------------------------------------------

local function deepestY(
    map,
    maxY,
    minY
)

    maxY =
        safeNumber(
            maxY
        )


    minY =
        safeNumber(
            minY
        )


    local result =
        nil


    for rawY,
        bucket in pairs(
            map
        ) do


        local y =
            safeNumber(
                rawY
            )


        if y ~= nil
            and validDepth(y) then


            local allowed =
                true


            if maxY ~= nil then


                allowed =
                    allowed
                    and y <= maxY

            end


            if minY ~= nil then


                allowed =
                    allowed
                    and y >= minY

            end


            if allowed
                and cleanBucket(
                    bucket
                ) then


                if result == nil
                    or y < result then


                    result =
                        y

                end

            end

        end

    end


    return result

end


--------------------------------------------------
-- PLAYER GRID
--------------------------------------------------

local function getPlayerGridPosition()

    local character =
        LocalPlayer.Character


    if not character then

        return
            DEFAULT_X,
            DEFAULT_Z

    end


    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )


    if not root then

        return
            DEFAULT_X,
            DEFAULT_Z

    end


    local origin =
        MiningServiceClient.originPosition


    if not origin then

        return
            DEFAULT_X,
            DEFAULT_Z

    end


    local x =
        math.round(
            (
                root.Position.X
                - origin.X
            ) / 6
        )


    local z =
        math.round(
            (
                root.Position.Z
                - origin.Z
            ) / 6
        )


    return
        x,
        z

end


--------------------------------------------------
-- PICK NEAREST
--------------------------------------------------

local function pickNearest(
    bucket,
    targetX,
    targetZ
)

    if not bucket then
        return nil
    end


    targetX =
        safeNumber(
            targetX
        )
        or DEFAULT_X


    targetZ =
        safeNumber(
            targetZ
        )
        or DEFAULT_Z


    local bestName =
        nil


    local bestDistance =
        math.huge


    for name in pairs(
        bucket
    ) do


        if not BlockedTargets[name] then


            local model =
                ModelsByName[name]


            local y =
                safeNumber(
                    YByName[name]
                )


            if model
                and model.Parent
                and validDepth(y) then


                local x,
                    _,
                    z =

                    getCoordinatesFromName(
                        name
                    )


                x =
                    safeNumber(x)


                z =
                    safeNumber(z)


                if x ~= nil
                    and z ~= nil then


                    local dx =
                        x - targetX


                    local dz =
                        z - targetZ


                    local distance =
                        dx * dx
                        + dz * dz


                    if distance
                        < bestDistance then


                        bestDistance =
                            distance


                        bestName =
                            name

                    end

                end

            end

        end

    end


    return bestName

end



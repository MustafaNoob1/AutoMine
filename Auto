--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local AutoMine = false

local MIN_DEPTH = -4999


--------------------------------------------------
-- SPEED
--------------------------------------------------

-- Wie viele Damage-Aufrufe pro Tick gemacht werden.
-- Falls es Probleme gibt:
-- 5 -> 3 -> 2 -> 1

local DAMAGE_BURST = 5


--------------------------------------------------
-- RUN ID
--------------------------------------------------

-- Verhindert, dass mehrere AutoMine-Threads
-- gleichzeitig laufen, wenn schnell an/aus
-- geschaltet wird.

local MiningRunId = 0


local function isCurrentRun(runId)

    return
        AutoMine
        and runId == MiningRunId

end


--------------------------------------------------
-- GET BLOCK INFO
--------------------------------------------------

local function getBlockInfo(block)

    if not block then
        return nil
    end

    local blockData =
        MiningServiceClient.blocks[
            block.Name
        ]

    if not blockData then
        return nil
    end


    local blockId =
        blockData[1]


    if not blockId
        or blockId == "None" then

        return nil

    end


    local info =
        MiningInfo:getBlock(
            blockId
        )


    if not info then
        return nil
    end


    return {

        Id = blockId,

        Name = info.name,

        HP = info.hp,

        Value = info.value,

        Model = info.model

    }

end


--------------------------------------------------
-- STONE
--------------------------------------------------

local function isStone(info)

    if not info then
        return false
    end


    return
        string.match(
            info.Id,
            "^StoneOre%d*$"
        ) ~= nil

end


--------------------------------------------------
-- BEDROCK
--------------------------------------------------

local function isBedrock(info)

    if not info then
        return false
    end


    return
        info.Id == "Bedrock"

end


--------------------------------------------------
-- SELECTED ORES
--------------------------------------------------

local SelectedOres = {}


local function isSelectedOre(info)

    if not info then
        return false
    end


    if isStone(info) then
        return false
    end


    if isBedrock(info) then
        return false
    end


    return
        SelectedOres[
            info.Id
        ] == true

end


--------------------------------------------------
-- GET BLOCK Y
--------------------------------------------------

local function getBlockY(block)

    if not block then
        return nil
    end


    local y =
        string.match(
            block.Name,
            "^[^_]+_(-?%d+)_"
        )


    return tonumber(y)

end


--------------------------------------------------
-- DEPTH CHECK
--------------------------------------------------

local function isAllowedDepth(block)

    local y =
        getBlockY(block)


    if y == nil then
        return false
    end


    return
        y >= MIN_DEPTH

end


--------------------------------------------------
-- BLOCK INDEX
--------------------------------------------------

-- Dadurch müssen wir NICHT mehr für jede
-- Y-Ebene mineFolder:GetChildren() durchsuchen.

local BlocksByY = {}

local AllBlocks = {}

local BlockYCache = {}

local SelectedOreBlocks = {}


local IndexedFolder = nil

local FolderConnections = {}


--------------------------------------------------
-- CLEAR CONNECTIONS
--------------------------------------------------

local function clearFolderConnections()

    for _, connection in ipairs(
        FolderConnections
    ) do

        pcall(function()

            connection:Disconnect()

        end)

    end


    FolderConnections = {}

end


--------------------------------------------------
-- CLEAR BLOCK INDEX
--------------------------------------------------

local function clearBlockIndex()

    BlocksByY = {}

    AllBlocks = {}

    BlockYCache = {}

    SelectedOreBlocks = {}

end


--------------------------------------------------
-- REGISTER BLOCK
--------------------------------------------------

local function registerBlock(block)

    if not block then
        return
    end


    if AllBlocks[block] then
        return
    end


    local y =
        getBlockY(block)


    if y == nil then
        return
    end


    if y < MIN_DEPTH then
        return
    end


    --------------------------------------------------
    -- ALL BLOCKS
    --------------------------------------------------

    AllBlocks[block] = true

    BlockYCache[block] = y


    --------------------------------------------------
    -- Y INDEX
    --------------------------------------------------

    if not BlocksByY[y] then

        BlocksByY[y] = {}

    end


    BlocksByY[y][block] =
        true


    --------------------------------------------------
    -- SELECTED ORE CACHE
    --------------------------------------------------

    local info =
        getBlockInfo(block)


    if info
        and isSelectedOre(info) then

        SelectedOreBlocks[block] =
            true

    end

end


--------------------------------------------------
-- UNREGISTER BLOCK
--------------------------------------------------

local function unregisterBlock(block)

    if not block then
        return
    end


    local y =
        BlockYCache[block]


    --------------------------------------------------
    -- REMOVE FROM LEVEL
    --------------------------------------------------

    if y
        and BlocksByY[y] then

        BlocksByY[y][block] =
            nil


        if next(
            BlocksByY[y]
        ) == nil then

            BlocksByY[y] =
                nil

        end

    end


    --------------------------------------------------
    -- REMOVE FROM CACHES
    --------------------------------------------------

    AllBlocks[block] =
        nil


    BlockYCache[block] =
        nil


    SelectedOreBlocks[block] =
        nil

end


--------------------------------------------------
-- REBUILD SELECTED ORE CACHE
--------------------------------------------------

local function rebuildSelectedOreCache()

    SelectedOreBlocks = {}


    for block in pairs(
        AllBlocks
    ) do

        if block
            and block.Parent then

            local info =
                getBlockInfo(block)


            if info
                and isSelectedOre(info) then

                SelectedOreBlocks[block] =
                    true

            end

        end

    end

end


--------------------------------------------------
-- SETUP MINE INDEX
--------------------------------------------------

local function setupMineIndex()

    local folder =
        MiningServiceClient.mineFolder


    if not folder then
        return false
    end


    --------------------------------------------------
    -- SAME FOLDER ALREADY INDEXED
    --------------------------------------------------

    if IndexedFolder == folder then
        return true
    end


    --------------------------------------------------
    -- RESET
    --------------------------------------------------

    clearFolderConnections()

    clearBlockIndex()


    IndexedFolder =
        folder


    --------------------------------------------------
    -- INITIAL SCAN
    --------------------------------------------------

    for _, block in ipairs(
        folder:GetChildren()
    ) do

        registerBlock(block)

    end


    --------------------------------------------------
    -- NEW BLOCKS
    --------------------------------------------------

    table.insert(
        FolderConnections,

        folder.ChildAdded:Connect(
            function(block)

                registerBlock(block)

            end
        )

    )


    --------------------------------------------------
    -- REMOVED BLOCKS
    --------------------------------------------------

    table.insert(
        FolderConnections,

        folder.ChildRemoved:Connect(
            function(block)

                unregisterBlock(block)

            end
        )

    )


    return true

end


--------------------------------------------------
-- DAMAGE BLOCK
--------------------------------------------------

local function damageBlock(block)

    if not block then
        return false
    end


    if not block.Parent then
        return false
    end


    if not block:GetAttribute(
        "isBlock"
    ) then

        return false

    end


    if not isAllowedDepth(block) then
        return false
    end


    local info =
        getBlockInfo(block)


    if not info then
        return false
    end


    --------------------------------------------------
    -- NEVER MINE BEDROCK
    --------------------------------------------------

    if isBedrock(info) then
        return false
    end


    --------------------------------------------------
    -- DAMAGE
    --------------------------------------------------

    MiningServiceClient.currentBlock =
        block


    MiningServiceClient:damageBlock()


    return true

end


--------------------------------------------------
-- FAST BLOCK MINING
--------------------------------------------------

local function mineBlockFast(
    block,
    checkFunction,
    runId
)

    if not block then
        return
    end


    while
        block.Parent
        and isCurrentRun(runId)
    do


        --------------------------------------------------
        -- CHECK TYPE
        --------------------------------------------------

        local info =
            getBlockInfo(block)


        if not info then
            break
        end


        if isBedrock(info) then
            break
        end


        if not checkFunction(info) then
            break
        end


        --------------------------------------------------
        -- DAMAGE BURST
        --------------------------------------------------

        for i = 1, DAMAGE_BURST do


            if not block.Parent then
                break
            end


            if not isCurrentRun(runId) then
                break
            end


            if not damageBlock(block) then
                break
            end

        end


        --------------------------------------------------
        -- ONE YIELD PER BURST
        --------------------------------------------------

        task.wait()

    end

end


--------------------------------------------------
-- MINE SELECTED ORE
--------------------------------------------------

local function mineSelectedOre(
    block,
    runId
)

    mineBlockFast(
        block,
        isSelectedOre,
        runId
    )

end


--------------------------------------------------
-- MINE STONE
--------------------------------------------------

local function mineStone(
    block,
    runId
)

    mineBlockFast(
        block,
        isStone,
        runId
    )

end


--------------------------------------------------
-- MINE Y LEVEL
--------------------------------------------------

local function mineLevel(
    y,
    runId
)

    if not isCurrentRun(runId) then
        return
    end


    local level =
        BlocksByY[y]


    if not level then
        return
    end


    --------------------------------------------------
    -- SNAPSHOT
    --------------------------------------------------

    -- Wir kopieren nur die aktuelle Y-Ebene,
    -- nicht die komplette Mine.

    local blocks = {}


    for block in pairs(level) do

        table.insert(
            blocks,
            block
        )

    end


    --------------------------------------------------
    -- PROCESS LEVEL
    --------------------------------------------------

    for _, block in ipairs(
        blocks
    ) do


        if not isCurrentRun(runId) then
            return
        end


        if block
            and block.Parent then


            local info =
                getBlockInfo(block)


            if info then


                --------------------------------------------------
                -- SELECTED ORE
                --------------------------------------------------

                if isSelectedOre(info) then

                    mineSelectedOre(
                        block,
                        runId
                    )


                --------------------------------------------------
                -- STONE
                --------------------------------------------------

                elseif isStone(info) then

                    mineStone(
                        block,
                        runId
                    )


                --------------------------------------------------
                -- BEDROCK
                --------------------------------------------------

                elseif isBedrock(info) then

                    -- Skip


                --------------------------------------------------
                -- UNSELECTED ORE
                --------------------------------------------------

                else

                    -- Skip

                end

            end

        end

    end

end


--------------------------------------------------
-- MINE DOWN
--------------------------------------------------

local function mineDownToBottom(
    runId
)

    for y = 0, MIN_DEPTH, -1 do


        if not isCurrentRun(runId) then
            return
        end


        --------------------------------------------------
        -- CHECK IF MINE FOLDER CHANGED
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then

            setupMineIndex()

        end


        --------------------------------------------------
        -- MINE THIS COMPLETE LEVEL
        --------------------------------------------------

        mineLevel(
            y,
            runId
        )


        --------------------------------------------------
        -- SMALL YIELD BETWEEN LEVELS
        --------------------------------------------------

        if y % 25 == 0 then

            task.wait()

        end

    end

end


--------------------------------------------------
-- GET NEXT SELECTED ORE
--------------------------------------------------

local function getNextSelectedOre()

    for block in pairs(
        SelectedOreBlocks
    ) do


        --------------------------------------------------
        -- CLEAN DEAD BLOCK
        --------------------------------------------------

        if not block
            or not block.Parent then

            SelectedOreBlocks[block] =
                nil


        else


            local info =
                getBlockInfo(block)


            --------------------------------------------------
            -- NO LONGER SELECTED
            --------------------------------------------------

            if not info
                or not isSelectedOre(info) then

                SelectedOreBlocks[block] =
                    nil


            --------------------------------------------------
            -- VALID ORE
            --------------------------------------------------

            else

                return block

            end

        end

    end


    return nil

end


--------------------------------------------------
-- SELECTED ORE MINING AFTER BOTTOM
--------------------------------------------------

local function selectedOreMining(
    runId
)

    while isCurrentRun(runId) do


        --------------------------------------------------
        -- MINE FOLDER CHANGED?
        --------------------------------------------------

        if MiningServiceClient.mineFolder
            ~= IndexedFolder then

            setupMineIndex()

        end


        --------------------------------------------------
        -- GET CACHED ORE
        --------------------------------------------------

        local target =
            getNextSelectedOre()


        if target then

            mineSelectedOre(
                target,
                runId
            )

        else

            task.wait(0.1)

        end

    end

end


--------------------------------------------------
-- START MINING
--------------------------------------------------

local function startMining(
    runId
)

    task.spawn(function()


        --------------------------------------------------
        -- WAIT FOR MINE FOLDER
        --------------------------------------------------

        while isCurrentRun(runId) do


            if setupMineIndex() then
                break
            end


            task.wait(0.1)

        end


        if not isCurrentRun(runId) then
            return
        end


        --------------------------------------------------
        -- REFRESH ORE CACHE
        --------------------------------------------------

        rebuildSelectedOreCache()


        --------------------------------------------------
        -- MINE ALL LEVELS
        --------------------------------------------------

        mineDownToBottom(
            runId
        )


        --------------------------------------------------
        -- KEEP MINING SELECTED ORES
        --------------------------------------------------

        if isCurrentRun(runId) then

            selectedOreMining(
                runId
            )

        end

    end)

end


--------------------------------------------------
-- BUILD ORE LIST
--------------------------------------------------

local OreValues = {}


for id, data in pairs(
    BlocksData
) do


    if id

        and not string.match(
            id,
            "^StoneOre%d*$"
        )

        and id ~= "Bedrock"

    then


        local displayName =
            id


        if type(data) == "table" then

            displayName =
                data.name
                or data.Name
                or id

        end


        table.insert(
            OreValues,
            displayName
        )

    end

end


table.sort(
    OreValues
)


--------------------------------------------------
-- ORE DROPDOWN
--------------------------------------------------

local MultiDropdown =
    Tabs.Main:AddDropdown(
        "OreSelection",
        {

            Title =
                "Select Ores",

            Description =
                "Choose which ores to mine.",

            Values =
                OreValues,

            Multi =
                true,

            Default =
                {}

        }
    )


--------------------------------------------------
-- UPDATE SELECTED ORES
--------------------------------------------------

MultiDropdown:OnChanged(
    function(values)


        SelectedOres = {}


        for name, enabled in pairs(
            values
        ) do


            if enabled then


                for id, data in pairs(
                    BlocksData
                ) do


                    local displayName =
                        id


                    if type(data)
                        == "table" then

                        displayName =
                            data.name
                            or data.Name
                            or id

                    end


                    if displayName
                        == name then


                        SelectedOres[id] =
                            true


                        break

                    end

                end

            end

        end


        --------------------------------------------------
        -- UPDATE FAST CACHE
        --------------------------------------------------

        rebuildSelectedOreCache()

    end
)


--------------------------------------------------
-- AUTO MINE TOGGLE
--------------------------------------------------

local Toggle =
    Tabs.Main:AddToggle(
        "AutoMine",
        {

            Title =
                "Auto Mine",

            Description =
                "Fast mine all levels to -4999.",

            Default =
                false

        }
    )


--------------------------------------------------
-- TOGGLE CHANGED
--------------------------------------------------

Toggle:OnChanged(
    function(value)


        --------------------------------------------------
        -- INVALIDATE OLD THREAD
        --------------------------------------------------

        MiningRunId =
            MiningRunId + 1


        AutoMine =
            value


        --------------------------------------------------
        -- START
        --------------------------------------------------

        if AutoMine then


            local runId =
                MiningRunId


            Fluent:Notify({
                Title =
                    "Fast Auto Mine",

                Content =
                    "Fast mining started.",

                Duration =
                    2
            })


            startMining(
                runId
            )


        --------------------------------------------------
        -- STOP
        --------------------------------------------------

        else


            Fluent:Notify({
                Title =
                    "Fast Auto Mine",

                Content =
                    "Mining stopped.",

                Duration =
                    2
            })

        end

    end
)


